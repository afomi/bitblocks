<!DOCTYPE html>
<html lang="en" class="light [scrollbar-gutter:stable]">
  <script>
    try {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }
    } catch(e) {}
  </script>
  <head>
    <% page_title = assigns[:page_title] || "Bitblocks" %>
    <% meta_description = assigns[:meta_description] || "Explore Bitcoin SV blocks, transactions, protocols, and network status with Bitblocks." %>
    <% meta_robots = assigns[:meta_robots] || "index, follow" %>
    <% canonical_url = "https://bitblocks.app#{assigns[:canonical_path] || "/"}" %>
    <% social_image = assigns[:social_image] || "https://bitblocks.app/images/og-image.jpg" %>
    <% social_image_alt = assigns[:social_image_alt] || "Bitblocks Bitcoin SV blockchain explorer preview" %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <.live_title suffix=" · Bitblocks">
      <%= page_title %>
    </.live_title>

    <!-- SEO Meta Tags -->
    <meta
      name="description"
      content={meta_description}
    />
    <meta
      name="keywords"
      content="Bitcoin SV, BSV, blockchain explorer, bitcoin blocks, bitcoin transactions, cryptocurrency, blockchain"
    />
    <meta
      name="author"
      content="Bitblocks"
    />
    <meta
      name="robots"
      content={meta_robots}
    />
    <link
      rel="canonical"
      href={canonical_url}
    />

    <!-- Open Graph / Facebook -->
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:site_name"
      content="Bitblocks"
    />
    <meta
      property="og:url"
      content={canonical_url}
    />
    <meta
      property="og:title"
      content={page_title}
    />
    <meta
      property="og:description"
      content={meta_description}
    />
    <meta
      property="og:image"
      content={social_image}
    />
    <meta
      property="og:image:alt"
      content={social_image_alt}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:type"
      content="image/jpeg"
    />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:url"
      content={canonical_url}
    />
    <meta
      name="twitter:title"
      content={page_title}
    />
    <meta
      name="twitter:description"
      content={meta_description}
    />
    <meta
      name="twitter:image"
      content={social_image}
    />
    <meta
      name="twitter:image:alt"
      content={social_image_alt}
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Bitblocks",
        "alternateName": "Bitblocks Explorer",
        "description": "Explore Bitcoin SV blocks, transactions, protocols, and network status with Bitblocks.",
        "url": "https://bitblocks.app",
        "publisher": {
          "@type": "Organization",
          "name": "Bitblocks",
          "url": "https://github.com/afomi/bitblocks"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://bitblocks.app/search?query={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/app.css"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
    >
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 antialiased">
    <BitblocksWeb.ReorgNotice.banner
      notice={assigns[:reorg_notice]}
      admin={assigns[:admin?] == true}
    />
    <BitblocksWeb.IndexNotice.banner notice={assigns[:index_notice]} />
    <BitblocksWeb.NavComponent.nav
      current_user={assigns[:current_user]}
      current_path={assigns[:current_path]}
    />

    <main role="main">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </main>

    <footer
      class="border-t border-gray-200 dark:border-gray-800 mt-auto"
    >
      <div
        class="container mx-auto px-4 py-6"
      >
        <div
          class="flex items-start justify-between gap-4"
        >
          <div
            class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-3"
          >
            <a
              :if={assigns[:current_user] || assigns[:admin?]}
              href="/status"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Node status
            </a>
            <a
              href="/start"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Start building
            </a>
            <a
              href="/reorgs"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Reorgs
            </a>
            <a
              href="/facts"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Chain facts
            </a>
            <a
              href="/types"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Transaction types
            </a>
            <a
              href="/bitcom"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Bitcom Registry
            </a>
            <a
              :if={Bitblocks.Support.sponsor_url()}
              href={Bitblocks.Support.sponsor_url()}
              rel="noopener noreferrer"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              Sponsor
            </a>
            <a
              href="https://github.com/afomi/bitblocks"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300"
            >
              GitHub
            </a>
          </div>
          <div
            class="flex items-center gap-6"
          >
            <%= if Application.get_env(:bitblocks, :dev_routes, false) do %>
              <a
                href="/config"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Config
              </a>
              <a
                href="/syncing"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Sync
              </a>
              <a
                href="/graph"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Graph
              </a>
              <a
                href="/highlights"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Highlights
              </a>
              <a
                href="/reporting"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Reporting
              </a>
              <a
                href="/debug"
                class="text-sm font-semibold text-brand-strong dark:text-brand hover:text-orange-800 dark:hover:text-orange-300"
              >
                Debug
              </a>
            <% end %>
          </div>
          <div>
            <button
              onclick="
                var html = document.documentElement;
                var isLight = html.classList.contains('light');
                html.classList.toggle('dark', isLight);
                html.classList.toggle('light', !isLight);
                localStorage.setItem('theme', isLight ? 'dark' : 'light');
                this.textContent = isLight ? '☀' : '☾';
              "
              class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
              aria-label="Toggle light/dark mode"
            >
              ☾
            </button>
            <script>
              try {
                var btn = document.currentScript.previousElementSibling;
                btn.textContent = localStorage.getItem('theme') === 'dark' ? '☀' : '☾';
              } catch(e) {}
            </script>
          </div>
        </div>
      </div>
    </footer>

  </body>

</html>
