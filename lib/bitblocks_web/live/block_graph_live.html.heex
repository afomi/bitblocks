<%!-- Site-style chrome around a three.js scene: only #block-graph is dark (see DESIGN.md). --%>
<div class="fixed inset-0 flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
  <%!-- Top toolbar --%>
  <div class="flex items-center justify-between px-4 py-2 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10">
    <div class="flex items-center gap-4">
      <a
        href="/admin"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
      >
        &larr; Admin
      </a>
      <h1 class="text-lg font-semibold text-gray-900 dark:text-white">
        Block Transaction Graph
      </h1>
    </div>

    <%!-- Range controls --%>
    <form
      phx-submit="load_graph"
      class="flex items-center gap-3"
    >
      <label
        for="block-graph-start"
        class="text-xs text-gray-600 dark:text-gray-400"
      >
        Range:
      </label>
      <input
        id="block-graph-start"
        type="number"
        name="start"
        aria-label="Start height"
        value={@start_height}
        min="0"
        class="w-24 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <span class="text-gray-600 dark:text-gray-400">
        to
      </span>
      <input
        type="number"
        name="end"
        aria-label="End height"
        value={@end_height}
        min="0"
        class="w-24 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />

      <%!-- Hidden filter fields passed with form --%>
      <input
        type="hidden"
        name="address"
        value={@address_filter}
      />
      <input
        type="hidden"
        name="min_value"
        value={@min_value}
      />
      <input
        type="hidden"
        name="max_value"
        value={@max_value}
      />
      <input
        type="hidden"
        name="type"
        value={@tx_type}
      />

      <button
        type="submit"
        class="px-3 py-1 text-sm rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors"
      >
        Load
      </button>
    </form>

    <div class="flex items-center gap-3">
      <%!-- Filter toggle --%>
      <button
        phx-click="toggle_filters"
        class={"px-2 py-1 text-xs rounded transition-colors " <> if(@filters_open, do: "bg-amber-700 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
      >
        Filters
      </button>

      <%!-- Layout toggle --%>
      <div class="flex items-center gap-1">
        <span class="text-xs text-gray-600 dark:text-gray-400">
          Layout:
        </span>
        <button
          phx-click="set_layout"
          phx-value-mode="time"
          class={"px-2 py-1 text-xs rounded transition-colors " <> if(@layout_mode == "time", do: "bg-blue-600 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
        >
          Time
        </button>
        <button
          phx-click="set_layout"
          phx-value-mode="force"
          class={"px-2 py-1 text-xs rounded transition-colors " <> if(@layout_mode == "force", do: "bg-blue-600 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
        >
          Force
        </button>
        <button
          phx-click="set_layout"
          phx-value-mode="hierarchical"
          class={"px-2 py-1 text-xs rounded transition-colors " <> if(@layout_mode == "hierarchical", do: "bg-blue-600 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
        >
          Hierarchical
        </button>
      </div>
    </div>
  </div>

  <%!-- Filter panel (collapsible) --%>
  <%= if @filters_open do %>
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10">
      <form
        phx-submit="load_graph"
        class="flex items-end gap-6 flex-wrap"
      >
        <%!-- Preserve range --%>
        <input
          type="hidden"
          name="start"
          value={@start_height}
        />
        <input
          type="hidden"
          name="end"
          value={@end_height}
        />

        <div>
          <label
            for="block-graph-address"
            class="block text-xs text-gray-600 dark:text-gray-400 mb-1"
          >
            Address filter
          </label>
          <input
            id="block-graph-address"
            type="text"
            name="address"
            value={@address_filter}
            placeholder="addr1, addr2, ..."
            class="w-72 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label
            for="block-graph-min-value"
            class="block text-xs text-gray-600 dark:text-gray-400 mb-1"
          >
            Min value (satoshis)
          </label>
          <input
            id="block-graph-min-value"
            type="number"
            name="min_value"
            value={if @min_value > 0, do: @min_value, else: ""}
            placeholder="0"
            min="0"
            class="w-36 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label
            for="block-graph-max-value"
            class="block text-xs text-gray-600 dark:text-gray-400 mb-1"
          >
            Max value (satoshis)
          </label>
          <input
            id="block-graph-max-value"
            type="number"
            name="max_value"
            value={if @max_value > 0, do: @max_value, else: ""}
            placeholder="unlimited"
            min="0"
            class="w-36 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label
            for="block-graph-type"
            class="block text-xs text-gray-600 dark:text-gray-400 mb-1"
          >
            Transaction type
          </label>
          <select
            id="block-graph-type"
            name="type"
            class="px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option
              value="all"
              selected={@tx_type == "all"}
            >
              All
            </option>
            <option
              value="coinbase"
              selected={@tx_type == "coinbase"}
            >
              Coinbase only
            </option>
            <option
              value="spends"
              selected={@tx_type == "spends"}
            >
              Spends only
            </option>
          </select>
        </div>

        <button
          type="submit"
          class="px-3 py-1 text-sm rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors"
        >
          Apply Filters
        </button>
      </form>
    </div>
  <% end %>

  <%!-- Stats bar --%>
  <div class="flex items-center gap-6 px-4 py-1.5 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 text-xs text-gray-600 dark:text-gray-400 z-10">
    <span>
      Blocks: <strong class="text-gray-900 dark:text-gray-100"><%= @block_count %></strong>
    </span>
    <span>
      Transactions: <strong class="text-gray-900 dark:text-gray-100"><%= @node_count %></strong>
    </span>
    <span>
      Connections: <strong class="text-gray-900 dark:text-gray-100"><%= @edge_count %></strong>
    </span>
    <%= if @address_filter != "" do %>
      <span class="text-amber-800 dark:text-amber-300">
        Address: <%= @address_filter %>
      </span>
    <% end %>
    <%= if @min_value > 0 or @max_value > 0 do %>
      <span class="text-amber-800 dark:text-amber-300">
        Value: <%= if @min_value > 0, do: "#{@min_value}+", else: "" %><%= if @max_value > 0, do: " ≤#{@max_value}", else: "" %> sat
      </span>
    <% end %>
    <%= if @tx_type != "all" do %>
      <span class="text-amber-800 dark:text-amber-300">
        Type: <%= @tx_type %>
      </span>
    <% end %>
    <%= if @loading do %>
      <span class="text-amber-800 dark:text-amber-300 animate-pulse">Loading...</span>
    <% end %>
  </div>

  <%!-- Playback controls --%>
  <div class="flex items-center justify-center gap-3 px-4 py-2 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10">
    <button
      id="playback-rewind"
      phx-click="playback_rewind"
      title="rewind"
      class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 transition-colors"
    >
      &#x23EE; rewind
    </button>
    <button
      id="playback-play"
      phx-click="playback_play"
      title="play"
      class={"px-3 py-1 text-sm rounded transition-colors " <> if(@playback_state == "playing", do: "bg-green-700 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
    >
      &#x25B6; play
    </button>
    <button
      id="playback-pause"
      phx-click="playback_pause"
      title="pause"
      class={"px-2 py-1 text-sm rounded transition-colors " <> if(@playback_state == "paused", do: "bg-amber-700 text-white", else: "bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600")}
    >
      &#x23F8; pause
    </button>
    <button
      id="playback-forward"
      phx-click="playback_forward"
      title="forward"
      class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 transition-colors"
    >
      &#x23ED; forward
    </button>
    <span class="ml-4 text-xs text-gray-600 dark:text-gray-400">
      <span
        id="playback-status"
        data-state={@playback_state}
      >
        <%= @playback_state %> &middot; Block <%= @playback_cursor %>
      </span>
    </span>
  </div>

  <%!-- Three.js canvas: dark in both modes, matching COLORS.background in assets/js/hooks/block_graph.js --%>
  <div
    id="block-graph"
    phx-hook="BlockGraph"
    data-layout={@layout_mode}
    class="flex-1 w-full bg-[#050608]"
  >
  </div>

  <%!-- Tooltip overlay --%>
  <div
    id="block-graph-tooltip"
    class="fixed pointer-events-none bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-900 dark:text-gray-100 shadow-xl z-50 hidden"
  >
  </div>

  <%!-- Zoom level indicator --%>
  <div class="fixed bottom-4 left-4 bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-700 dark:text-gray-300 shadow-sm z-50">
    <div
      id="zoom-indicator"
      class="flex items-center gap-2"
    >
      <span class="w-2 h-2 rounded-full bg-blue-500"></span>
      <span>Scroll to zoom &middot; Drag to pan &middot; Right-drag to rotate</span>
    </div>
  </div>

  <%!-- Legend --%>
  <div class="fixed bottom-4 right-4 bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-700 dark:text-gray-300 shadow-sm z-50">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
        <span>Coinbase</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        <span>Regular</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
        <span>&gt;1 BSV</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 opacity-40"></span>
        <span>Spent</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        <span>Unspent</span>
      </div>
    </div>
  </div>
</div>
