<%!-- Site-style chrome around a three.js scene: only #peer-map is dark (see DESIGN.md). --%>
<div class="fixed inset-0 flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
  <%!-- Top toolbar --%>
  <div class="flex items-center justify-between px-4 py-2 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10">
    <div class="flex items-center gap-4">
      <a
        href="/"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
      >
        &larr; Back
      </a>
      <h1 class="text-lg font-semibold text-gray-900 dark:text-white">
        Peer Network Map
      </h1>
    </div>

    <div class="flex items-center gap-4">
      <span class="text-xs text-gray-600 dark:text-gray-400">
        Connected Peers: <strong class="text-gray-900 dark:text-gray-100"><%= @peer_count %></strong>
      </span>
      <%= if @last_updated do %>
        <span class="text-xs text-gray-600 dark:text-gray-400">
          Updated: <%= @last_updated %>
        </span>
      <% end %>
      <button
        phx-click="refresh"
        class="px-3 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 transition-colors"
      >
        Refresh
      </button>
    </div>
  </div>

  <%!-- Stats bar --%>
  <div class="flex items-center gap-6 px-4 py-1.5 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 text-xs text-gray-600 dark:text-gray-400 z-10">
    <% located = Enum.count(@peers, fn p -> p.lat != nil end) %>
    <% countries = @peers |> Enum.map(& &1.country) |> Enum.reject(&is_nil/1) |> Enum.uniq() |> length() %>
    <% inbound = Enum.count(@peers, fn p -> p.inbound end) %>
    <% outbound = @peer_count - inbound %>
    <span>
      Located: <strong class="text-gray-900 dark:text-gray-100"><%= located %>/<%= @peer_count %></strong>
    </span>
    <span>
      Countries: <strong class="text-gray-900 dark:text-gray-100"><%= countries %></strong>
    </span>
    <span>
      Inbound: <strong class="text-green-700 dark:text-green-400"><%= inbound %></strong>
      Outbound: <strong class="text-blue-700 dark:text-blue-400"><%= outbound %></strong>
    </span>
    <%= if @loading do %>
      <span class="text-amber-800 dark:text-amber-300 animate-pulse">Geolocating peers...</span>
    <% end %>
  </div>

  <%!-- Three.js globe: dark in both modes, matching COLORS.background in assets/js/hooks/peer_map.js --%>
  <div
    id="peer-map"
    phx-hook="PeerMap"
    phx-update="ignore"
    class="flex-1 w-full min-h-0 overflow-hidden bg-[#030712]"
  >
  </div>

  <%!-- Peer list sidebar --%>
  <div class="fixed right-0 top-20 bottom-0 w-72 bg-white/95 dark:bg-gray-800/95 border-l border-gray-200 dark:border-gray-700 overflow-y-auto z-10">
    <div class="p-3">
      <h2 class="text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-3">
        Connected Peers
      </h2>
      <div class="space-y-2">
        <%= for peer <- Enum.sort_by(@peers, & &1.country) do %>
          <div class="bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-gray-900 dark:text-gray-100">
                <%= peer.ip %>
              </span>
              <span class={"px-1.5 py-0.5 rounded text-[10px] " <> if(peer.inbound, do: "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300", else: "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300")}>
                <%= if peer.inbound, do: "in", else: "out" %>
              </span>
            </div>
            <%= if peer.city || peer.country do %>
              <div class="text-gray-700 dark:text-gray-300">
                <%= [peer.city, peer.country] |> Enum.reject(&is_nil/1) |> Enum.join(", ") %>
              </div>
            <% end %>
            <div class="flex items-center justify-between mt-1 text-gray-600 dark:text-gray-400">
              <span class="truncate max-w-[140px]">
                <%= String.replace(peer.subver || "", "/", "") %>
              </span>
              <%= if peer.pingtime && peer.pingtime > 0 do %>
                <span>
                  <%= Float.round(peer.pingtime * 1000, 0) %>ms
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- Tooltip --%>
  <div
    id="peer-map-tooltip"
    class="fixed pointer-events-none bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-900 dark:text-gray-100 shadow-xl z-50 hidden"
  >
  </div>

  <%!-- Legend --%>
  <div class="fixed bottom-4 left-4 bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-700 dark:text-gray-300 shadow-sm z-50">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
        <span>This node</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
        <span>Inbound</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
        <span>Outbound</span>
      </div>
      <span>Drag to rotate &middot; Scroll to zoom</span>
    </div>
  </div>
</div>
