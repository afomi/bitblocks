<div class="mx-auto max-w-4xl px-4 py-4 text-gray-700 dark:text-gray-300">
  <h1 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
    Syncing
  </h1>
  <p class="mb-2 leading-relaxed">
    Bitblocks fetches every transaction in every block and checks each one against its block.
  </p>
  <p class="mb-2 leading-relaxed">
    <strong class="text-gray-900 dark:text-white">Synced</strong>
    counts the transactions stored so far.
  </p>
  <p class="mb-2 leading-relaxed">
    <strong class="text-gray-900 dark:text-white">Processed</strong>
    counts the ones analyzed for Bitblocks metadata (scripts, protocols, tokens), at analyzer version {@snapshot.analyzer_version}.
  </p>
  <p class="mb-8 leading-relaxed">
    This page updates live, at most once a second.
  </p>

  <p class="mb-6 leading-relaxed">
    Every block from genesis through the one named below has all of its transactions stored and checked against its header.
    One coordinator hands each worker the lowest block not yet complete, and each worker owns one block at a time.
    A block that fails is retried with backoff and keeps its place.
  </p>
  <BitblocksWeb.SyncTable.sync_table sync={@snapshot.sync} />

  <%!-- The overall picture --%>
  <section
    id="sync-overview"
    aria-labelledby="sync-overview-heading"
    class="mb-5"
  >
    <h2
      id="sync-overview-heading"
      class="mb-2 text-xl font-semibold text-gray-900 dark:text-white"
    >
      The overall picture
    </h2>
    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
        <dt class="text-sm text-gray-700 dark:text-gray-300">
          Our index's newest header
        </dt>
        <dd
          id="our-tip"
          class="font-mono text-xl font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          {number(@snapshot.overview.our_tip)}
        </dd>
      </div>
      <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
        <dt class="text-sm text-gray-700 dark:text-gray-300">
          Our node's tip
        </dt>
        <dd
          id="node-tip"
          class="font-mono text-xl font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          {number(@snapshot.overview.node_tip)}
        </dd>
        <dd
          :if={n = behind(@snapshot.overview.our_tip, @snapshot.overview.node_tip)}
          class="text-sm"
        >
          {if n == 0, do: "Bitblocks is level with the node.", else: "Bitblocks is #{number(n)} blocks behind the node."}
        </dd>
      </div>
      <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
        <dt class="text-sm text-gray-700 dark:text-gray-300">
          Public tip (WhatsOnChain)
        </dt>
        <dd
          id="public-tip"
          class="font-mono text-xl font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          {number(@snapshot.overview.public_tip)}
        </dd>
        <dd
          :if={n = behind(@snapshot.overview.node_tip, @snapshot.overview.public_tip)}
          class="text-sm"
        >
          {if n == 0, do: "Our node is level with the public tip.", else: "Our node is #{number(n)} blocks behind it."}
        </dd>
      </div>
    </dl>

    <div class="mt-4 rounded-lg border border-gray-200 p-3 dark:border-gray-700">
      <.progress_bar
        id="header-coverage"
        label="Headers stored"
        value={@snapshot.overview.our_tip && @snapshot.overview.headers_stored}
        total={(@snapshot.overview.our_tip || -1) + 1}
        pending_text="Counting"
        bar_class="bg-gray-700 dark:bg-gray-300"
      />
    </div>

    <h3 class="mb-2 mt-6 text-base font-semibold text-gray-900 dark:text-white">
      Blocks by sync state
    </h3>
    <%= if @snapshot.overview.states == [] do %>
      <p id="sync-states-empty">
        The first count arrives within a minute.
      </p>
    <% else %>
      <table
        id="sync-states"
        class="w-full max-w-md text-sm"
      >
        <thead>
          <tr class="border-b border-gray-300 text-left dark:border-gray-600">
            <th
              scope="col"
              class="py-1 pr-4 font-semibold text-gray-900 dark:text-white"
            >
              State
            </th>
            <th
              scope="col"
              class="py-1 text-right font-semibold text-gray-900 dark:text-white"
            >
              Blocks
            </th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={{state, count} <- @snapshot.overview.states}
            id={"sync-state-#{state}"}
            class="border-b border-gray-200 dark:border-gray-800"
          >
            <td class="py-1 pr-4">
              {state_label(state)}
              <code class="ml-1 rounded bg-gray-100 px-1 text-xs text-gray-800 dark:bg-gray-800 dark:text-gray-200">{state}</code>
            </td>
            <td class="py-1 text-right font-mono tabular-nums">
              {number(count)}
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </section>

  <%!-- Blocks being synced right now, lowest first --%>
  <section
    id="syncing-now"
    aria-labelledby="syncing-now-heading"
    class="mb-5"
  >
    <h2
      id="syncing-now-heading"
      class="mb-1 text-xl font-semibold text-gray-900 dark:text-white"
    >
      Syncing now
    </h2>
    <p class="mb-2 text-xs text-gray-600 dark:text-gray-400">
      Lowest block first.
      A finished block stays a minute, marked verified, then fades out.
    </p>
    <%= if @board == [] do %>
      <p
        id="syncing-empty"
        class="text-gray-900 dark:text-gray-100"
      >
        No block is fetching transactions right now.
      </p>
    <% else %>
      <ul
        role="list"
        class="space-y-2"
      >
        <.block_card
          :for={entry <- @board}
          entry={entry}
          prefix="syncing"
          target={@snapshot.overview.target}
          pending_text={if entry.finished, do: "Not counted", else: "Starting"}
        />
      </ul>
    <% end %>
  </section>
</div>
