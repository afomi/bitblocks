<div class="container mx-auto px-4 py-8 max-w-3xl">
  <.link
    navigate={~p"/bitcom"}
    class="text-sm text-blue-700 hover:underline"
  >
    ← Bitcom Registry
  </.link>
  <h1 class="text-3xl font-bold mt-2 mb-2">
    Compose a Bitcom command
  </h1>
  <p class="text-gray-700 mb-6">
    A Bitcom command speaks for the address that pays for its transaction.
    Build the output here, then sign and broadcast it from a wallet holding that address.
    Bitblocks never sees your keys.
  </p>

  <.form
    for={@form}
    id="compose-form"
    phx-change="compose"
    phx-submit="compose"
    class="space-y-4 bg-white border border-gray-200 rounded-lg p-4"
  >
    <div>
      <label
        for="compose_funder"
        class="block text-sm font-medium text-gray-800"
      >
        Funding address (the author)
      </label>
      <input
        type="text"
        id="compose_funder"
        name="compose[funder]"
        value={@form[:funder].value}
        autocomplete="off"
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>

    <div>
      <label
        for="compose_command"
        class="block text-sm font-medium text-gray-800"
      >
        Command
      </label>
      <select
        id="compose_command"
        name="compose[command]"
        class="mt-1 w-full rounded border-gray-300 text-sm"
      >
        <option
          :for={{value, label} <- @commands}
          value={value}
          selected={value == @command}
        >
          {label}
        </option>
      </select>
    </div>

    <div :if={@command == "echo"}>
      <label
        for="compose_content"
        class="block text-sm font-medium text-gray-800"
      >
        Content
      </label>
      <textarea
        id="compose_content"
        name="compose[content]"
        rows="5"
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      >{@form[:content].value}</textarea>
    </div>

    <div :if={@command == "cat"}>
      <label
        for="compose_locator"
        class="block text-sm font-medium text-gray-800"
      >
        Source (bit://&lt;address&gt;/&lt;txid&gt;)
      </label>
      <input
        type="text"
        id="compose_locator"
        name="compose[locator]"
        value={@form[:locator].value}
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>

    <div :if={@command in ["echo", "cat"]}>
      <label
        for="compose_file"
        class="block text-sm font-medium text-gray-800"
      >
        File name
      </label>
      <input
        type="text"
        id="compose_file"
        name="compose[file]"
        value={@form[:file].value}
        placeholder="readme"
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>

    <div :if={@command == "route add"}>
      <label
        for="compose_admin"
        class="block text-sm font-medium text-gray-800"
      >
        Protocol address (whose route you serve)
      </label>
      <input
        type="text"
        id="compose_admin"
        name="compose[admin]"
        value={@form[:admin].value}
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>

    <div :if={@command in ["route enable", "route add"]}>
      <label
        for="compose_matcher"
        class="block text-sm font-medium text-gray-800"
      >
        Route matcher
      </label>
      <input
        type="text"
        id="compose_matcher"
        name="compose[matcher]"
        value={@form[:matcher].value}
        placeholder="/:tx"
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>

    <div :if={@command == "route add"}>
      <label
        for="compose_endpoint"
        class="block text-sm font-medium text-gray-800"
      >
        Endpoint template
      </label>
      <input
        type="text"
        id="compose_endpoint"
        name="compose[endpoint]"
        value={@form[:endpoint].value}
        placeholder="https://example.com/${tx}"
        class="mt-1 w-full rounded border-gray-300 font-mono text-sm"
      />
    </div>
  </.form>

  <section
    id="compose-result"
    class="mt-6"
  >
    <%= case @result do %>
      <% nil -> %>
        <p class="text-gray-700">
          Enter the funding address to build the output.
        </p>
      <% {:error, reason} -> %>
        <p class="text-red-800">
          Not a valid command yet: {reason}.
        </p>
      <% {:ok, out} -> %>
        <h2 class="text-xl font-semibold mb-2">
          Output script
        </h2>
        <p class="text-gray-700 mb-2">
          Add this as a 0-satoshi output to a transaction whose first input is spent from
          <span class="font-mono break-all">{out.funder}</span>.
          It applies to namespace
          <.link
            navigate={~p"/bitcom/#{out.namespace}"}
            class="font-mono text-blue-700 hover:underline break-all"
          >
            {out.namespace}
          </.link>.
        </p>
        <div class="text-sm text-gray-800 mb-1">
          Hex
        </div>
        <pre
          id="compose-hex"
          class="whitespace-pre-wrap break-all text-sm bg-gray-50 rounded p-3 mb-3"
        >{out.script_hex}</pre>
        <div class="text-sm text-gray-800 mb-1">
          ASM
        </div>
        <pre class="whitespace-pre-wrap break-all text-sm bg-gray-50 rounded p-3">{out.asm}</pre>
        <p class="text-sm text-gray-700 mt-3">
          Programmatic:
          <code>POST /api/v1/bitcom/compose</code>
          with
          <code>{"{\"funder\": …, \"pushes\": [\"echo\", …]}"}</code>.
        </p>
    <% end %>
  </section>
</div>
