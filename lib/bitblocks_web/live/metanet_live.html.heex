<div class="text-gray-900 dark:text-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
      <a
        href="/"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
      >
        &larr; Back
      </a>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
        Metanet Explorer
      </h1>
    </div>

    <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
      Navigate the Metanet DAG.
      Enter a transaction ID to see its node content, parent, and children.
    </p>

    <%!-- Search form --%>
    <form
      phx-submit="explore"
      class="flex gap-3 mb-6"
    >
      <label
        for="metanet-txid"
        class="sr-only"
      >
        Transaction ID
      </label>
      <input
        id="metanet-txid"
        type="text"
        name="txid"
        value={@txid}
        placeholder="Enter transaction ID..."
        class="flex-1 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-mono text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <button
        type="submit"
        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm transition-colors"
      >
        Explore
      </button>
    </form>

    <%= if @txid == "" do %>
      <%= if @roots == [] do %>
        <p
          id="metanet-roots"
          class="text-sm text-gray-600 dark:text-gray-400 mb-6"
        >
          No Metanet roots are indexed.
        </p>
      <% else %>
        <ul
          id="metanet-roots"
          class="mb-6 space-y-2"
        >
          <%= for root <- @roots do %>
            <li>
              <a
                href={"/metanet?txid=#{root.txid}"}
                class="text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
              >
                <%= root[:name] || root.txid_short %>
              </a>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%!-- Error --%>
    <%= if @error do %>
      <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 mb-6 text-sm text-red-800 dark:bg-red-900/30 dark:border-red-800 dark:text-red-200">
        <%= @error %>
      </div>
    <% end %>

    <%!-- Loading --%>
    <%= if @loading do %>
      <div class="text-amber-800 dark:text-amber-300 animate-pulse mb-6 text-sm">
        Loading Metanet node...
      </div>
    <% end %>

    <%!-- MURL breadcrumb --%>
    <%= if @murl do %>
      <div class="mb-6">
        <div class="text-xs text-gray-600 dark:text-gray-400 mb-1">
          MURL
        </div>
        <div class="flex items-center gap-1 text-sm font-mono">
          <span class="text-gray-600 dark:text-gray-400">
            mnp://
          </span>
          <%= for {segment, idx} <- Enum.with_index(@path) do %>
            <%= if idx > 0 do %>
              <span class="text-gray-500 dark:text-gray-400">
                /
              </span>
            <% end %>
            <button
              phx-click="navigate"
              phx-value-txid={segment.txid}
              class={"hover:text-blue-700 dark:hover:text-blue-400 transition-colors " <> if(segment.txid == @txid, do: "text-blue-700 dark:text-blue-400 font-semibold", else: "text-gray-700 dark:text-gray-300")}
            >
              <%= segment[:name] || String.slice(segment.txid, 0, 8) <> "..." %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%!-- Node details --%>
    <%= if @node do %>
      <div class="space-y-4">
        <%!-- Node card --%>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5">
          <div class="flex items-center gap-3 mb-4">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
              <%= @node[:name] || "Unnamed node" %>
            </h2>
            <%= if @node.is_root do %>
              <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
                root
              </span>
            <% end %>
            <%= if @node[:content_type] do %>
              <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                <%= @node.content_type %>
              </span>
            <% end %>
          </div>

          <div class="space-y-2 text-sm">
            <div class="flex items-start gap-3">
              <span class="text-gray-600 dark:text-gray-400 w-24 shrink-0">
                TxID
              </span>
              <a
                href={"/transactions/#{@node.txid}"}
                class="font-mono text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 break-all"
              >
                <%= @node.txid %>
              </a>
            </div>

            <%= if @node[:node_id] do %>
              <div class="flex items-start gap-3">
                <span class="text-gray-600 dark:text-gray-400 w-24 shrink-0">
                  Node ID
                </span>
                <span class="font-mono text-gray-800 dark:text-gray-200 break-all">
                  <%= @node.node_id %>
                </span>
              </div>
            <% end %>

            <div class="flex items-start gap-3">
              <span class="text-gray-600 dark:text-gray-400 w-24 shrink-0">
                Parent
              </span>
              <span class="font-mono text-gray-800 dark:text-gray-200 break-all">
                <%= @node.p_node %>
              </span>
            </div>

            <%= if @node[:block_height] do %>
              <div class="flex items-start gap-3">
                <span class="text-gray-600 dark:text-gray-400 w-24 shrink-0">
                  Block
                </span>
                <a
                  href={"/blocks/#{@node.block_height}"}
                  class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                >
                  <%= @node.block_height %>
                </a>
              </div>
            <% end %>
          </div>
        </div>

        <%!-- Content section --%>
        <%= if @node[:content] do %>
          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
              Content
            </h3>
            <div class="font-mono text-sm text-gray-800 dark:text-gray-200 whitespace-pre-wrap break-all bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded p-4">
              <%= @node.content %>
            </div>
          </div>
        <% end %>

        <%!-- Parent link --%>
        <%= if @parent do %>
          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4">
            <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Parent
            </h3>
            <button
              phx-click="navigate"
              phx-value-txid={@parent.txid}
              class="flex items-center gap-3 w-full text-left hover:bg-gray-100 dark:hover:bg-gray-700 rounded px-3 py-2 -mx-3 transition-colors"
            >
              <span class="font-mono text-sm text-blue-700 dark:text-blue-400">
                <%= String.slice(@parent.txid, 0, 24) %>...
              </span>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                <%= @parent[:name] || "unnamed" %>
              </span>
              <%= if @parent.is_root do %>
                <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
                  root
                </span>
              <% end %>
            </button>
          </div>
        <% end %>

        <%!-- Children list --%>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
            Children
            <span class="text-gray-600 dark:text-gray-400 font-normal">
              (<%= length(@children) %>)
            </span>
          </h3>
          <%= if length(@children) > 0 do %>
            <div class="space-y-1">
              <%= for child <- @children do %>
                <button
                  phx-click="navigate"
                  phx-value-txid={child.txid}
                  class="flex items-center gap-3 w-full text-left hover:bg-gray-100 dark:hover:bg-gray-700 rounded px-3 py-2 -mx-3 transition-colors"
                >
                  <span class="font-mono text-sm text-blue-700 dark:text-blue-400">
                    <%= String.slice(child.txid, 0, 16) %>...
                  </span>
                  <span class="text-sm text-gray-700 dark:text-gray-300">
                    <%= child[:name] || "unnamed" %>
                  </span>
                  <%= if child[:content_type] do %>
                    <span class="text-xs text-gray-600 dark:text-gray-400">
                      <%= child.content_type %>
                    </span>
                  <% end %>
                </button>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              No child nodes.
            </p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
