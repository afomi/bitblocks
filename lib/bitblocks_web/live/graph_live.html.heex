<div class="bg-surface-base min-h-screen">
  <div class="max-w-7xl mx-auto px-4">
    <section class="border-b border-neutral-800 pt-16 pb-16">
      <h1 class="text-4xl font-semibold text-neutral-50 tracking-tight mb-2">
        Transaction Graph
      </h1>
      <p class="text-sm text-neutral-500">
        Enter a transaction ID to see how it connects to other transactions.
        The graph shows inputs (where value came from) and outputs (where value went to).
      </p>
    </section>

    <%!-- Graph Controls --%>
    <section class="border-b border-neutral-800 py-12">
      <form
        phx-submit="load_graph"
      >
        <div class="mb-6">
          <label
            for="graph-txid"
            class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-3 block"
          >
            Transaction ID
          </label>
          <input
            type="text"
            name="txid"
            id="graph-txid"
            value={@start_txid}
            placeholder="Enter a transaction ID..."
            class="w-full px-4 py-3 bg-surface-raised border border-neutral-700 rounded text-neutral-50 font-mono text-sm focus:outline-none focus:border-brand placeholder:text-neutral-500"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="graph-depth"
            class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-3 block"
          >
            Graph Depth
          </label>
          <select
            name="depth"
            id="graph-depth"
            class="px-4 py-3 bg-surface-raised border border-neutral-700 rounded text-neutral-50 text-sm focus:outline-none focus:border-brand"
          >
            <option
              value="1"
              selected={@depth == 1}
            >
              1 level
            </option>
            <option
              value="2"
              selected={@depth == 2}
            >
              2 levels
            </option>
            <option
              value="3"
              selected={@depth == 3}
            >
              3 levels
            </option>
            <option
              value="4"
              selected={@depth == 4}
            >
              4 levels
            </option>
          </select>
        </div>

        <button
          type="submit"
          class="px-6 py-3 bg-brand text-white font-medium rounded hover:opacity-90 transition-colors"
        >
          Load Graph
        </button>
      </form>
    </section>

    <%!-- Graph Visualization --%>
    <%= if @graph_data do %>
      <section class="border-b border-neutral-800 py-12">
        <%= case @graph_data do %>
          <% {:error, message} -> %>
            <div class="bg-surface-raised rounded p-6 border border-neutral-700">
              <p class="text-sm text-neutral-400">
                <%= message %>
              </p>
            </div>

          <% %{nodes: nodes, edges: edges} -> %>
            <div class="mb-4">
              <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-1">
                Transaction Network
              </p>
              <p class="text-sm text-neutral-500">
                <%= length(nodes) %> transactions, <%= length(edges) %> connections
              </p>
            </div>

            <div
              id="transaction-graph"
              phx-hook="TransactionGraph"
              data-graph-data={Jason.encode!(%{nodes: nodes, edges: edges})}
              class="w-full border border-neutral-800 rounded bg-surface-raised"
              style="height: 600px;"
            >
            </div>

            <div class="mt-6 text-sm text-neutral-500">
              <p class="mb-3">
                Value flows from left to right.
              </p>
              <div class="flex gap-6 flex-wrap font-mono text-xs">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 bg-green-500 rounded"></div>
                  <span>Inputs (left)</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 bg-brand rounded"></div>
                  <span>Selected (center)</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 bg-neutral-400 rounded"></div>
                  <span>Outputs (right)</span>
                </div>
              </div>
            </div>
        <% end %>
      </section>
    <% end %>

    <%!-- Example Transactions --%>
    <section class="py-16">
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-6">
        Examples
      </p>
      <div class="border-t border-neutral-800">
        <div class="py-4 border-b border-neutral-800">
          <p class="text-sm font-medium text-neutral-50 mb-2">
            Genesis Coinbase
          </p>
          <code class="text-xs font-mono text-neutral-400 bg-surface-raised px-2 py-1 rounded break-all">
            4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b
          </code>
        </div>
        <div class="py-4 border-b border-neutral-800">
          <p class="text-sm font-medium text-neutral-50 mb-2">
            First Bitcoin Transaction
          </p>
          <code class="text-xs font-mono text-neutral-400 bg-surface-raised px-2 py-1 rounded break-all">
            f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16
          </code>
        </div>
      </div>
    </section>
  </div>
</div>
