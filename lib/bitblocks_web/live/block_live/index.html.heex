<div
  class="bg-surface-base min-h-screen"
  role="region"
  aria-labelledby="blocks-heading"
>
  <div class="max-w-7xl mx-auto px-4">
    <section class="border-b border-neutral-800 pt-16 pb-16">
      <h1
        id="blocks-heading"
        class="text-4xl font-semibold text-neutral-50 tracking-tight mb-2"
      >
        Blocks
      </h1>
      <p class="text-sm text-neutral-500">
        Page <%= @page %> of <%= @total_pages %>
        · <%= format_number(@total_blocks) %> total
      </p>
    </section>

    <%= if @live_action in [:new, :edit] do %>
      <.modal
        id="block-modal"
        show
        on_cancel={JS.patch(~p"/blocks")}
      >
        <.live_component
          module={BitblocksWeb.BlockLive.FormComponent}
          id={@block.id || :new}
          title={@page_title}
          action={@live_action}
          block={@block}
          return_to={~p"/blocks"}
        />
      </.modal>
    <% end %>

    <%!-- Block List --%>
    <div class="border-t border-neutral-800">
      <%= for block <- @blocks do %>
        <a
          href={~p"/blocks/#{block.height}"}
          id={"block-#{block.height}"}
          class="flex items-center justify-between py-4 border-b border-neutral-800 group"
        >
          <div class="flex items-center gap-6">
            <span class="text-lg font-semibold text-neutral-50 tabular-nums group-hover:text-brand transition-colors duration-150">
              <%= format_number(block.height) %>
            </span>
            <span class="font-mono text-xs text-neutral-500 hidden sm:inline break-all">
              <%= block.hash %>
            </span>
          </div>

          <div class="flex items-center gap-6">
            <span class="font-mono text-xs text-neutral-500 tabular-nums">
              <%= format_number(block.num_tx) %> tx
            </span>
            <span
              :if={block.size}
              class="font-mono text-xs text-neutral-500 tabular-nums hidden sm:inline"
            >
              <%= format_bytes(block.size) %>
            </span>
            <span class="font-mono text-xs text-neutral-500 tabular-nums w-20 text-right">
              <%= format_timestamp(block.time) %>
            </span>
          </div>
        </a>
      <% end %>
    </div>

    <%!-- Pagination --%>
    <div class="flex items-center justify-between py-8">
      <p class="font-mono text-xs text-neutral-500">
        Page <%= @page %> of <%= @total_pages %>
      </p>

      <div class="flex gap-3">
        <%= if @page > 1 do %>
          <.link
            patch={~p"/blocks?page=#{@page - 1}"}
            class="px-6 py-3 bg-surface-raised text-neutral-50 border border-neutral-700 rounded hover:bg-surface-overlay transition-colors font-medium text-sm"
          >
            Previous
          </.link>
        <% else %>
          <span class="px-6 py-3 bg-surface-raised text-neutral-500 border border-neutral-800 rounded text-sm cursor-not-allowed">
            Previous
          </span>
        <% end %>

        <%= if @page < @total_pages do %>
          <.link
            patch={~p"/blocks?page=#{@page + 1}"}
            class="px-6 py-3 bg-surface-raised text-neutral-50 border border-neutral-700 rounded hover:bg-surface-overlay transition-colors font-medium text-sm"
          >
            Next
          </.link>
        <% else %>
          <span class="px-6 py-3 bg-surface-raised text-neutral-500 border border-neutral-800 rounded text-sm cursor-not-allowed">
            Next
          </span>
        <% end %>
      </div>
    </div>
  </div>
</div>
