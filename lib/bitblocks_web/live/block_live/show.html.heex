<div class="bg-surface-base min-h-screen">
  <div class="max-w-7xl mx-auto px-4">
    <%!-- Header with height + navigation --%>
    <section class="border-b border-neutral-800 pt-16 pb-8">
      <div class="mb-4">
        <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
          Block
        </p>
        <div class="flex items-center gap-4">
          <.link
            navigate={~p"/blocks/#{@block.height - 1}"}
            class="text-neutral-600 hover:text-neutral-50 transition-colors"
            title={"Block #{@block.height - 1}"}
            aria-label={"Previous block: #{@block.height - 1}"}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-8 h-8"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z"
                clip-rule="evenodd"
              />
            </svg>
          </.link>
          <h1 class="text-4xl font-semibold text-neutral-50 tabular-nums tracking-tight">
            <%= @block.height %>
          </h1>
          <.link
            navigate={~p"/blocks/#{@block.height + 1}"}
            class="text-neutral-600 hover:text-neutral-50 transition-colors"
            title={"Block #{@block.height + 1}"}
            aria-label={"Next block: #{@block.height + 1}"}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-8 h-8"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.28 11.47a.75.75 0 0 1 0 1.06l-7.5 7.5a.75.75 0 0 1-1.06-1.06L14.69 12 7.72 5.03a.75.75 0 0 1 1.06-1.06l7.5 7.5Z"
                clip-rule="evenodd"
              />
            </svg>
          </.link>
        </div>
      </div>
      <p class="font-mono text-xs text-neutral-500 break-all">
        <%= @block.hash %>
      </p>
    </section>

    <%!-- Sync State --%>
    <section class="border-b border-neutral-800 py-6">
      <div class="flex items-center justify-between mb-4">
        <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider">
          Sync Status
        </p>
        <button
          phx-click="download_transactions"
          class={[
            "px-4 py-2 rounded text-sm font-medium transition-colors",
            if(@downloading || @transactions_downloaded,
              do: "bg-surface-raised text-neutral-500 border border-neutral-800 cursor-not-allowed",
              else: "bg-brand text-white hover:opacity-90"
            )
          ]}
          disabled={@downloading || @transactions_downloaded}
        >
          <%= cond do %>
            <% @transactions_downloaded -> %>
              ✓ Downloaded
            <% @downloading -> %>
              Queuing…
            <% @block.sync_state == "header_only" -> %>
              Upgrade & Download Txs
            <% true -> %>
              Download Txs
          <% end %>
        </button>
      </div>

      <div class="flex items-center gap-1">
        <% steps = ["header_only", "header_synced", "txs_queued", "txs_syncing", "completed"] %>
        <% current_idx = Enum.find_index(steps, &(&1 == @block.sync_state)) || 0 %>
        <%= for {step, idx} <- Enum.with_index(steps) do %>
          <div class="flex-1">
            <div class={[
              "h-1 rounded-full transition-all",
              cond do
                @block.sync_state == "failed" && idx == current_idx -> "bg-red-500"
                idx < current_idx -> "bg-green-500"
                idx == current_idx -> "bg-brand"
                true -> "bg-neutral-800"
              end
            ]}>
            </div>
            <p class="font-mono text-[10px] text-neutral-500 mt-1.5 text-center">
              <%= String.replace(step, "_", " ") %>
            </p>
          </div>
          <div
            :if={idx < length(steps) - 1}
            class="text-neutral-700 text-xs px-0.5"
          >
            →
          </div>
        <% end %>
      </div>
    </section>

    <%= if @live_action in [:edit] do %>
      <.modal
        :if={@live_action == :edit}
        id="blocks-modal"
        show
        on_cancel={JS.patch(~p"/blocks/#{@block}")}
      >
        <.live_component
          module={BitblocksWeb.BlockLive.FormComponent}
          id={@block.id}
          title={@page_title}
          action={@live_action}
          block={@block}
          patch={~p"/blocks/#{@blocks}"}
        />
      </.modal>
    <% end %>

    <%!-- Block Metadata + Transactions in two columns --%>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 lg:gap-8">
      <%!-- Left: Metadata --%>
      <section class="border-b border-neutral-800 py-8 lg:border-b-0">
        <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-6">
          Block Data
        </p>
        <div class="border-t border-neutral-800">
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Time</span>
            <span class="font-mono text-xs text-neutral-400 tabular-nums">
              <%= if @block.time, do: DateTime.from_unix!(@block.time) |> Calendar.strftime("%Y-%m-%d %H:%M:%S UTC"), else: "—" %>
            </span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Size</span>
            <span class="font-mono text-xs text-neutral-400 tabular-nums">
              <%= if @block.size, do: format_number(@block.size), else: "—" %> bytes
            </span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Version</span>
            <span class="font-mono text-xs text-neutral-400"><%= @block.version %></span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Nonce</span>
            <span class="font-mono text-xs text-neutral-400 tabular-nums"><%= @block.nonce %></span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span
              class="font-mono text-xs text-neutral-500"
              title="Compact encoding of the difficulty target. Recalculated every 2016 blocks based on actual vs. target time for that window."
            >
              Bits
            </span>
            <span class="font-mono text-xs text-neutral-400">
              <%= @block.bits %>
              <%= if leading = bits_to_leading_zero_chars(@block.bits) do %>
                <span class="text-neutral-600 ml-1">(<%= leading %> leading zeros)</span>
              <% end %>
            </span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span
              class="font-mono text-xs text-neutral-500"
              title="Height where bits will be recalculated based on hashrate over the prior 2016 blocks"
            >
              Next Adjustment
            </span>
            <span class="font-mono text-xs text-neutral-400">
              <% next = div(@block.height, 2016) * 2016 + 2016 %>
              <% blocks_away = next - @block.height %>
              <.link
                navigate={~p"/blocks/#{next}"}
                class="hover:text-brand transition-colors"
              >
                <%= next %>
              </.link>
              <span class="text-neutral-600 ml-1">(<%= blocks_away %> blocks)</span>
            </span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Difficulty</span>
            <span class="font-mono text-xs text-neutral-400"><%= @block.difficulty %></span>
          </div>
          <div class="py-3 border-b border-neutral-800 flex justify-between">
            <span class="font-mono text-xs text-neutral-500">Median Time</span>
            <span class="font-mono text-xs text-neutral-400 tabular-nums"><%= @block.mediantime %></span>
          </div>
          <div class="py-3 border-b border-neutral-800">
            <span class="font-mono text-xs text-neutral-500 block mb-1">Merkle Root</span>
            <span class="font-mono text-xs text-neutral-400 break-all"><%= @block.merkleroot %></span>
          </div>
          <div class="py-3 border-b border-neutral-800">
            <span class="font-mono text-xs text-neutral-500 block mb-1">Chainwork</span>
            <span class="font-mono text-xs text-neutral-400 break-all"><%= @block.chainwork %></span>
          </div>
          <div
            :if={@block.prevblockhash}
            class="py-3 border-b border-neutral-800"
          >
            <span class="font-mono text-xs text-neutral-500 block mb-1">Previous Block</span>
            <.link
              navigate={~p"/blocks/#{@block.height - 1}"}
              class="font-mono text-xs text-neutral-400 hover:text-brand transition-colors duration-150 break-all"
            >
              <%= @block.prevblockhash %>
            </.link>
          </div>
          <div class="py-3 border-b border-neutral-800">
            <span class="font-mono text-xs text-neutral-500 block mb-1">Next Block</span>
            <.link
              navigate={~p"/blocks/#{@block.height + 1}"}
              class="font-mono text-xs text-neutral-400 hover:text-brand transition-colors duration-150 break-all"
            >
              <%= if @block.nextblockhash && @block.nextblockhash != "",
                do: @block.nextblockhash,
                else: "→ Block #{@block.height + 1}" %>
            </.link>
          </div>
        </div>
      </section>

      <%!-- Right: Transactions --%>
      <section class="py-8">
        <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
          Transactions
        </p>
        <p class="text-2xl font-semibold text-neutral-50 tabular-nums mb-6">
          <%= @block.num_tx %>
        </p>
        <div :if={@block.tx && length(@block.tx) > 0}>
          <% page_size = BitblocksWeb.BlockLive.Show.tx_page_size() %>
          <% total_txs = length(@block.tx) %>
          <% total_pages = ceil(total_txs / page_size) %>
          <% page_txids = Enum.slice(@block.tx, (@tx_page - 1) * page_size, page_size) %>
          <div class="border-t border-neutral-800">
            <%= for txid <- page_txids do %>
              <.link
                navigate={~p"/transactions/#{txid}"}
                class="block py-2 border-b border-neutral-800 font-mono text-xs text-neutral-400 hover:text-brand transition-colors duration-150 break-all"
              >
                <%= txid %>
              </.link>
            <% end %>
          </div>
          <div
            :if={total_pages > 1}
            class="flex items-center justify-between mt-4"
          >
            <button
              phx-click="tx_page"
              phx-value-page={@tx_page - 1}
              disabled={@tx_page <= 1}
              class="font-mono text-xs text-neutral-400 hover:text-neutral-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            >
              ← prev
            </button>
            <span class="font-mono text-xs text-neutral-500">
              <%= @tx_page %> / <%= total_pages %>
            </span>
            <button
              phx-click="tx_page"
              phx-value-page={@tx_page + 1}
              disabled={@tx_page >= total_pages}
              class="font-mono text-xs text-neutral-400 hover:text-neutral-50 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
            >
              next →
            </button>
          </div>
        </div>
        <p
          :if={is_nil(@block.tx) || @block.tx == []}
          class="text-sm text-neutral-500"
        >
          Transaction IDs not yet synced for this block.
        </p>
      </section>
    </div>

    <%!-- Footer nav --%>
    <section class="border-t border-neutral-800 py-8">
      <div class="flex items-center justify-between">
        <.link
          navigate={~p"/blocks/"}
          class="text-sm text-neutral-400 hover:text-neutral-50 transition-colors duration-150"
        >
          ← All blocks
        </.link>
        <.link
          patch={~p"/blocks/#{@block}"}
          class="text-sm text-neutral-400 hover:text-neutral-50 transition-colors duration-150"
        >
          Edit
        </.link>
      </div>
    </section>
  </div>
</div>
