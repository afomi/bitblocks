<div class="max-w-4xl mx-auto px-4 py-8 text-gray-900 dark:text-gray-100">
  <nav
    id="type-breadcrumb"
    aria-label="Breadcrumb"
    class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-3"
  >
    <.link
      navigate={~p"/types"}
      class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 hover:underline"
    >
      Transaction types
    </.link>
    <span aria-hidden="true">/</span>
    <span class="text-gray-900 dark:text-white font-semibold">
      <%= @type.short %>
    </span>
  </nav>

  <div class="flex flex-wrap items-center gap-3 mb-3">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white">
      <%= @type.title %>
    </h1>
    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-semibold text-gray-800 dark:bg-gray-800 dark:text-gray-200">
      <%= @type.short %>
    </span>
    <span
      :if={!@type.spendable}
      id="type-unspendable"
      class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200"
    >
      Unspendable
    </span>
  </div>

  <p
    id="type-summary"
    class="text-lg text-gray-800 dark:text-gray-200 mb-8"
  >
    <%= @type.summary %>
  </p>

  <section
    id="type-description"
    aria-labelledby="type-description-heading"
    class="mb-8"
  >
    <h2
      id="type-description-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      What it is
    </h2>
    <p class="text-gray-700 dark:text-gray-300">
      <%= Enum.join(@type.description, "\n") %>
    </p>
  </section>

  <section
    id="type-pattern"
    aria-labelledby="type-pattern-heading"
    class="mb-8"
  >
    <h2
      id="type-pattern-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Script pattern
    </h2>
    <ol class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-700">
      <li
        :for={part <- @type.pattern.parts}
        class="grid grid-cols-1 gap-1 p-3 sm:grid-cols-5 sm:gap-4"
      >
        <code class="sm:col-span-2 break-all rounded bg-gray-50 px-2 py-1 font-mono text-sm text-gray-900 dark:bg-gray-900 dark:text-gray-100">
          <%= part.token %>
        </code>
        <span class="sm:col-span-3 text-sm text-gray-700 dark:text-gray-300">
          <%= part.label %>
        </span>
      </li>
    </ol>
    <p
      :if={@type.pattern[:note]}
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
    >
      <%= @type.pattern.note %>
    </p>
  </section>

  <section
    id="type-spend"
    aria-labelledby="type-spend-heading"
    class="mb-8"
  >
    <h2
      id="type-spend-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      How it is spent
    </h2>
    <p class="text-gray-700 dark:text-gray-300">
      <%= @type.spend %>
    </p>
  </section>

  <section
    id="type-history"
    aria-labelledby="type-history-heading"
    class="mb-8"
  >
    <h2
      id="type-history-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Background
    </h2>
    <p class="text-gray-700 dark:text-gray-300">
      <%= Enum.join(@type.history, "\n") %>
    </p>
  </section>

  <section
    :if={@type[:concepts]}
    id="type-concepts"
    aria-labelledby="type-concepts-heading"
    class="mb-8"
  >
    <h2
      id="type-concepts-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Concepts
    </h2>
    <dl class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-700">
      <div
        :for={concept <- @type.concepts}
        id={"concept-#{String.downcase(String.replace(concept.term, " ", "-"))}"}
        class="p-4"
      >
        <dt class="font-semibold text-gray-900 dark:text-white mb-1">
          <%= concept.term %>
        </dt>
        <dd class="text-sm text-gray-700 dark:text-gray-300">
          <%= concept.text %>
        </dd>
      </div>
    </dl>
  </section>

  <section
    :if={@adoption}
    id="type-adoption"
    aria-labelledby="type-adoption-heading"
    class="mb-8"
  >
    <h2
      id="type-adoption-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      First seen and adoption
    </h2>
    <p
      id="type-first-seen"
      class="text-gray-800 dark:text-gray-200 mb-2"
    >
      First seen in block
      <.link
        navigate={~p"/blocks/#{@count.first_height}"}
        class="text-blue-700 hover:underline dark:text-blue-300"
      ><%= format_height(@count.first_height) %></.link><%= if @adoption.first_time do %>, on <%= format_time(@adoption.first_time) %><% end %>.
      <%= if @adoption.first_txid do %>
        Its first transaction is
        <.link
          navigate={~p"/transactions/#{@adoption.first_txid}"}
          class="font-mono text-sm text-blue-700 hover:underline break-all dark:text-blue-300"
        ><%= @adoption.first_txid %></.link>.
      <% end %>
    </p>
    <p
      id="type-adoption-coverage"
      class="text-sm text-gray-700 dark:text-gray-300 mb-2"
    >
      <%= Counts.coverage_note(@counts) %>
      First seen means first seen in that range.
    </p>
    <table
      id="type-adoption-table"
      class="text-sm text-gray-800 dark:text-gray-200"
    >
      <caption class="sr-only">
        Transactions of this type per 10,000 blocks
      </caption>
      <thead>
        <tr>
          <th
            scope="col"
            class="pr-6 text-left font-semibold"
          >
            From block
          </th>
          <th
            scope="col"
            class="text-right font-semibold"
          >
            Transactions
          </th>
        </tr>
      </thead>
      <tbody>
        <tr :for={bucket <- @adoption.per_10000_blocks}>
          <td class="pr-6">
            <%= format_height(bucket.from_height) %>
          </td>
          <td class="text-right">
            <%= format_count(bucket.txs) %>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <section
    id="type-examples"
    aria-labelledby="type-examples-heading"
    class="mb-8"
  >
    <h2
      id="type-examples-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      On chain
    </h2>
    <%= case @examples.status do %>
      <% :coming -> %>
        <p
          id="type-examples-coming"
          class="text-gray-700 dark:text-gray-300"
        >
          Examples coming.
          <%= @examples.source %>
        </p>
      <% :unavailable -> %>
        <p
          id="type-examples-unavailable"
          class="rounded-lg border border-red-200 bg-red-50 p-3 text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200"
        >
          Examples are unavailable right now.
          Please try again shortly.
        </p>
      <% :ok -> %>
        <p
          :if={@examples.count}
          id="type-examples-count"
          class="text-gray-800 dark:text-gray-200 mb-2"
        >
          <span class="font-semibold">
            <%= format_count(@examples.count) %>
          </span>
          <%= @examples.count_label %>.
        </p>
        <p
          :if={@examples.items == []}
          id="type-examples-empty"
          class="text-gray-700 dark:text-gray-300"
        >
          None in our index yet.
        </p>
        <ul
          :if={@examples.items != []}
          id="type-examples-list"
          role="list"
          class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-700"
        >
          <li
            :for={example <- @examples.items}
            class="flex flex-wrap items-baseline justify-between gap-2 p-3"
          >
            <a
              href={~p"/transactions/#{example.txid}"}
              class="font-mono text-sm break-all text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 hover:underline"
            >
              <%= example.txid %>
            </a>
            <span class="text-xs text-gray-600 dark:text-gray-400">
              <span :if={example.note}>
                <%= example.note %> ·
              </span>
              block <%= format_height(example.block_height) %>
            </span>
          </li>
        </ul>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          <%= @examples.source %>
          Transaction pages need sign-in.
        </p>
    <% end %>
  </section>

  <section
    id="type-spec"
    aria-labelledby="type-spec-heading"
    class="mb-8"
  >
    <h2
      id="type-spec-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Specification
    </h2>
    <ul
      role="list"
      class="space-y-1"
    >
      <li>
        <a
          id="type-spec-link"
          href={@type.spec.url}
          rel="noopener noreferrer"
          class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
        >
          <%= @type.spec.label %>
        </a>
      </li>
      <li :if={@type[:explore]}>
        <.link
          id="type-explore-link"
          href={@type.explore.href}
          class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
        >
          <%= @type.explore.label %>
        </.link>
      </li>
      <li>
        <a
          id="type-api-link"
          href={"/api/v1/types/#{@type.id}"}
          class="font-mono text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
        >
          /api/v1/types/<%= @type.id %>
        </a>
      </li>
    </ul>
  </section>

  <section
    :if={@related != []}
    id="type-related"
    aria-labelledby="type-related-heading"
    class="mb-8"
  >
    <h2
      id="type-related-heading"
      class="text-xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Related types
    </h2>
    <ul
      role="list"
      class="flex flex-wrap gap-2"
    >
      <li :for={related <- @related}>
        <.link
          id={"related-#{related.id}"}
          navigate={~p"/types/#{related.id}"}
          class="inline-block rounded-lg border border-gray-200 bg-white px-3 py-1 text-sm text-blue-700 hover:border-orange-400 hover:text-blue-900 dark:border-gray-700 dark:bg-gray-800 dark:text-blue-400 dark:hover:text-blue-300"
        >
          <%= related.title %>
        </.link>
      </li>
    </ul>
  </section>

  <aside
    :if={@type[:attribution]}
    id="type-attribution"
    class="border-t border-gray-200 dark:border-gray-700 pt-4 text-sm text-gray-600 dark:text-gray-400"
  >
    <%= @type.attribution.text %>
    <a
      href={@type.attribution.source_url}
      rel="noopener noreferrer"
      class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
    >
      Read the original paper
    </a>.
    Licensed under
    <a
      href={@type.attribution.license_url}
      rel="license noopener noreferrer"
      class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
    >
      <%= @type.attribution.license %>
    </a>.
    <%= @type.attribution.share_alike %>
  </aside>
</div>
