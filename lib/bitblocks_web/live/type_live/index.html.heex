<div class="max-w-5xl mx-auto px-4 py-8 text-gray-900 dark:text-gray-100">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-3">
    Bitcoin transaction types
  </h1>
  <p class="text-gray-700 dark:text-gray-300 mb-2 max-w-3xl">
    Every output on chain follows a pattern: a payment, an object, a token, a record, or a contract.
    Each type here has its script pattern with every part labelled, how it is spent, where it came from, and real transactions from our index.
  </p>
  <p class="text-gray-700 dark:text-gray-300 mb-4 max-w-3xl">
    The same definitions, with their counts, are at
    <a
      href="/api/v1/types"
      class="font-mono text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
    >
      /api/v1/types
    </a>.
  </p>
  <div
    id="type-counts-coverage"
    class="mb-8 max-w-3xl rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
  >
    <%= case @counts do %>
      <% %{status: :ok, through_height: through} = counts when through >= 0 -> %>
        <p>
          Counts cover blocks
          <span class="font-mono tabular-nums">0</span>
          to
          <span class="font-mono tabular-nums"><%= delimit(through) %></span>
          of <span class="font-mono tabular-nums"><%= delimit(counts.tip) %></span> known.
          Every block in that range is verified complete and typed, so the counts grow as the sync climbs toward the tip.
          <%= if through < counts.complete_through do %>
            Blocks
            <span class="font-mono tabular-nums"><%= delimit(through + 1) %></span>
            to
            <span class="font-mono tabular-nums"><%= delimit(counts.complete_through) %></span>
            are complete and not typed yet.
          <% end %>
        </p>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          A transaction with several types counts once under each, and anything no type matches counts as custom.
          Computed by type counts v<%= counts.version %> at
          <time
            datetime={DateTime.to_iso8601(counts.computed_at)}
            class="font-mono tabular-nums"
          ><%= Calendar.strftime(counts.computed_at, "%Y-%m-%d %H:%M UTC") %></time>, from the block tallies.
        </p>
      <% %{status: :ok} -> %>
        <p>
          No block is typed yet, so there are no counts.
          They start once block 0 is verified complete and typed.
        </p>
      <% %{status: :pending} -> %>
        <p>
          Counts are being computed.
          They appear here within a few minutes.
        </p>
      <% _ -> %>
        <p>
          Counts are unavailable right now.
        </p>
    <% end %>
  </div>

  <section
    :for={group <- @groups}
    id={"group-#{group.id}"}
    aria-labelledby={"group-#{group.id}-heading"}
    class="mb-10"
  >
    <h2
      id={"group-#{group.id}-heading"}
      class="text-2xl font-semibold text-gray-900 dark:text-white mb-1"
    >
      <%= group.title %>
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      <%= group.summary %>
    </p>
    <ul
      role="list"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2"
    >
      <li :for={type <- group.types}>
        <.link
          id={"type-#{type.id}"}
          navigate={~p"/types/#{type.id}"}
          class="block h-full bg-white border border-gray-200 rounded-lg p-4 hover:border-orange-400 dark:bg-gray-800 dark:border-gray-700"
        >
          <span class="flex items-center justify-between gap-3 mb-1">
            <span class="font-semibold text-gray-900 dark:text-white">
              <%= type.title %>
            </span>
            <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-semibold text-gray-800 dark:bg-gray-900 dark:text-gray-200">
              <%= type.short %>
            </span>
          </span>
          <span class="block text-sm text-gray-700 dark:text-gray-300">
            <%= type.summary %>
          </span>
          <span
            :if={count = count(@counts, type)}
            id={"type-#{type.id}-count"}
            class="mt-2 block text-xs text-gray-600 dark:text-gray-400"
          >
            <%= if count.txs > 0 do %>
              <span class="font-mono tabular-nums"><%= txs(count.txs) %></span>
              since block
              <span class="font-mono tabular-nums"><%= delimit(count.first_height) %></span>
            <% else %>
              none yet in the blocks counted
            <% end %>
          </span>
        </.link>
      </li>
    </ul>
  </section>
</div>
