<div class="max-w-5xl mx-auto px-4 py-8 text-gray-900 dark:text-gray-100">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-3">
    Bitcoin transaction types
  </h1>
  <p class="text-gray-700 dark:text-gray-300 mb-2 max-w-3xl">
    Every output on chain follows a pattern: a payment, an object, a token, a record, or a contract.
    Each type here has its script pattern with every part labelled, how it is spent, where it came from, and real transactions from our index.
  </p>
  <p class="text-gray-700 dark:text-gray-300 mb-4 max-w-3xl">
    The same definitions, with their counts, are at
    <a
      href="/api/v1/types"
      class="font-mono text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
    >
      /api/v1/types
    </a>.
  </p>
  <div
    id="type-counts-coverage"
    class="mb-8 max-w-3xl rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
  >
    <%= case @counts do %>
      <% %{status: :ok, through_height: through} = counts when through >= 0 -> %>
        <p>
          Counts cover blocks
          <span class="font-mono tabular-nums">0</span>
          to
          <span class="font-mono tabular-nums"><%= delimit(through) %></span>
          of <span class="font-mono tabular-nums"><%= delimit(counts.tip) %></span> known.
          Every block in that range is verified complete and typed, so the counts grow as the sync climbs toward the tip.
          <%= if through < counts.complete_through do %>
            Blocks
            <span class="font-mono tabular-nums"><%= delimit(through + 1) %></span>
            to
            <span class="font-mono tabular-nums"><%= delimit(counts.complete_through) %></span>
            are complete and not typed yet.
          <% end %>
        </p>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          A transaction with several types counts once under each, and anything no type matches counts as custom.
          Computed by type counts v<%= counts.version %> at
          <time
            datetime={DateTime.to_iso8601(counts.computed_at)}
            class="font-mono tabular-nums"
          ><%= Calendar.strftime(counts.computed_at, "%Y-%m-%d %H:%M UTC") %></time>, from the block tallies.
        </p>
      <% %{status: :ok} = counts -> %>
        <p id="types-no-counts">
          <%= Counts.coverage_note(counts) %>
        </p>
      <% %{status: :pending} -> %>
        <p>
          Counts are being computed.
          They appear here within a few minutes.
        </p>
      <% _ -> %>
        <p>
          Counts are unavailable right now.
        </p>
    <% end %>
  </div>

  <section
    id="layers"
    aria-labelledby="layers-heading"
    class="mb-10"
  >
    <h2
      id="layers-heading"
      class="text-2xl font-semibold text-gray-900 dark:text-white mb-1"
    >
      Building on Bitcoin
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Four layers, each resting on the one below.
    </p>
    <ol
      role="list"
      class="space-y-2"
    >
      <li
        :for={layer <- layers()}
        id={"layer-#{layer.level}"}
        class="flex items-start gap-4 bg-white border border-gray-200 rounded-lg p-4 dark:bg-gray-800 dark:border-gray-700"
      >
        <span class="font-mono text-2xl font-bold text-gray-500 dark:text-gray-400">
          <%= layer.level %>
        </span>
        <span>
          <span class="block font-semibold text-gray-900 dark:text-white">
            <%= if layer.href do %>
              <a
                href={layer.href}
                class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
              >
                <%= layer.title %>
              </a>
            <% else %>
              <%= layer.title %>
            <% end %>
          </span>
          <span class="block text-sm text-gray-700 dark:text-gray-300">
            <%= layer.summary %>
          </span>
        </span>
      </li>
    </ol>
  </section>

  <section
    :for={group <- @groups}
    id={"group-#{group.id}"}
    aria-labelledby={"group-#{group.id}-heading"}
    class="mb-10"
  >
    <h2
      id={"group-#{group.id}-heading"}
      class="text-2xl font-semibold text-gray-900 dark:text-white mb-1"
    >
      <%= group.title %>
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      <%= group.summary %>
    </p>
    <ul
      role="list"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2"
    >
      <li :for={type <- group.types}>
        <.link
          id={"type-#{type.id}"}
          navigate={~p"/types/#{type.id}"}
          class="block h-full bg-white border border-gray-200 rounded-lg p-4 hover:border-orange-400 dark:bg-gray-800 dark:border-gray-700"
        >
          <span class="flex items-center justify-between gap-3 mb-1">
            <span class="font-semibold text-gray-900 dark:text-white">
              <%= type.title %>
            </span>
            <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs font-semibold text-gray-800 dark:bg-gray-900 dark:text-gray-200">
              <%= type.short %>
            </span>
          </span>
          <span class="block text-sm text-gray-700 dark:text-gray-300">
            <%= type.summary %>
          </span>
          <span
            :if={count = count(@counts, type)}
            id={"type-#{type.id}-count"}
            class="mt-2 block text-xs text-gray-600 dark:text-gray-400"
          >
            <%= if count.txs > 0 do %>
              <span class="font-mono tabular-nums"><%= txs(count.txs) %></span>
              since block
              <span class="font-mono tabular-nums"><%= delimit(count.first_height) %></span>
            <% else %>
              none yet in the blocks counted
            <% end %>
          </span>
        </.link>
      </li>
    </ul>
  </section>

  <section
    id="protocols"
    aria-labelledby="protocols-heading"
    class="mb-10"
  >
    <h2
      id="protocols-heading"
      class="text-2xl font-semibold text-gray-900 dark:text-white mb-1"
    >
      Registered protocols
    </h2>
    <p class="text-gray-600 dark:text-gray-400 mb-1 max-w-3xl">
      <%= @protocol_count %> application protocols, each named by a Bitcoin address placed first in its data.
      Some are also a type above, and each of those links to its type.
    </p>
    <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-3xl">
      Who owns an address is on the
      <.link
        navigate={~p"/bitcom"}
        class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
      >
        Bitcom registry
      </.link>,
      with on-chain proof.
      The same list is at
      <span class="font-mono text-sm">/api/v1/protocols</span>
      with an API key.
    </p>
    <p
      :if={@protocols == []}
      id="protocols-none"
      class="text-gray-700 dark:text-gray-300"
    >
      No protocols are registered yet.
    </p>
    <ul
      :if={@protocols != []}
      role="list"
      class="space-y-2"
    >
      <li
        :for={protocol <- @protocols}
        class="bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700"
      >
        <details id={"protocol-#{protocol.id}"}>
          <summary class="cursor-pointer p-4 flex flex-wrap items-center gap-2">
            <span class="font-semibold text-gray-900 dark:text-white">
              <%= protocol.name %>
            </span>
            <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-800 dark:bg-gray-900 dark:text-gray-200">
              <%= category(protocol.category) %>
            </span>
            <span class="protocol-trust rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-800 dark:bg-gray-900 dark:text-gray-200">
              <%= trust_label(protocol) %>
            </span>
            <span
              :if={protocol.has_covenant}
              class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-800 dark:bg-gray-900 dark:text-gray-200"
            >
              Enforced by covenant
            </span>
          </summary>
          <div class="px-4 pb-4 space-y-2 text-sm text-gray-700 dark:text-gray-300">
            <p>
              <%= protocol.description || "No description yet." %>
            </p>
            <p :if={trust_title(protocol)}>
              <%= trust_title(protocol) %>
            </p>
            <p
              :if={protocol.ownership_proof_txid}
              class="protocol-proof"
            >
              Proven by its
              <.link
                navigate={~p"/transactions/#{protocol.ownership_proof_txid}"}
                class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
              >
                useradd transaction
              </.link>.
              See its
              <.link
                navigate={~p"/bitcom/#{protocol.address}"}
                class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
              >
                Bitcom namespace
              </.link>.
            </p>
            <p class="font-mono text-xs break-all">
              <%= protocol.address %>
            </p>
            <p :if={protocol.author}>
              Author: <%= protocol.author %>
            </p>
            <pre
              :if={protocol.schema}
              class="overflow-x-auto rounded bg-gray-50 p-3 text-xs dark:bg-gray-900"
            ><%= Jason.encode!(protocol.schema, pretty: true) %></pre>
            <ul
              role="list"
              class="flex flex-wrap gap-x-4 gap-y-1"
            >
              <li :if={type = Bitblocks.TxTypes.for_protocol(protocol.name)}>
                <.link
                  navigate={~p"/types/#{type.id}"}
                  class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
                >
                  <%= type.title %>
                </.link>
              </li>
              <li :if={protocol.documentation_url}>
                <a
                  href={protocol.documentation_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
                >
                  Documentation
                </a>
              </li>
              <li :if={protocol.source_url}>
                <a
                  href={protocol.source_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
                >
                  Source code
                </a>
              </li>
              <li :if={protocol.example_txid}>
                <.link
                  navigate={~p"/transactions/#{protocol.example_txid}"}
                  class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 underline"
                >
                  Example transaction
                </.link>
              </li>
            </ul>
          </div>
        </details>
      </li>
    </ul>
  </section>
</div>
