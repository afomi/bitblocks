<div class="container mx-auto mb-4 ps-3">
  <div class="flex justify-between">
    <div class="w-full">

      <div class="flex items-center justify-between mb-4">
        <div>
          <h1 class="text-2xl">Listing Transactions</h1>
          <div class="text-gray-600 dark:text-gray-400">
            <%= if map_size(@filters) > 0 do %>
              <span class="text-indigo-600 dark:text-indigo-400">
                Filtered
              </span>
            <% end %>
          </div>
        </div>
        <button
          phx-click="toggle_filters"
          class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 mr-2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"
            />
          </svg>
          <%= if @show_filters, do: "Hide Filters", else: "Show Filters" %>
        </button>
      </div>

      <%= if @show_filters do %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 mb-6">
          <form
            phx-submit="apply_filters"
            class="space-y-4"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <label
                  for="block_hash"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                >
                  Block Hash
                </label>
                <input
                  type="text"
                  name="filters[block_hash]"
                  id="block_hash"
                  value={Map.get(@filters, :block_hash, "")}
                  placeholder="Enter block hash"
                  class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:text-white text-sm"
                />
              </div>

              <div>
                <label
                  for="txid_search"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                >
                  Search TXID
                </label>
                <input
                  type="text"
                  name="filters[txid_search]"
                  id="txid_search"
                  value={Map.get(@filters, :txid_search, "")}
                  placeholder="Search by TXID prefix"
                  class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:text-white text-sm"
                />
              </div>

              <div>
                <label
                  for="min_inputs"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                >
                  Min Inputs
                </label>
                <input
                  type="number"
                  name="filters[min_inputs]"
                  id="min_inputs"
                  value={Map.get(@filters, :min_inputs, "")}
                  placeholder="0"
                  min="0"
                  class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:text-white text-sm"
                />
              </div>

              <div>
                <label
                  for="min_outputs"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                >
                  Min Outputs
                </label>
                <input
                  type="number"
                  name="filters[min_outputs]"
                  id="min_outputs"
                  value={Map.get(@filters, :min_outputs, "")}
                  placeholder="0"
                  min="0"
                  class="block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:text-white text-sm"
                />
              </div>
            </div>

            <div class="flex gap-2">
              <button
                type="submit"
                class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              >
                Apply Filters
              </button>
              <button
                type="button"
                phx-click="clear_filters"
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                Clear Filters
              </button>
            </div>
          </form>
        </div>
      <% end %>

      <%= if @live_action in [:new, :edit] do %>
        <.modal
          id="transaction-modal"
          show
          on_cancel={JS.patch(~p"/transactions")}
        >
          <.live_component
            module={BitblocksWeb.TransactionLive.FormComponent}
            id={@transaction.id || :new}
            title={@page_title}
            action={@live_action}
            transaction={@transaction}
            return_to={~p"/transactions"}
          />
        </.modal>
      <% end %>

      <div class="container mx-auto p-4">
        <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-700">
          <thead>
            <tr>
              <th
                scope="col"
                class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-white sm:pl-0"
              >
                Block Height
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white"
              >
                TXID
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900 dark:text-white"
              >
                Inputs
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-center text-sm font-semibold text-gray-900 dark:text-white"
              >
                Outputs
              </th>
            </tr>
          </thead>
          <tbody>
            <%= for transaction <- @transactions do %>
              <tr id={"tx-#{transaction.id}"}>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-gray-300 sm:pl-0">
                  <%= if transaction.block_height do %>
                    <.link
                      navigate={~p"/blocks/#{transaction.block_height}"}
                      class="text-blue-600 dark:text-blue-400 hover:underline"
                    >
                      <%= transaction.block_height %>
                    </.link>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-blue-500 dark:text-blue-400 sm:pl-0 font-mono">
                  <.link navigate={~p"/transactions/#{transaction.txid}"}>
                    <%= transaction.txid %>
                  </.link>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-700 dark:text-gray-300 text-center">
                  <%= length(transaction.inputs || []) %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-700 dark:text-gray-300 text-center">
                  <%= length(transaction.outputs || []) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <!-- Cursor-based pagination -->
        <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 pt-4 mt-4">
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <%= if @cursor do %>
              Showing next <%= length(@transactions) %> results
            <% else %>
              Showing latest <%= length(@transactions) %> transactions
            <% end %>
          </div>
          <div class="flex gap-2">
            <%= if @cursor do %>
              <.link
                patch={~p"/transactions"}
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                ← Latest
              </.link>
            <% end %>
            <%= if @next_cursor do %>
              <.link
                patch={build_next_url(@next_cursor, @filters)}
                class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700"
              >
                Older →
              </.link>
            <% end %>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
