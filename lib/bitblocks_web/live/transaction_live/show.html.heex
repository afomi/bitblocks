<div class="container mx-auto px-4 py-8 max-w-6xl">
  <% {raw_hex, raw_bytes} = BitblocksWeb.TransactionLive.Show.raw_shown(@transaction.raw) %>
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2 text-gray-900 dark:text-white">
      Transaction
    </h1>

    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <%= if @block do %>
        <div class="flex items-center gap-2 text-sm">
          <span class="text-gray-600 dark:text-gray-400">
            Block:
          </span>
          <.link
            navigate={~p"/blocks/#{@block.height}"}
            class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 font-semibold font-mono tabular-nums"
          >
            <%= @block.height %>
          </.link>
          <span
            :if={@block.time}
            class="text-gray-600 dark:text-gray-400"
          >
            mined <%= DateTime.from_unix!(@block.time) |> Calendar.strftime("%Y-%m-%d %H:%M UTC") %>
          </span>
        </div>
      <% end %>

      <div
        :if={raw_bytes > 0}
        id="tx-raw-actions"
        class="ml-auto flex items-center gap-2"
      >
        <span
          id="tx-raw-bytes"
          class="font-mono text-xs tabular-nums text-gray-600 dark:text-gray-400"
        >
          <%= BitblocksWeb.Sats.delimit(raw_bytes) %> bytes
        </span>
        <%= if @current_user || @admin? do %>
          <a
            id="tx-raw-download-hex"
            href={Bitblocks.TxStore.hex_url(@transaction.txid)}
            download={"#{@transaction.txid}.hex"}
            class="rounded bg-blue-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-blue-700"
          >
            Hex
          </a>
          <a
            id="tx-raw-download"
            href={Bitblocks.TxStore.download_url(@transaction.txid)}
            download={"#{@transaction.txid}.bin"}
            class="rounded border border-gray-300 px-2 py-0.5 text-xs font-medium text-gray-800 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-700"
          >
            Binary
          </a>
        <% else %>
          <a
            id="tx-raw-sign-in"
            href={~p"/sign-in?#{[return_to: "/transactions/#{@transaction.txid}"]}"}
            class="text-xs font-medium text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
          >
            Sign in to download
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <%= if @live_action in [:edit] do %>
    <.modal
      id="transaction-edit-modal"
      show
      on_cancel={JS.patch(~p"/transactions/#{@transaction.txid}")}
    >
      <.live_component
        module={BitblocksWeb.TransactionLive.FormComponent}
        id={@transaction.id}
        title={@page_title}
        action={@live_action}
        transaction={@transaction}
        patch={~p"/transactions/#{@transaction.txid}"}
      />
    </.modal>
  <% end %>

  <%!-- What happened: the first thing on the page (BitblocksWeb.TxSummary) --%>
  <section
    id="tx-summary"
    aria-labelledby="tx-summary-heading"
    class="bg-white border border-gray-200 rounded-lg p-6 mb-6 dark:bg-gray-800 dark:border-gray-700"
  >
    <h2
      id="tx-summary-heading"
      class="sr-only"
    >
      What happened
    </h2>
    <%= case @tx_state do %>
      <% :not_downloaded -> %>
        <p
          id="tx-not-downloaded"
          class="text-gray-800 dark:text-gray-200"
        >
          This transaction is not downloaded yet.
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
          We know its ID, and the sync stores its contents when it reaches this block.
        </p>
      <% :undecodable -> %>
        <p
          id="tx-undecodable"
          class="text-gray-800 dark:text-gray-200"
        >
          This transaction could not be decoded.
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
          Its bytes are stored, and they are shown below as they are.
        </p>
      <% :decoded -> %>
        <blockquote
          :if={@coinbase_message}
          id="tx-miner-text"
          class="font-mono text-sm text-gray-900 dark:text-gray-100 break-words whitespace-pre-wrap bg-gray-50 dark:bg-gray-900 rounded p-4 mb-3"
        ><%= @coinbase_message.text %></blockquote>
        <p
          id="tx-headline"
          class="text-gray-800 dark:text-gray-200"
        >
          <%= BitblocksWeb.TxSummary.headline(@decoded_tx, @parsed_data && @parsed_data.total_output_satoshis, @block) %>
        </p>
    <% end %>
    <div
      :if={@protocol_links != []}
      id="tx-protocols"
      class="flex flex-wrap items-center gap-2 mt-3"
    >
      <span class="text-sm text-gray-600 dark:text-gray-400">
        Part of
      </span>
      <a
        :for={link <- @protocol_links}
        href={link.path}
        class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-blue-700 hover:text-blue-900 dark:bg-gray-700 dark:text-blue-300 dark:hover:text-blue-200"
      >
        <%= link.label %>
      </a>
    </div>
    <p
      :if={@has_b_file}
      class="mt-3 text-sm"
    >
      <a
        id="tx-b-file"
        href={~p"/b/#{@transaction.txid}"}
        class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
      >
        Open the file this transaction stores
      </a>
    </p>
  </section>

  <%!-- Transaction ID --%>
  <div class="bg-white shadow-md rounded-lg p-6 mb-6">
    <div class="flex items-center justify-between mb-1">
      <div class="text-sm text-gray-600">
        Transaction ID (TXID)
      </div>
      <a
        :if={@admin?}
        href={"/graph?txid=#{@transaction.txid}&depth=2"}
        class="text-xs text-blue-600 hover:underline font-semibold"
      >
        View Graph →
      </a>
    </div>
    <div class="font-mono text-sm break-all bg-gray-50 p-3 rounded">
      <%= @transaction.txid %>
    </div>
    <div class="text-xs text-gray-500 mt-2">
      A unique identifier (hash) for this transaction
    </div>
  </div>

  <%!-- Value: the tx pipeline's tallies and read-time facts (docs/TX_PIPELINE.md) --%>
  <section
    id="tx-value"
    class="bg-white border border-gray-200 rounded-lg p-6 mb-6 dark:bg-gray-800 dark:border-gray-700"
  >
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
        Value
      </h2>
      <div
        :if={@nft_facts}
        id="tx-badges"
        class="flex flex-wrap items-center gap-2"
      >
        <.link
          :if={@nft_facts.inscriptions != []}
          id="badge-inscription"
          navigate={~p"/types/1sat-inscription"}
          class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200"
        >
          NFT: inscription
        </.link>
        <.link
          :if={@nft_facts.run?}
          id="badge-run"
          navigate={~p"/types/run"}
          class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200"
        >
          NFT: Run jig
        </.link>
        <.link
          :for={membership <- Enum.uniq_by(@nft_facts.collections, & &1.slug)}
          id={"badge-collection-#{membership.slug}"}
          navigate={~p"/collections/#{membership.slug}"}
          class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-800 dark:bg-gray-700 dark:text-gray-200"
        >
          <%= membership.name %>
        </.link>
        <span
          :if={@output_status && @output_status.utxo?}
          id="badge-utxo"
          class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-900 dark:bg-green-900/40 dark:text-green-200"
        >
          Has unspent outputs
        </span>
      </div>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Sats in
        </dt>
        <dd
          id="tx-sats-in"
          class="font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          <%= BitblocksWeb.Sats.sats(@transaction.total_input_satoshis) %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Sats out
        </dt>
        <dd
          id="tx-sats-out"
          class="font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          <%= BitblocksWeb.Sats.sats(@transaction.total_output_satoshis) %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Fee to the miner
        </dt>
        <dd
          id="tx-fee"
          class="font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          <%= BitblocksWeb.Sats.sats(@transaction.fee_satoshis) %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Burned
        </dt>
        <dd
          id="tx-burned"
          class="font-semibold tabular-nums text-gray-900 dark:text-white"
        >
          <%= BitblocksWeb.Sats.sats(@transaction.burned_satoshis) %>
        </dd>
      </div>
    </dl>
    <p
      :if={is_nil(@transaction.total_input_satoshis)}
      class="text-xs text-gray-600 dark:text-gray-400 mb-4"
    >
      Sats in and the fee show once every input's previous transaction is indexed.
      We never guess them.
    </p>
    <%!-- Provenance: which pipeline version computed these (docs/DERIVED_DATA.md) --%>
    <p
      id="tx-provenance"
      class="text-xs text-gray-600 dark:text-gray-400 mb-4"
      title="The versions of the tx pipeline that computed this transaction's derived data. The date is when the tallies were last stamped."
    >
      <%= if @transaction.tallies_version do %>
        Tallies v<%= @transaction.tallies_version %> · computed <%= Calendar.strftime(@transaction.updated_at, "%Y-%m-%d") %>
      <% else %>
        Tallies: no version yet
      <% end %>
      ·
      <%= if @transaction.script_analysis_version do %>
        Script analysis v<%= @transaction.script_analysis_version %>
      <% else %>
        Script analysis: no version yet
      <% end %>
    </p>

    <div
      :if={@output_status}
      id="tx-output-status"
    >
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
        Outputs, spent or unspent
      </h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-600 dark:text-gray-400">
            <th class="py-1 pr-4 font-medium">
              Output
            </th>
            <th class="py-1 pr-4 font-medium text-right">
              Sats
            </th>
            <th class="py-1 pr-4 font-medium">
              To
            </th>
            <th class="py-1 font-medium">
              Status
            </th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={out <- Enum.take(@output_status.outputs, BitblocksWeb.TransactionLive.Show.status_rows())}
            id={"output-status-#{out.vout}"}
            class="border-t border-gray-200 dark:border-gray-700"
          >
            <td class="py-1 pr-4 font-mono text-gray-800 dark:text-gray-200">
              #<%= BitblocksWeb.Sats.delimit(out.vout) %>
            </td>
            <td class="py-1 pr-4 text-right tabular-nums text-gray-800 dark:text-gray-200">
              <%= BitblocksWeb.Sats.delimit(out.satoshis) %>
            </td>
            <td class="py-1 pr-4 font-mono text-xs break-all text-gray-800 dark:text-gray-200">
              <%= BitblocksWeb.TxSummary.paid_to(Map.get(@descriptors_by_vout, out.vout)) %>
            </td>
            <td class="py-1 text-gray-800 dark:text-gray-200">
              <%= case out.status do %>
                <% :spent -> %>
                  Spent by
                  <.link
                    navigate={~p"/transactions/#{out.spent_by}"}
                    class="font-mono text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                  >
                    <%= String.slice(out.spent_by, 0, 16) %>…
                  </.link>
                <% :unspent -> %>
                  Unspent (a UTXO)
                <% :unknown -> %>
                  Unknown (no settled spend; indexed through block <%= BitblocksWeb.Sats.delimit(@output_status.indexed_through_height) %>)
                <% :unspendable -> %>
                  Unspendable (data)
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
      <p
        :if={length(@output_status.outputs) > BitblocksWeb.TransactionLive.Show.status_rows()}
        class="text-xs text-gray-600 dark:text-gray-400 mt-2"
      >
        And <%= BitblocksWeb.Sats.delimit(length(@output_status.outputs) - BitblocksWeb.TransactionLive.Show.status_rows()) %> more outputs.
      </p>
      <p class="text-xs text-gray-600 dark:text-gray-400 mt-2">
        Unspent means no transaction we have indexed spends it yet.
      </p>
    </div>

    <div
      :if={match?(%BSV.Tx{}, @decoded_tx) and not BitblocksWeb.TxSummary.coinbase?(@decoded_tx)}
      id="tx-input-sources"
      class="mt-4"
    >
      <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
        Inputs, where the value came from
      </h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-600 dark:text-gray-400">
            <th class="py-1 pr-4 font-medium">
              Input
            </th>
            <th class="py-1 pr-4 font-medium text-right">
              Sats
            </th>
            <th class="py-1 font-medium">
              Spends
            </th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={{input, idx} <- @decoded_tx.inputs |> Enum.take(BitblocksWeb.TransactionLive.Show.status_rows()) |> Enum.with_index()}
            id={"input-source-#{idx}"}
            class="border-t border-gray-200 dark:border-gray-700"
          >
            <% input_txid = BSV.OutPoint.get_txid(input.outpoint) %>
            <td class="py-1 pr-4 font-mono text-gray-800 dark:text-gray-200">
              #<%= BitblocksWeb.Sats.delimit(idx) %>
            </td>
            <td class="py-1 pr-4 text-right tabular-nums text-gray-800 dark:text-gray-200">
              <%= case Map.get(@input_satoshis, {input_txid, input.outpoint.vout}) do %>
                <% nil -> %>
                  —
                <% sats -> %>
                  <%= BitblocksWeb.Sats.delimit(sats) %>
              <% end %>
            </td>
            <td class="py-1 text-gray-800 dark:text-gray-200">
              <.link
                navigate={~p"/transactions/#{input_txid}"}
                class="font-mono text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
              >
                <%= String.slice(input_txid, 0, 16) %>…
              </.link>
              output #<%= BitblocksWeb.Sats.delimit(input.outpoint.vout) %>
            </td>
          </tr>
        </tbody>
      </table>
      <p
        :if={length(@decoded_tx.inputs) > BitblocksWeb.TransactionLive.Show.status_rows()}
        class="text-xs text-gray-600 dark:text-gray-400 mt-2"
      >
        And <%= BitblocksWeb.Sats.delimit(length(@decoded_tx.inputs) - BitblocksWeb.TransactionLive.Show.status_rows()) %> more inputs.
      </p>
    </div>
  </section>

  <%!-- Collection Item Banner --%>
  <%= if @collection_item && @collection_module do %>
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 border border-pink-200 rounded-lg p-5 mb-6">
      <div class="flex items-center gap-5">
        <img
          src={@collection_module.image_path(@collection_item)}
          alt={@collection_module.item_title(@collection_item)}
          class="w-24 h-24 rounded-lg shadow-md object-cover"
        />
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 bg-pink-200 text-pink-800 rounded-full text-xs font-bold">
              <%= String.upcase(@collection_module.name()) %> NFT
            </span>
          </div>
          <h3 class="text-xl font-bold text-gray-900">
            <%= @collection_module.item_title(@collection_item) %>
          </h3>
          <div
            :if={@collection_holding}
            id="collection-claims"
            class="mt-1 text-sm text-gray-700 break-all"
          >
            <p>
              Membership verified.
            </p>
            <p>
              <%= Bitblocks.OrdinalCollections.ownership_sentence(@collection_holding) %>
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-2">
            <%= for type <- @collection_module.trait_types() do %>
              <%= if @collection_item[type] do %>
                <span class="px-2 py-0.5 bg-white/80 border border-pink-200 rounded text-xs text-gray-700">
                  <span class="text-gray-400"><%= type %>:</span> <%= @collection_item[type] %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="flex-shrink-0">
          <.link
            navigate={"/collections/#{@collection_slug}"}
            class="px-4 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 text-sm font-semibold"
          >
            View Collection
          </.link>
        </div>
      </div>
    </div>
  <% end %>

  <%= if match?(%BSV.Tx{}, @decoded_tx) do %>
    <% tx = @decoded_tx %>
    <%!-- Transaction Details --%>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-4">
        Details
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-sm text-gray-600">
            Flow
          </div>
          <div class="font-semibold tabular-nums">
            <%= length(tx.inputs) %> → <%= length(tx.outputs) %>
          </div>
          <div class="text-xs text-gray-400">
            inputs → outputs
          </div>
        </div>

        <%= if @parsed_data do %>
          <div>
            <div class="text-sm text-gray-600">
              Total Output
            </div>
            <div class="font-semibold">
              <%= format_satoshis(@parsed_data.total_output_satoshis) %>
            </div>
          </div>
        <% end %>

        <div>
          <div class="text-sm text-gray-600">
            Lock Time
          </div>
          <%= if tx.lock_time > 0 do %>
            <div class="font-semibold tabular-nums">
              <%= tx.lock_time %>
            </div>
            <div class="text-xs text-gray-400">
              <%= if tx.lock_time < 500_000_000, do: "spendable after block #{tx.lock_time}", else: "spendable after unix time #{tx.lock_time}" %>
            </div>
          <% else %>
            <div class="font-semibold tabular-nums text-gray-400">
              0
            </div>
            <div class="text-xs text-gray-400">
              no lock
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Script type breakdown --%>
      <div>
        <div class="text-sm text-gray-600 mb-2">
          Output types
        </div>
        <div class="flex flex-wrap gap-2">
          <%= for {type, count} <- BitblocksWeb.TransactionLive.Show.script_type_summary(tx.outputs) do %>
            <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs font-mono rounded">
              <%= BitblocksWeb.TransactionLive.Show.output_type_label(type) %> × <%= count %>
            </span>
          <% end %>
        </div>
      </div>
    </div>

  <% end %>

  <%!-- Scripts and hex: one toggle, open to start --%>
  <details
    :if={@tx_state != :not_downloaded}
    id="tx-raw-details"
    class="mb-6"
    open
  >
    <summary class="cursor-pointer text-sm font-semibold text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 mb-4">
      Raw transaction
    </summary>

    <div
      :if={@coinbase_message}
      id="tx-coinbase-hex"
      class="bg-white shadow-md rounded-lg p-6 mb-6"
    >
      <h2 class="text-base font-semibold mb-2">
        Coinbase scriptSig
      </h2>
      <p class="font-mono text-xs text-gray-600 break-all">
        <%= @coinbase_message.hex %>
      </p>
    </div>

    <%= if match?(%BSV.Tx{}, @decoded_tx) do %>
    <% tx = @decoded_tx %>
    <%!-- Inputs on the left, outputs on the right, from the lg breakpoint --%>
    <div
      id="tx-inputs-outputs"
      class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6 items-start"
    >
      <section
        id="tx-inputs"
        class="min-w-0 bg-white shadow-md rounded-lg p-4"
      >
        <div class="flex items-baseline justify-between mb-2">
          <h2 class="text-base font-semibold">
            Inputs (<%= length(tx.inputs) %>)
          </h2>
          <div class="text-xs text-gray-500">
            Where the value comes from
          </div>
        </div>

        <div class="divide-y divide-gray-200">
          <%= for {input, idx} <- Enum.with_index(tx.inputs) do %>
            <% input_txid = BSV.OutPoint.get_txid(input.outpoint) %>
            <% input_sats = Map.get(@input_satoshis, {input_txid, input.outpoint.vout}) %>
            <div class="py-2 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-center justify-between gap-x-2 mb-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-semibold text-gray-700">
                    Input #<%= idx %>
                  </span>
                  <%= if input.script.coinbase do %>
                    <span class="px-1.5 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded">
                      Coinbase
                    </span>
                  <% end %>
                </div>
                <%= if input_sats do %>
                  <span class="font-mono text-xs font-semibold text-blue-800">
                    <%= format_satoshis(input_sats) %>
                  </span>
                <% end %>
              </div>

              <BitblocksWeb.ScriptComponents.script_field
                label="Spends:"
                title="The previous output this input spends"
              >
                <.link
                  navigate={~p"/transactions/#{input_txid}"}
                  class="text-blue-600 hover:underline"
                >
                  <%= input_txid %>
                </.link>:<%= input.outpoint.vout %>
              </BitblocksWeb.ScriptComponents.script_field>

              <BitblocksWeb.ScriptComponents.script_field
                label="ScriptSig:"
                title="Unlocking script: proves ownership and authorizes spending the output"
              >
                <%= BSV.Script.to_asm(input.script) |> String.slice(0, 100) %><%= if String.length(BSV.Script.to_asm(input.script)) > 100, do: "..." %>
              </BitblocksWeb.ScriptComponents.script_field>

              <BitblocksWeb.ScriptComponents.script_field label="Sequence:">
                <%= input.sequence %>
              </BitblocksWeb.ScriptComponents.script_field>
            </div>
          <% end %>
        </div>
      </section>

      <section
        id="tx-outputs"
        class="min-w-0 bg-white shadow-md rounded-lg p-4"
      >
        <div class="flex items-baseline justify-between mb-2">
          <h2 class="text-base font-semibold">
            Outputs (<%= length(tx.outputs) %>)
          </h2>
          <a
            href="/guide#scripts"
            class="text-xs text-gray-500 hover:text-blue-500 transition-colors"
          >
            What is a locking script? →
          </a>
        </div>

        <div class="divide-y divide-gray-200">
          <%= for descriptor <- @output_descriptors do %>
            <BitblocksWeb.ScriptComponents.script_card
              descriptor={descriptor}
              template={Map.get(@script_templates, descriptor.template_hash)}
              protocols={Map.get(@output_protocols, descriptor.vout, [])}
              txid={@transaction.txid}
            />
          <% end %>
        </div>
      </section>
    </div>
    <% end %>

  <%!-- OP_RETURN Data (if present) --%>
  <%= if @parsed_data && length(@parsed_data.op_returns) > 0 do %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-4">
        OP_RETURN Data (<%= length(@parsed_data.op_returns) %>)
      </h2>

      <%!-- Detected Protocols --%>
      <%= if @parsed_data.protocols && length(@parsed_data.protocols) > 0 do %>
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">
            Detected Protocols
          </h3>
          <div class="flex flex-wrap gap-2">
            <%= for protocol <- @parsed_data.protocols do %>
              <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-semibold">
                <%= protocol %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%!-- BCat Protocol Info --%>
      <%= case BitblocksWeb.TransactionLive.Show.bcat_info(@parsed_data) do %>
        <% {:head, bcat} -> %>
          <div class="mb-6 border border-blue-200 bg-blue-50 rounded-lg p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-blue-600 text-white rounded text-xs font-bold">
                BCat head
              </span>
              <%= if bcat.mime_type do %>
                <span class="text-sm text-blue-800 font-mono">
                  <%= bcat.mime_type %>
                </span>
              <% end %>
              <%= if bcat.filename do %>
                <span class="text-sm text-blue-700">
                  <%= bcat.filename %>
                </span>
              <% end %>
            </div>
            <div class="text-sm text-blue-900 mb-3">
              This is a BCat head transaction.
              The full file is assembled by concatenating the chunks below in order.
            </div>
            <div
              :if={bcat.chunk_txids != []}
              class="mb-3 flex gap-4 text-sm"
            >
              <a
                id="bcat-open"
                href={~p"/content/bcat/#{@transaction.txid}"}
                class="text-blue-600 hover:underline"
              >
                Reassemble and open
              </a>
              <a
                id="bcat-download"
                href={~p"/content/bcat/#{@transaction.txid}?download=1"}
                class="text-blue-600 hover:underline"
              >
                Download
              </a>
            </div>
            <%= if length(bcat.chunk_txids) > 0 do %>
              <div>
                <div class="text-xs font-semibold text-blue-700 mb-2">
                  Chunk transactions (<%= length(bcat.chunk_txids) %>):
                </div>
                <ol class="space-y-1 list-decimal list-inside">
                  <%= for txid <- bcat.chunk_txids do %>
                    <li class="font-mono text-xs">
                      <.link
                        navigate={~p"/transactions/#{txid}"}
                        class="text-blue-600 hover:underline break-all"
                      >
                        <%= txid %>
                      </.link>
                    </li>
                  <% end %>
                </ol>
              </div>
            <% else %>
              <div class="text-xs text-blue-500 italic">
                No chunk txids detected (may be stored as non-32-byte pushes).
              </div>
            <% end %>
          </div>
        <% {:chunk} -> %>
          <div class="mb-6 border border-gray-300 bg-gray-50 rounded-lg p-4">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-gray-500 text-white rounded text-xs font-bold">
                BCat chunk
              </span>
              <span class="text-sm text-gray-600">
                This transaction carries a data chunk assembled by a BCat head transaction.
              </span>
            </div>
          </div>
        <% _ -> %>
      <% end %>

      <%!-- OP_RETURN Outputs with Detailed Chunk Breakdown --%>
      <div class="space-y-6">
        <%= for {op_return, idx} <- Enum.with_index(@parsed_data.op_returns) do %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-gray-700">
                OP_RETURN #<%= idx %> (Output <%= op_return.output_index %>)
              </span>
              <span class="text-xs text-gray-500">
                <%= op_return.satoshis %> satoshis
              </span>
            </div>

            <%!-- Data Chunks --%>
            <div class="space-y-3">
              <%= for {chunk, chunk_idx} <- Enum.with_index(op_return.data) do %>
                <div class="bg-gray-50 rounded p-3">
                  <div class="text-xs font-semibold text-gray-600 mb-2">
                    Chunk <%= chunk_idx + 1 %>
                    <%= if chunk.type == :push_data do %>
                      (<%= chunk.length %> bytes)
                    <% else %>
                      (Opcode)
                    <% end %>
                  </div>

                  <%= if chunk.type == :push_data do %>
                    <%!-- Hex Data --%>
                    <div class="mb-2">
                      <div class="text-xs text-gray-500 mb-1">
                        Hex:
                      </div>
                      <div class="font-mono text-xs break-all bg-white p-2 rounded border">
                        <%= chunk.hex %>
                      </div>
                    </div>

                    <%!-- UTF-8 Data --%>
                    <%= if chunk.utf8 do %>
                      <div>
                        <div class="text-xs text-gray-500 mb-1">
                          UTF-8:
                        </div>
                        <div class="font-mono text-xs break-all bg-white p-2 rounded border">
                          <%= chunk.utf8 %>
                        </div>
                      </div>
                    <% else %>
                      <div class="text-xs text-gray-400 italic">
                        (Not valid UTF-8 text)
                      </div>
                    <% end %>
                  <% else %>
                    <%!-- Opcode --%>
                    <div class="text-xs">
                      <span class="font-mono bg-yellow-100 px-2 py-1 rounded">
                        <%= chunk.name %>
                      </span>
                      <span class="text-gray-500 ml-2">
                        (opcode: <%= chunk.opcode %>)
                      </span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%!-- Raw Script ASM --%>
            <div class="mt-4 pt-4 border-t">
              <div class="text-xs text-gray-500 mb-1">
                Raw Script (ASM):
              </div>
              <div class="font-mono text-xs break-all bg-gray-50 p-2 rounded">
                <%= op_return.raw_script %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%!-- Raw Transaction --%>
  <div
    id="tx-raw"
    class="bg-white shadow-md rounded-lg p-6"
  >
    <h2 class="text-xl font-semibold mb-4">
      Raw Transaction
    </h2>

    <div
      :if={raw_hex}
      class="font-mono text-xs bg-gray-50 p-4 rounded break-all max-h-48 overflow-y-auto"
    >
      <%= raw_hex %>
    </div>
    <p
      :if={is_nil(raw_hex) and raw_bytes > 0}
      id="tx-raw-size"
      class="text-sm text-gray-700"
    >
      <%= BitblocksWeb.Sats.delimit(raw_bytes) %> bytes is too long to show here, so it's a download at the top of the page.
    </p>
  </div>
  </details>
</div>
