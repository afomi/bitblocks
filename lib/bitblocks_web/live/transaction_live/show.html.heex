<div class="container mx-auto px-4 py-8 max-w-6xl">
  <div class="mb-6">
    <h1 class="text-3xl font-bold mb-2">
      Transaction
    </h1>

    <%= if @block do %>
      <div class="flex items-center gap-2 text-sm">
        <span class="text-gray-600">
          Block:
        </span>
        <.link
          navigate={~p"/blocks/#{@block.height}"}
          class="text-blue-600 hover:underline font-semibold"
        >
          <%= @block.height %>
        </.link>
      </div>
    <% end %>
  </div>

  <%= if @live_action in [:edit] do %>
    <.modal
      id="transaction-edit-modal"
      show
      on_cancel={JS.patch(~p"/transactions/#{@transaction.txid}")}
    >
      <.live_component
        module={BitblocksWeb.TransactionLive.FormComponent}
        id={@transaction.id}
        title={@page_title}
        action={@live_action}
        transaction={@transaction}
        patch={~p"/transactions/#{@transaction.txid}"}
      />
    </.modal>
  <% end %>

  <%!-- What is a Transaction? --%>
  <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg
          class="h-5 w-5 text-blue-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm text-blue-700">
          <strong>What is a Transaction?</strong> A transaction is a transfer of Bitcoin value from one or more inputs (previous outputs being spent) to one or more outputs (new recipients). Transactions are grouped into blocks and recorded permanently on the blockchain.
        </p>
      </div>
    </div>
  </div>

  <%!-- Transaction ID --%>
  <div class="bg-white shadow-md rounded-lg p-6 mb-6">
    <div class="flex items-center justify-between mb-1">
      <div class="text-sm text-gray-600">
        Transaction ID (TXID)
      </div>
      <a
        href={"/graph?txid=#{@transaction.txid}&depth=2"}
        class="text-xs text-blue-600 hover:underline font-semibold"
      >
        View Graph →
      </a>
    </div>
    <div class="font-mono text-sm break-all bg-gray-50 p-3 rounded">
      <%= @transaction.txid %>
    </div>
    <div class="text-xs text-gray-500 mt-2">
      A unique identifier (hash) for this transaction
    </div>
  </div>

  <%!-- Collection Item Banner --%>
  <%= if @collection_item && @collection_module do %>
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 border border-pink-200 rounded-lg p-5 mb-6">
      <div class="flex items-center gap-5">
        <img
          src={@collection_module.image_path(@collection_item)}
          alt={@collection_module.item_title(@collection_item)}
          class="w-24 h-24 rounded-lg shadow-md object-cover"
        />
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 bg-pink-200 text-pink-800 rounded-full text-xs font-bold">
              <%= String.upcase(@collection_module.name()) %> NFT
            </span>
          </div>
          <h3 class="text-xl font-bold text-gray-900">
            <%= @collection_module.item_title(@collection_item) %>
          </h3>
          <div class="flex flex-wrap gap-1.5 mt-2">
            <%= for type <- @collection_module.trait_types() do %>
              <%= if @collection_item[type] do %>
                <span class="px-2 py-0.5 bg-white/80 border border-pink-200 rounded text-xs text-gray-700">
                  <span class="text-gray-400"><%= type %>:</span> <%= @collection_item[type] %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="flex-shrink-0">
          <.link
            navigate={"/collections/#{@collection_slug}"}
            class="px-4 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 text-sm font-semibold"
          >
            View Collection
          </.link>
        </div>
      </div>
    </div>
  <% end %>

  <%= if match?(%BSV.Tx{}, @decoded_tx) do %>
    <% tx = @decoded_tx %>
    <%!-- Transaction Details --%>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-4">
        Details
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4">
        <div>
          <div class="text-sm text-gray-600">
            Flow
          </div>
          <div class="font-semibold tabular-nums">
            <%= length(tx.inputs) %> → <%= length(tx.outputs) %>
          </div>
          <div class="text-xs text-gray-400">
            inputs → outputs
          </div>
        </div>

        <%= if @parsed_data do %>
          <div>
            <div class="text-sm text-gray-600">
              Total Output
            </div>
            <div class="font-semibold">
              <%= format_satoshis(@parsed_data.total_output_satoshis) %>
            </div>
          </div>
        <% end %>

        <div>
          <div class="text-sm text-gray-600">
            Lock Time
          </div>
          <%= if tx.lock_time > 0 do %>
            <div class="font-semibold tabular-nums">
              <%= tx.lock_time %>
            </div>
            <div class="text-xs text-gray-400">
              <%= if tx.lock_time < 500_000_000, do: "spendable after block #{tx.lock_time}", else: "spendable after unix time #{tx.lock_time}" %>
            </div>
          <% else %>
            <div class="font-semibold tabular-nums text-gray-400">
              0
            </div>
            <div class="text-xs text-gray-400">
              no lock
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Script type breakdown --%>
      <div>
        <div class="text-sm text-gray-600 mb-2">
          Output types
        </div>
        <div class="flex flex-wrap gap-2">
          <%= for {type, count} <- BitblocksWeb.TransactionLive.Show.script_type_summary(tx.outputs) do %>
            <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs font-mono rounded">
              <%= BitblocksWeb.TransactionLive.Show.output_type_label(type) %> × <%= count %>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Coinbase message (miner scriptSig text; e.g. genesis "...Chancellor...") --%>
    <%= if @coinbase_message do %>
      <div class="bg-white shadow-md rounded-lg p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold">
            Coinbase message
          </h2>
          <div class="text-xs text-gray-500">
            Arbitrary text the miner embedded in the coinbase input
          </div>
        </div>
        <p class="font-mono text-sm text-gray-900 break-words whitespace-pre-wrap bg-gray-50 rounded p-4 border border-gray-200">
          <%= @coinbase_message.text %>
        </p>
        <details class="mt-3">
          <summary class="text-xs text-gray-500 cursor-pointer">
            Raw scriptSig hex
          </summary>
          <p class="font-mono text-xs text-gray-500 break-all mt-2">
            <%= @coinbase_message.hex %>
          </p>
        </details>
      </div>
    <% end %>

    <%!-- Inputs --%>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold">
          Inputs (<%= length(tx.inputs) %>)
        </h2>
        <div class="text-xs text-gray-500">
          Where the value comes from
        </div>
      </div>

      <div class="space-y-4">
        <%= for {input, idx} <- Enum.with_index(tx.inputs) do %>
          <% input_txid = BSV.OutPoint.get_txid(input.outpoint) %>
          <% input_sats = Map.get(@input_satoshis, {input_txid, input.outpoint.vout}) %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-gray-700">
                Input #<%= idx %>
              </span>
              <div class="flex items-center gap-2">
                <%= if input_sats do %>
                  <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-semibold rounded">
                    <%= format_satoshis(input_sats) %>
                  </span>
                <% end %>
                <%= if input.script.coinbase do %>
                  <span class="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded">
                    Coinbase
                  </span>
                <% end %>
              </div>
            </div>

            <div class="space-y-2 text-sm">
              <div>
                <span class="text-gray-600">
                  Previous Output (UTXO being spent):
                </span>
                <div class="font-mono text-xs bg-gray-50 p-2 rounded mt-1 break-all">
                  <.link
                    navigate={~p"/transactions/#{input_txid}"}
                    class="text-blue-600 hover:underline"
                  >
                    <%= input_txid %>
                  </.link>:<%= input.outpoint.vout %>
                </div>
                <div class="text-xs text-gray-400 mt-1">
                  References output #<%= input.outpoint.vout %> from a previous transaction
                </div>
              </div>

              <div>
                <span class="text-gray-600">
                  Unlocking Script (ScriptSig):
                </span>
                <div class="font-mono text-xs bg-gray-50 p-2 rounded mt-1 break-all">
                  <%= BSV.Script.to_asm(input.script) |> String.slice(0, 100) %><%= if String.length(BSV.Script.to_asm(input.script)) > 100, do: "..." %>
                </div>
                <div class="text-xs text-gray-400 mt-1">
                  Proves ownership and authorizes spending of the UTXO
                </div>
              </div>

              <div>
                <span class="text-gray-600">
                  Sequence:
                </span>
                <span class="font-mono text-xs">
                  <%= input.sequence %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Outputs --%>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold">
          Outputs (<%= length(tx.outputs) %>)
        </h2>
        <a
          href="/guide#scripts"
          class="text-xs text-gray-400 hover:text-blue-500 transition-colors"
        >
          What is a locking script? →
        </a>
      </div>

      <div class="space-y-4">
        <%= for {output, idx} <- Enum.with_index(tx.outputs) do %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-gray-700">
                Output #<%= idx %>
              </span>
              <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-semibold rounded">
                <%= format_satoshis(output.satoshis) %>
              </span>
            </div>

            <div class="space-y-2 text-sm">
              <div>
                <span class="text-gray-600">
                  Locking Script (ScriptPubKey):
                </span>
                <div class="font-mono text-xs bg-gray-50 p-2 rounded mt-1 break-all">
                  <%= BSV.Script.to_asm(output.script) |> String.slice(0, 100) %><%= if String.length(BSV.Script.to_asm(output.script)) > 100, do: "..." %>
                </div>
              </div>
              <div class="font-mono text-xs text-gray-400">
                <%= @transaction.txid %>_<%= idx %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <p class="text-yellow-800 text-sm">
        Raw transaction data could not be decoded. This may happen if the transaction record is incomplete or contains placeholder data.
      </p>
    </div>
  <% end %>

  <%!-- OP_RETURN Data (if present) --%>
  <%= if @parsed_data && length(@parsed_data.op_returns) > 0 do %>
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-4">
        OP_RETURN Data (<%= length(@parsed_data.op_returns) %>)
      </h2>

      <%!-- Detected Protocols --%>
      <%= if @parsed_data.protocols && length(@parsed_data.protocols) > 0 do %>
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">
            Detected Protocols
          </h3>
          <div class="flex flex-wrap gap-2">
            <%= for protocol <- @parsed_data.protocols do %>
              <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-semibold">
                <%= protocol %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%!-- BCat Protocol Info --%>
      <%= case BitblocksWeb.TransactionLive.Show.bcat_info(@parsed_data) do %>
        <% {:head, bcat} -> %>
          <div class="mb-6 border border-blue-200 bg-blue-50 rounded-lg p-4">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-blue-600 text-white rounded text-xs font-bold">
                BCat head
              </span>
              <%= if bcat.mime_type do %>
                <span class="text-sm text-blue-800 font-mono">
                  <%= bcat.mime_type %>
                </span>
              <% end %>
              <%= if bcat.filename do %>
                <span class="text-sm text-blue-700">
                  <%= bcat.filename %>
                </span>
              <% end %>
            </div>
            <div class="text-sm text-blue-900 mb-3">
              This is a BCat head transaction.
              The full file is assembled by concatenating the chunks below in order.
            </div>
            <%= if length(bcat.chunk_txids) > 0 do %>
              <div>
                <div class="text-xs font-semibold text-blue-700 mb-2">
                  Chunk transactions (<%= length(bcat.chunk_txids) %>):
                </div>
                <ol class="space-y-1 list-decimal list-inside">
                  <%= for txid <- bcat.chunk_txids do %>
                    <li class="font-mono text-xs">
                      <.link
                        navigate={~p"/transactions/#{txid}"}
                        class="text-blue-600 hover:underline break-all"
                      >
                        <%= txid %>
                      </.link>
                    </li>
                  <% end %>
                </ol>
              </div>
            <% else %>
              <div class="text-xs text-blue-500 italic">
                No chunk txids detected (may be stored as non-32-byte pushes).
              </div>
            <% end %>
          </div>
        <% {:chunk} -> %>
          <div class="mb-6 border border-gray-300 bg-gray-50 rounded-lg p-4">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-gray-500 text-white rounded text-xs font-bold">
                BCat chunk
              </span>
              <span class="text-sm text-gray-600">
                This transaction carries a data chunk assembled by a BCat head transaction.
              </span>
            </div>
          </div>
        <% _ -> %>
      <% end %>

      <%!-- OP_RETURN Outputs with Detailed Chunk Breakdown --%>
      <div class="space-y-6">
        <%= for {op_return, idx} <- Enum.with_index(@parsed_data.op_returns) do %>
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-gray-700">
                OP_RETURN #<%= idx %> (Output <%= op_return.output_index %>)
              </span>
              <span class="text-xs text-gray-500">
                <%= op_return.satoshis %> satoshis
              </span>
            </div>

            <%!-- Data Chunks --%>
            <div class="space-y-3">
              <%= for {chunk, chunk_idx} <- Enum.with_index(op_return.data) do %>
                <div class="bg-gray-50 rounded p-3">
                  <div class="text-xs font-semibold text-gray-600 mb-2">
                    Chunk <%= chunk_idx + 1 %>
                    <%= if chunk.type == :push_data do %>
                      (<%= chunk.length %> bytes)
                    <% else %>
                      (Opcode)
                    <% end %>
                  </div>

                  <%= if chunk.type == :push_data do %>
                    <%!-- Hex Data --%>
                    <div class="mb-2">
                      <div class="text-xs text-gray-500 mb-1">
                        Hex:
                      </div>
                      <div class="font-mono text-xs break-all bg-white p-2 rounded border">
                        <%= chunk.hex %>
                      </div>
                    </div>

                    <%!-- UTF-8 Data --%>
                    <%= if chunk.utf8 do %>
                      <div>
                        <div class="text-xs text-gray-500 mb-1">
                          UTF-8:
                        </div>
                        <div class="font-mono text-xs break-all bg-white p-2 rounded border">
                          <%= chunk.utf8 %>
                        </div>
                      </div>
                    <% else %>
                      <div class="text-xs text-gray-400 italic">
                        (Not valid UTF-8 text)
                      </div>
                    <% end %>
                  <% else %>
                    <%!-- Opcode --%>
                    <div class="text-xs">
                      <span class="font-mono bg-yellow-100 px-2 py-1 rounded">
                        <%= chunk.name %>
                      </span>
                      <span class="text-gray-500 ml-2">
                        (opcode: <%= chunk.opcode %>)
                      </span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%!-- Raw Script ASM --%>
            <div class="mt-4 pt-4 border-t">
              <div class="text-xs text-gray-500 mb-1">
                Raw Script (ASM):
              </div>
              <div class="font-mono text-xs break-all bg-gray-50 p-2 rounded">
                <%= op_return.raw_script %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%!-- Raw Transaction --%>
  <div class="bg-white shadow-md rounded-lg p-6">
    <h2 class="text-xl font-semibold mb-4">
      Raw Transaction
    </h2>

    <div class="font-mono text-xs bg-gray-50 p-4 rounded break-all max-h-48 overflow-y-auto">
      <%= @transaction.raw %>
    </div>
  </div>
</div>
