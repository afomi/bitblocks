<%!-- Site-style chrome around a three.js scene: only #chain-scrubber is dark (see DESIGN.md). --%>
<div
  class="fixed inset-0 flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100"
>
  <header
    class="flex flex-wrap items-center gap-4 px-4 py-2 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10"
  >
    <a
      href="/admin"
      class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
    >
      &larr; Admin
    </a>
    <h1
      class="text-lg font-semibold text-gray-900 dark:text-white"
    >
      Chain scrubber
    </h1>
    <p
      class="text-xs text-gray-600 dark:text-gray-400"
    >
      Height is the axis.
      Columns are log10 of tx count.
      A block that is not completed draws red, as a gap.
    </p>

    <form
      phx-submit="jump"
      class="ml-auto flex items-center gap-2"
    >
      <label
        for="chain-scrubber-jump"
        class="text-xs text-gray-600 dark:text-gray-400"
      >
        Jump to height
      </label>
      <input
        id="chain-scrubber-jump"
        type="text"
        name="height"
        inputmode="numeric"
        value={@height}
        class="w-28 px-2 py-1 text-sm bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
      />
      <button
        type="submit"
        class="px-3 py-1 text-sm rounded bg-amber-700 text-white hover:bg-amber-800"
      >
        Go
      </button>
      <span
        :if={@jump_error}
        id="chain-scrubber-jump-error"
        role="alert"
        class="text-xs text-red-700 dark:text-red-400"
      >
        {@jump_error}
      </span>
    </form>
  </header>

  <div
    :if={!@built?}
    id="chain-scrubber-not-built"
    class="px-4 py-3 bg-amber-50 border-b border-amber-200 text-amber-900 text-sm dark:bg-amber-900/30 dark:border-amber-800 dark:text-amber-200"
  >
    Tiles are not built yet.
    Run <code>bin/bitblocks rpc 'Bitblocks.Release.build_chain_tiles()'</code> once; the cron keeps them current after that.
  </div>

  <div
    id="chain-scrubber"
    phx-hook="ChainScrubber"
    phx-update="ignore"
    data-manifest-url="/chain-scrubber/tiles/manifest"
    data-tile-base="/chain-scrubber/tiles"
    data-tip-height={@tip_height}
    data-height={@height}
    data-view-from={@view_from}
    data-view-to={@view_to}
    class="relative flex-1 min-h-0 bg-[#050608]"
  >
    <%!-- Dark in both modes, matching COLORS.background in assets/js/hooks/chain_scrubber.js --%>
    <canvas
      id="chain-scrubber-canvas"
      class="block w-full h-full"
    >
    </canvas>

    <div
      id="chain-scrubber-readout"
      aria-live="polite"
      class="absolute top-2 left-4 right-4 w-fit flex flex-wrap gap-x-4 gap-y-1 px-2 py-1 rounded border border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-800/95 text-xs font-mono text-gray-800 dark:text-gray-200 shadow-sm pointer-events-none"
    >
      <span
        data-readout="height"
      >
      </span>
      <span
        data-readout="time"
      >
      </span>
      <span
        data-readout="size"
      >
      </span>
      <span
        data-readout="num_tx"
      >
      </span>
      <span
        data-readout="state"
      >
      </span>
      <span
        data-readout="level"
      >
      </span>
      <span
        data-readout="status"
      >
      </span>
    </div>

    <%!-- What the diamonds are: colours match COLORS and EVENT_COLORS in the hook. --%>
    <ul
      id="chain-scrubber-legend"
      aria-label="Marker colours"
      class="absolute top-2 right-4 flex flex-wrap justify-end gap-x-3 gap-y-1 max-w-sm px-2 py-1 rounded border border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-800/95 text-xs text-gray-800 dark:text-gray-200 shadow-sm pointer-events-none"
    >
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-violet-500"
          aria-hidden="true"
        >
        </span>
        reorg
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-red-500"
          aria-hidden="true"
        >
        </span>
        loss
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-violet-400"
          aria-hidden="true"
        >
        </span>
        fork
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-sky-400"
          aria-hidden="true"
        >
        </span>
        upgrade
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-amber-400"
          aria-hidden="true"
        >
        </span>
        halving
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-emerald-400"
          aria-hidden="true"
        >
        </span>
        milestone
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-pink-400"
          aria-hidden="true"
        >
        </span>
        mint
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-gray-200"
          aria-hidden="true"
        >
        </span>
        world
      </li>
      <li class="flex items-center gap-1">
        <span
          class="inline-block h-2 w-2 rotate-45 bg-blue-400"
          aria-hidden="true"
        >
        </span>
        note
      </li>
    </ul>

    <div
      id="chain-scrubber-marker-tip"
      role="tooltip"
      class="pointer-events-none absolute z-10 max-w-xs space-y-0.5 rounded-lg border border-gray-200 bg-white/95 px-3 py-2 text-xs text-gray-700 shadow empty:hidden dark:border-gray-700 dark:bg-gray-800/95 dark:text-gray-300"
    ></div>

    <div
      id="chain-scrubber-detail"
      class="absolute bottom-16 left-4 right-4 max-h-64 overflow-auto p-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-800/95 text-xs text-gray-800 dark:text-gray-200 shadow-sm empty:hidden"
    ></div>

    <div
      id="chain-scrubber-controls"
      class="absolute bottom-2 left-4 right-4 flex items-center gap-2 px-2 py-1 rounded-lg border border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-800/95 shadow-sm"
    >
      <button
        type="button"
        data-scrubber-action="step-back"
        aria-label="Step back one block"
        class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
      >
        &larr;
      </button>
      <button
        type="button"
        data-scrubber-action="play"
        aria-label="Play"
        class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
      >
        Play
      </button>
      <button
        type="button"
        data-scrubber-action="pause"
        aria-label="Pause"
        class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
      >
        Pause
      </button>
      <button
        type="button"
        data-scrubber-action="step-forward"
        aria-label="Step forward one block"
        class="px-2 py-1 text-sm rounded bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600"
      >
        &rarr;
      </button>
      <input
        type="range"
        id="chain-scrubber-range"
        min="0"
        max={@tip_height}
        step="1"
        value={@height}
        aria-label="Block height"
        class="flex-1 accent-amber-700 dark:accent-amber-500"
      />
    </div>
  </div>

  <footer
    class="flex flex-wrap items-center gap-4 px-4 py-1 bg-gray-50 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 text-xs text-gray-600 dark:text-gray-400"
  >
    <span
      id="chain-scrubber-tip"
    >
      Tip {@tip_height}
    </span>
    <span
      :if={@built_at}
    >
      Tiles built {Calendar.strftime(@built_at, "%Y-%m-%d %H:%M UTC")}
    </span>
    <span
      :if={@last_build}
    >
      Last build: {@last_build.mode}, {@last_build.tiles_written} written, {@last_build.tiles_unchanged} unchanged
    </span>
    <span
      id="chain-scrubber-annotations"
    >
      {length(@annotations)} annotations ({Enum.count(@annotations, &(&1.kind == "reorg"))} reorgs, {Enum.count(
        @annotations,
        &(&1.kind == "loss")
      )} classified losses, {Enum.count(@annotations, &(&1.kind == "event"))}
      <a
        href="/annotations"
        class="underline text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
      >events</a>)
    </span>
    <span
      :if={@rest}
      id="chain-scrubber-rest"
      class="font-mono"
    >
      Rest: block {@rest.height} {@rest.kind}
    </span>
    <span>
      Arrow keys step one block.
      Keyboard and scrubbing read tiles only.
    </span>
  </footer>
</div>
