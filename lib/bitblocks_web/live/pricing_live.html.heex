<div class="bg-surface-base min-h-screen">
  <div class="max-w-7xl mx-auto px-4">
    <section class="border-b border-neutral-800 pt-10 pb-6">
      <h1 class="text-4xl font-semibold text-neutral-50 tracking-tight mb-3">
        Pricing
      </h1>
      <p class="text-neutral-500 leading-relaxed max-w-lg">
        Start free.
        Pay for what you use as you grow.
      </p>
    </section>

    <%!-- Plans --%>
    <section class="py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%!-- Free --%>
        <div
          id="pricing-free"
          class="bg-surface-raised rounded p-6 border border-neutral-800"
        >
          <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
            Free
          </p>
          <div class="flex items-baseline gap-1 mb-4">
            <span class="text-3xl font-semibold text-neutral-50">
              $0
            </span>
          </div>
          <p class="text-sm text-neutral-500 mb-6">
            Sign in with GitHub to explore, learn and prototype.
          </p>
          <div class="border-t border-neutral-800">
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">API requests</span>
              <span class="font-mono text-sm text-neutral-50">600/min</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Block data</span>
              <span class="font-mono text-sm text-neutral-50">✓</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Transaction lookup</span>
              <span class="font-mono text-sm text-neutral-50">✓</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Merkle proofs</span>
              <span class="font-mono text-sm text-neutral-50">✓</span>
            </div>
          </div>
        </div>

        <%!-- Consumption --%>
        <div
          id="pricing-consumption"
          class="bg-surface-raised rounded p-6 border border-brand"
        >
          <p class="font-mono text-xs text-brand-strong dark:text-brand uppercase tracking-wider mb-2">
            Coming soon
          </p>
          <div class="flex items-baseline gap-1 mb-4">
            <span class="text-3xl font-semibold text-neutral-50">
              Pay per use
            </span>
          </div>
          <p class="text-sm text-neutral-500 mb-6">
            Your cost follows your use, for applications in production.
          </p>
          <div class="border-t border-neutral-800">
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Billing</span>
              <span class="font-mono text-sm text-neutral-50">per request</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Payment</span>
              <span class="font-mono text-sm text-neutral-50">deposit satoshis</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Subscription</span>
              <span class="font-mono text-sm text-neutral-50">none</span>
            </div>
            <div class="py-2.5 border-b border-neutral-800 flex justify-between">
              <span class="text-sm text-neutral-400">Credit card</span>
              <span class="font-mono text-sm text-neutral-50">none</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%!-- Your own use, measured and not billed (#61) --%>
    <section
      id="usage"
      aria-labelledby="usage-heading"
      class="border-t border-neutral-800 py-8 scroll-mt-6"
    >
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
        Your use
      </p>
      <h2
        id="usage-heading"
        class="text-lg font-semibold text-neutral-50 mb-3"
      >
        What am I using?
      </h2>
      <div class="max-w-2xl space-y-3 text-sm text-neutral-400 leading-relaxed mb-4">
        <p>
          We measure every API request by caller and by kind, so the pay-per-use price can follow what each kind costs to serve.
          It's measured, not billed: no API price is set yet.
        </p>
        <p :if={!@current_user}>
          <.link
            navigate={~p"/sign-in"}
            class="text-neutral-50 underline underline-offset-2"
          >
            Sign in
          </.link>
          to see your own use here, or call
          <code class="font-mono text-neutral-50 break-all">GET /api/v1/usage?hours=24</code>
          with your key.
        </p>
      </div>

      <div
        :if={@current_user}
        id="usage-own"
        class="bg-surface-raised rounded p-6 border border-neutral-800 max-w-2xl"
      >
        <p
          :if={is_nil(@usage)}
          class="text-sm text-neutral-500"
        >
          Loading your use...
        </p>
        <p
          :if={@usage == :unavailable}
          id="usage-unavailable"
          class="text-sm text-neutral-50"
        >
          Your use is unavailable right now. Try again shortly.
        </p>
        <div :if={is_map(@usage)}>
          <div
            :for={{title, id, usage} <- usage_groups(@usage)}
            id={id}
            class="mb-5 last:mb-0"
          >
            <h3 class="text-sm font-medium text-neutral-50 mb-2">
              {title}, last {@usage.hours} hours
            </h3>
            <p
              :if={usage.totals.requests == 0}
              class="text-sm text-neutral-500"
            >
              No requests yet.
            </p>
            <table
              :if={usage.totals.requests > 0}
              class="w-full text-sm"
            >
              <caption class="sr-only">
                {title}: requests and data sent by kind, last {@usage.hours} hours
              </caption>
              <thead>
                <tr class="text-left text-xs text-neutral-500">
                  <th
                    scope="col"
                    class="font-normal pb-1"
                  >
                    Kind
                  </th>
                  <th
                    scope="col"
                    class="font-normal pb-1 text-right"
                  >
                    Requests
                  </th>
                  <th
                    scope="col"
                    class="font-normal pb-1 text-right"
                  >
                    Data sent
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr
                  :for={row <- usage.by_class}
                  class="border-t border-neutral-800"
                >
                  <td class="py-1.5 text-neutral-400">{class_label(row.class)}</td>
                  <td class="py-1.5 font-mono text-neutral-50 tabular-nums text-right">
                    {format_number(row.requests)}
                  </td>
                  <td class="py-1.5 font-mono text-neutral-50 tabular-nums text-right whitespace-nowrap">
                    {format_bytes(row.response_bytes)}
                  </td>
                </tr>
                <tr class="border-t border-neutral-700">
                  <th
                    scope="row"
                    class="py-1.5 text-left font-medium text-neutral-50"
                  >
                    Total
                  </th>
                  <td class="py-1.5 font-mono text-neutral-50 tabular-nums text-right">
                    {format_number(usage.totals.requests)}
                  </td>
                  <td class="py-1.5 font-mono text-neutral-50 tabular-nums text-right whitespace-nowrap">
                    {format_bytes(usage.totals.response_bytes)}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-neutral-500 mt-4">
            Counts reach this view within a minute.
            Your key's own view is
            <code class="font-mono break-all">GET /api/v1/usage?hours=24</code>.
          </p>
        </div>
      </div>
    </section>

    <%!-- Enterprise --%>
    <section class="border-t border-neutral-800 py-8">
      <div class="bg-surface-raised rounded p-6 border border-neutral-700">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
              Enterprise
            </p>
            <h2 class="text-2xl font-semibold text-neutral-50 mb-2">
              Custom
            </h2>
            <p class="text-sm text-neutral-500 leading-relaxed max-w-md">
              Dedicated infrastructure, compliance reporting, audit trails, custom protocol parsing and on-prem data delivery for web-scale operations.
            </p>
          </div>
          <a
            href="mailto:enterprise@bitblocks.app"
            class="shrink-0 px-6 py-3 bg-brand-strong text-white font-medium rounded hover:opacity-90 transition-colors text-center"
          >
            Contact us
          </a>
        </div>
        <div class="border-t border-neutral-800 mt-6 pt-4 grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div>
            <p class="font-mono text-xs text-neutral-500 mb-1">Infrastructure</p>
            <p class="text-sm text-neutral-400">Dedicated indexing</p>
          </div>
          <div>
            <p class="font-mono text-xs text-neutral-500 mb-1">Compliance</p>
            <p class="text-sm text-neutral-400">Audit trails + reporting</p>
          </div>
          <div>
            <p class="font-mono text-xs text-neutral-500 mb-1">Support</p>
            <p class="text-sm text-neutral-400">Dedicated + priority</p>
          </div>
        </div>
      </div>
    </section>

    <%!-- Bulk downloads, the free quote (#111): no checkout yet --%>
    <section
      id="downloads"
      aria-labelledby="downloads-heading"
      class="border-t border-neutral-800 py-8 scroll-mt-6"
    >
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
        Downloads
      </p>
      <h2
        id="downloads-heading"
        class="text-lg font-semibold text-neutral-50 mb-3"
      >
        Bulk downloads
      </h2>
      <div class="max-w-2xl space-y-3 text-sm text-neutral-400 leading-relaxed mb-6">
        <p>
          Hydrating your own database from the chain?
          Take a block range in one download, instead of millions of API calls.
          Quote it here, for free: the size and file count come from the block sizes we store.
        </p>
        <p
          :if={@price_per_gib}
          id="downloads-rate"
        >
          Downloads cost
          <span class="font-mono tabular-nums text-neutral-50">{format_usd(@price_per_gib)} per GiB</span>,
          so the price is the size times that rate, and the quote shows the sum.
        </p>
        <p
          :if={!@price_per_gib}
          id="downloads-rate"
        >
          The price is on request for now: write to us with your quote.
        </p>
        <p>
          A quote covers only blocks we hold whole, each one complete with every transaction stored and its merkle root rebuilt.
        </p>
      </div>

      <%!-- Named ranges and the size by band, for choosing a range --%>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        <div
          id="downloads-presets"
          class="bg-surface-raised rounded p-6 border border-neutral-800"
        >
          <h3 class="text-sm font-medium text-neutral-50 mb-1">
            Start from a range
          </h3>
          <p class="text-xs text-neutral-500 mb-3">
            Each one fills in the form and quotes it.
            A range is cut off where our complete blocks end.
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <li :for={preset <- Bitblocks.Downloads.presets(@holding)}>
              <button
                type="button"
                id={"downloads-preset-#{preset.id}"}
                phx-click="preset"
                phx-value-id={preset.id}
                disabled={!preset.available}
                aria-describedby={"downloads-preset-#{preset.id}-range"}
                class="w-full h-full text-left rounded border border-neutral-700 px-3 py-2 hover:border-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand disabled:opacity-60 disabled:hover:border-neutral-700 disabled:cursor-not-allowed"
              >
                <span class="block text-sm text-neutral-50">{preset.label}</span>
                <span
                  id={"downloads-preset-#{preset.id}-range"}
                  class="block font-mono text-xs text-neutral-500 tabular-nums"
                >
                  <%= cond do %>
                    <% !preset.available -> %>
                      From {format_number(preset.from)}: not held yet
                    <% preset.clipped -> %>
                      {format_number(preset.from)} to {format_number(preset.to)}, as far as we hold
                    <% true -> %>
                      {format_number(preset.from)} to {format_number(preset.to)}
                  <% end %>
                </span>
                <span
                  :if={preset.note}
                  class="block text-xs text-neutral-500"
                >
                  {preset.note}
                </span>
              </button>
            </li>
          </ul>
        </div>

        <div
          id="downloads-sizes"
          class="bg-surface-raised rounded p-6 border border-neutral-800"
        >
          <h3 class="text-sm font-medium text-neutral-50 mb-1">
            Where the bytes are
          </h3>
          <p class="text-xs text-neutral-500 mb-3">
            The size of every 50,000 blocks we hold.
            Early blocks are small; later ones carry most of the bytes.
            Choose a band to quote it.
          </p>
          <p
            :if={!@sizes && !@sizes_error}
            id="downloads-sizes-loading"
            class="text-sm text-neutral-500"
          >
            Adding up the sizes...
          </p>
          <p
            :if={@sizes_error}
            id="downloads-sizes-error"
            class="text-sm text-neutral-50"
          >
            {@sizes_error}
          </p>
          <p
            :if={@sizes && @sizes.bands == []}
            id="downloads-sizes-empty"
            class="text-sm text-neutral-500"
          >
            No blocks are complete yet.
          </p>
          <table
            :if={@sizes && @sizes.bands != []}
            id="downloads-sizes-table"
            class="w-full text-sm"
          >
            <caption class="sr-only">
              Size of each 50,000-block band, through block {format_number(@sizes.complete_through)}
            </caption>
            <thead>
              <tr class="text-left text-xs text-neutral-500">
                <th
                  scope="col"
                  class="font-normal pb-1"
                >
                  Blocks
                </th>
                <th
                  scope="col"
                  class="font-normal pb-1 text-right"
                >
                  Size
                </th>
                <th
                  scope="col"
                  class="font-normal pb-1 w-1/3"
                >
                  <span class="sr-only">Share of the largest band</span>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr
                :for={band <- @sizes.bands}
                id={"downloads-band-#{band.from}"}
                class="border-t border-neutral-800"
              >
                <td class="py-1.5 pr-2">
                  <button
                    type="button"
                    phx-click="band"
                    phx-value-from={band.from}
                    phx-value-to={band.to}
                    aria-label={"Quote blocks #{format_number(band.from)} to #{format_number(band.to)}"}
                    class="font-mono text-xs text-neutral-50 tabular-nums underline decoration-neutral-500 underline-offset-2 hover:decoration-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand text-left"
                  >
                    {format_number(band.from)} to {format_number(band.to)}
                  </button>
                </td>
                <td class="py-1.5 pr-2 font-mono text-xs text-neutral-50 tabular-nums text-right whitespace-nowrap">
                  <span :if={!band.bytes_exact}>at least </span>{format_gib(band.bytes)} GiB
                </td>
                <td class="py-1.5">
                  <div
                    class="h-2 rounded-sm bg-neutral-800"
                    aria-hidden="true"
                  >
                    <div
                      class="h-2 rounded-sm bg-brand"
                      style={"width: #{band_width(band.bytes, max_band_bytes(@sizes))}"}
                    >
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
          <p
            :if={@sizes && @sizes.bands != []}
            class="text-xs text-neutral-500 mt-3"
          >
            Through block
            <span class="font-mono tabular-nums">{format_number(@sizes.complete_through)}</span>,
            added up at {Calendar.strftime(@sizes.computed_at, "%H:%M UTC")} and refreshed every ten minutes.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <.form
          for={@quote_form}
          id="downloads-form"
          phx-change="quote_change"
          phx-submit="quote"
          class="bg-surface-raised rounded p-6 border border-neutral-800 space-y-5"
        >
          <fieldset>
            <legend class="text-sm font-medium text-neutral-50 mb-2">
              Block range
            </legend>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  for="downloads-from"
                  class="block text-xs text-neutral-500 mb-1"
                >
                  From block
                </label>
                <input
                  id="downloads-from"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  phx-debounce="400"
                  name={@quote_form[:from].name}
                  value={@quote_form[:from].value}
                  class="block w-full rounded border border-neutral-700 bg-surface-base px-3 py-2 font-mono text-sm text-neutral-50 tabular-nums"
                />
              </div>
              <div>
                <label
                  for="downloads-to"
                  class="block text-xs text-neutral-500 mb-1"
                >
                  To block (inclusive)
                </label>
                <input
                  id="downloads-to"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  phx-debounce="400"
                  name={@quote_form[:to].name}
                  value={@quote_form[:to].value}
                  aria-describedby="downloads-to-hint"
                  class="block w-full rounded border border-neutral-700 bg-surface-base px-3 py-2 font-mono text-sm text-neutral-50 tabular-nums"
                />
              </div>
            </div>
            <p
              :if={@coverage}
              id="downloads-to-hint"
              class="text-xs text-neutral-500 mt-2"
            >
              Complete through block
              <span class="font-mono tabular-nums text-neutral-50">{format_number(@coverage.through)}</span>.
            </p>
          </fieldset>

          <fieldset>
            <legend class="text-sm font-medium text-neutral-50 mb-2">
              Data
            </legend>
            <div class="space-y-2">
              <label
                :for={option <- @data_options}
                for={"downloads-data-#{option.id}"}
                class={[
                  "flex items-center gap-2 text-sm",
                  if(option.available, do: "text-neutral-50", else: "text-neutral-500")
                ]}
              >
                <input
                  id={"downloads-data-#{option.id}"}
                  type="radio"
                  name={@quote_form[:data].name}
                  value={option.id}
                  checked={@quote_form[:data].value == option.id}
                  disabled={!option.available}
                />
                <span>
                  {option.label}<span :if={!option.available}> (coming)</span>
                </span>
              </label>
            </div>
          </fieldset>

          <div>
            <label
              for="downloads-format"
              class="block text-sm font-medium text-neutral-50 mb-2"
            >
              Format
            </label>
            <select
              id="downloads-format"
              name={@quote_form[:format].name}
              class="block w-full rounded border border-neutral-700 bg-surface-base px-3 py-2 text-sm text-neutral-50"
            >
              <option
                :for={format <- formats_for(@data_options, @quote_form[:data].value)}
                value={format.id}
                selected={@quote_form[:format].value == format.id}
              >
                {format.label}
              </option>
            </select>
          </div>

          <button
            type="submit"
            id="downloads-quote-button"
            phx-disable-with="Quoting..."
            class="w-full sm:w-auto px-6 py-3 bg-brand-strong text-white font-medium rounded hover:opacity-90 transition-colors"
          >
            Get a quote
          </button>
        </.form>

        <div
          id="downloads-result"
          aria-live="polite"
          class="bg-surface-raised rounded p-6 border border-neutral-800"
        >
          <p
            :if={@pending_quote}
            id="downloads-updating"
            class="text-xs text-neutral-500 mb-2"
          >
            Updating the estimate...
          </p>

          <p
            :if={@quote_error}
            id="downloads-error"
            class="text-sm text-neutral-50"
          >
            {@quote_error}
          </p>

          <p
            :if={!@quote && !@quote_error}
            class="text-sm text-neutral-500"
          >
            Your estimate shows here as you change the range: the size in GiB, the file count, the price and what it covers.
          </p>

          <div
            :if={@quote}
            id="downloads-quote"
          >
            <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
              Quote
            </p>
            <div class="border-t border-neutral-800">
              <div class="py-2.5 border-b border-neutral-800 flex justify-between gap-4">
                <span class="text-sm text-neutral-400">Blocks</span>
                <span
                  id="downloads-quote-range"
                  class="font-mono text-sm text-neutral-50 tabular-nums text-right"
                >
                  {format_number(@quote.from)} to {format_number(@quote.to)}
                </span>
              </div>
              <div class="py-2.5 border-b border-neutral-800 flex justify-between gap-4">
                <span class="text-sm text-neutral-400">Files</span>
                <span
                  id="downloads-quote-files"
                  class="font-mono text-sm text-neutral-50 tabular-nums text-right"
                >
                  {format_number(@quote.files)}
                </span>
              </div>
              <div class="py-2.5 border-b border-neutral-800 flex justify-between gap-4">
                <span class="text-sm text-neutral-400">Size</span>
                <span
                  id="downloads-quote-size"
                  class="font-mono text-sm text-neutral-50 tabular-nums text-right"
                >
                  <span :if={!@quote.bytes_exact}>at least </span>{format_gib(@quote.bytes)} GiB
                </span>
              </div>
              <div class="py-2.5 border-b border-neutral-800 flex justify-between gap-4">
                <span class="text-sm text-neutral-400">Bytes</span>
                <span
                  id="downloads-quote-bytes"
                  class="font-mono text-sm text-neutral-50 tabular-nums text-right"
                >
                  {format_number(@quote.bytes)}
                </span>
              </div>
              <div class="py-2.5 border-b border-neutral-800 flex justify-between gap-4">
                <span class="text-sm text-neutral-400">Price</span>
                <span
                  id="downloads-quote-price"
                  class="font-mono text-sm text-neutral-50 tabular-nums text-right"
                >
                  {if @quote.price_usd, do: format_usd(@quote.price_usd), else: "Price on request"}
                </span>
              </div>
            </div>

            <p
              :if={@quote.price_usd}
              id="downloads-quote-arithmetic"
              class="mt-3 font-mono text-xs text-neutral-400 tabular-nums"
            >
              {Decimal.to_string(@quote.billable_gib, :normal)} GiB x {format_usd(@quote.price_usd_per_gib)} per GiB = {format_usd(@quote.price_usd)}
            </p>
            <p
              :if={@quote.price_usd}
              class="mt-1 text-xs text-neutral-500"
            >
              A GiB is 1,073,741,824 bytes.
              The size is rounded to the nearest 0.01 GiB, and is at least 0.01.
            </p>
            <p
              :if={!@quote.price_usd && @quote.price_usd_per_gib && !@quote.bytes_exact}
              id="downloads-quote-price-why"
              class="mt-3 text-xs text-neutral-500"
            >
              Some blocks in this range have no stored size yet, so we can't give an exact price.
              At {format_usd(@quote.price_usd_per_gib)} per GiB it is at least {format_usd(Decimal.mult(@quote.billable_gib, @quote.price_usd_per_gib))}; write to us and we'll confirm it.
            </p>

            <div class="mt-4 space-y-2 text-sm text-neutral-400 leading-relaxed">
              <p id="downloads-quote-covers">
                Every block in this range is complete, with every transaction stored: we hold blocks 0 through
                <span class="font-mono tabular-nums text-neutral-50">{format_number(@quote.complete_through)}</span>
                whole.
              </p>
              <p
                :if={@quote.sizes_missing > 0}
                id="downloads-quote-missing"
              >
                <span class="font-mono tabular-nums text-neutral-50">{format_number(@quote.sizes_missing)}</span>
                blocks have no stored size yet, so the size above leaves them out.
                The first:
                <span class="font-mono tabular-nums text-neutral-50">{Enum.map_join(@quote.sizes_missing_heights, ", ", &format_number/1)}</span>.
              </p>
              <p
                :if={@quote.not_in_store > 0}
                id="downloads-quote-not-in-store"
              >
                <span class="font-mono tabular-nums text-neutral-50">{format_number(@quote.not_in_store)}</span>
                of these blocks aren't in our file store yet, so we'd fetch them from our node first.
              </p>
            </div>

            <div
              :if={@checkout}
              id="downloads-checkout"
              class="mt-5"
            >
              <div
                :if={purchasable(@quote) == :ok}
                class="flex flex-col sm:flex-row sm:items-center gap-3"
              >
                <button
                  :if={@current_user}
                  type="button"
                  id="downloads-pay"
                  phx-click="pay"
                  phx-disable-with="Opening checkout..."
                  class="shrink-0 px-6 py-3 bg-brand-strong text-white font-medium rounded hover:opacity-90 transition-colors text-center"
                >
                  Pay {format_usd(@quote.price_usd)}
                </button>
                <a
                  :if={!@current_user}
                  id="downloads-sign-in-to-pay"
                  href={BitblocksWeb.UserAuth.sign_in_path(quote_path(@quote))}
                  class="shrink-0 px-6 py-3 bg-brand-strong text-white font-medium rounded hover:opacity-90 transition-colors text-center"
                >
                  Sign in to pay
                </a>
                <p class="text-xs text-neutral-500">
                  One card payment through Stripe.
                  Your links open as soon as Stripe confirms it, for {Bitblocks.Downloads.Purchases.valid_days()} days.
                </p>
              </div>
              <p
                :if={purchasable(@quote) != :ok}
                id="downloads-not-purchasable"
                class="text-sm text-neutral-400"
              >
                {refusal_message(elem(purchasable(@quote), 1))}
              </p>
              <p
                :if={@pay_error}
                id="downloads-pay-error"
                role="alert"
                class="mt-2 text-sm text-neutral-50"
              >
                {@pay_error}
              </p>
            </div>

            <div class="mt-5 flex flex-col sm:flex-row sm:items-center gap-3">
              <a
                id="downloads-contact"
                href={quote_mailto(@contact_email, @quote)}
                class={[
                  "shrink-0 px-6 py-3 font-medium rounded transition-colors text-center",
                  if(@checkout,
                    do: "border border-neutral-700 text-neutral-50 hover:bg-neutral-800",
                    else: "bg-brand-strong text-white hover:opacity-90"
                  )
                ]}
              >
                Contact us
              </a>
              <p
                :if={!@checkout}
                class="text-xs text-neutral-500"
              >
                Paying online is coming.
                For now, write to us with this quote.
              </p>
              <p
                :if={@checkout}
                class="text-xs text-neutral-500"
              >
                Questions, or a range we can't sell online yet?
                Write to us with this quote.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        id="downloads-notes"
        class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4"
      >
        <div>
          <h3 class="text-sm font-medium text-neutral-50 mb-1">
            What a file is
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            One <span class="font-mono">.bin</span> file per block, holding that block's exact bytes.
            The 80-byte header comes first, then the transaction count, then every transaction in order.
            It's the same block your node would serve, byte for byte.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-neutral-50 mb-1">
            How to check it
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Hash a file's first 80 bytes twice with SHA-256 and reverse the result: that's the block hash, which any node or explorer will confirm.
            Then hash each transaction the same way to get its txid, and rebuild the merkle root from those txids: it matches the one in the header.
            You can check every file without trusting us.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-medium text-neutral-50 mb-1">
            What isn't covered yet
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Blocks above the ones we hold whole<span :if={@holding >= 0}> (through
              <span class="font-mono tabular-nums text-neutral-50">{format_number(@holding)}</span>)</span>, until our sync completes them.
            Transaction JSON and data packs, which are coming.
            Paying online, which is coming: for now we take your quote by mail.
          </p>
        </div>
      </div>

      <p
        id="downloads-api"
        class="max-w-2xl text-sm text-neutral-400 leading-relaxed mt-6"
      >
        Agents can ask for the same quote with a key:
        <code class="font-mono text-neutral-50 break-all">GET /api/v1/downloads/quote?from=0&amp;to=99999&amp;data=raw</code>
        returns the size, the price and its arithmetic (<code class="font-mono text-neutral-50">billable_gib</code>, <code class="font-mono text-neutral-50">price_usd_per_gib</code>, <code class="font-mono text-neutral-50">price_usd</code>).
        <code class="font-mono text-neutral-50 break-all">GET /api/v1/downloads/sizes</code>
        returns the size of each band and the named ranges.
      </p>
    </section>

    <%!-- AI crawlers and data licensing: the crawler 402 links here (#107) --%>
    <section
      id="crawlers"
      aria-labelledby="crawlers-heading"
      class="border-t border-neutral-800 py-8 scroll-mt-6"
    >
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
        AI crawlers
      </p>
      <h2
        id="crawlers-heading"
        class="text-lg font-semibold text-neutral-50 mb-3"
      >
        For AI crawlers and data licensing
      </h2>
      <div class="max-w-2xl space-y-3 text-sm text-neutral-400 leading-relaxed">
        <p>
          If you run a crawler for an AI or LLM product, you're welcome to the chain we hold, through the API.
          Without a key, each company's crawlers share
          <span
            id="crawlers-budget"
            class="font-mono tabular-nums text-neutral-50"
          >{@crawler_budget}</span>
          requests a minute across all their addresses, and past that get a 402 with a <code class="font-mono text-neutral-50">Retry-After</code> header.
          When a person asks an assistant to read a page, its user-triggered fetcher (ChatGPT-User, Claude-User and the like) has a separate budget of
          <span
            id="crawlers-fetcher-budget"
            class="font-mono tabular-nums text-neutral-50"
          >{@fetcher_budget}</span>
          a minute per company.
        </p>
        <p>
          A key gets your crawler a budget of its own, and is never counted as a crawler.
          It opens the chain data API: blocks, transactions, proofs, addresses, tokens and the other indexes.
          That includes <code class="font-mono text-neutral-50">/api/v1/txs/:txid/raw</code>, a transaction's exact bytes, checked against its txid.
          Our operator routes (<code class="font-mono text-neutral-50">/api/v1/ops/*</code>) and admin routes aren't part of it.
          Send it on every request as <code
            id="crawlers-header"
            class="font-mono text-neutral-50"
          >Authorization: Bearer bbk_...</code>.
        </p>
        <p :if={@coverage}>
          Every block from 0 through
          <span
            id="crawlers-coverage"
            class="font-mono tabular-nums text-neutral-50"
          >{format_number(@coverage.through)}</span>
          is complete, with every transaction stored, of
          <span class="font-mono tabular-nums text-neutral-50">{format_number(@coverage.tip)}</span>
          blocks known.
          <code class="font-mono text-neutral-50">/api/v1/status</code>
          always says where the index stands.
        </p>
        <div
          :if={@x402}
          id="crawlers-x402"
          class="space-y-3"
        >
          <h3
            id="crawlers-x402-heading"
            class="text-sm font-semibold text-neutral-50 pt-2"
          >
            Paying with x402
          </h3>
          <p>
            Past the free budget, a crawler can also pay for each request with <a
              href="https://x402.org"
              class="underline text-neutral-50 hover:opacity-80"
            >x402</a>, with no key and no account.
            One request costs
            <span
              id="crawlers-x402-price"
              class="font-mono tabular-nums text-neutral-50"
            >{@x402.price} USDC</span>
            on
            <span
              id="crawlers-x402-network"
              class="font-mono text-neutral-50"
            >{@x402.network_name}</span>
            (<code class="font-mono text-neutral-50">{@x402.network}</code>).
          </p>
          <p>
            The 402 carries a <code class="font-mono text-neutral-50">PAYMENT-REQUIRED</code> header with the offer, in the <code class="font-mono text-neutral-50">exact</code> scheme.
            Sign it with an x402 client, and send the same request again with the payment in a <code class="font-mono text-neutral-50">PAYMENT-SIGNATURE</code> header.
            Once the payment settles, you get the page, with its receipt in a <code class="font-mono text-neutral-50">PAYMENT-RESPONSE</code> header.
            Each payment is good for one request to the URL it names, once.
            A payment we can't take gets a 402 with a fresh offer, and a 503 means try again shortly.
          </p>
          <p>
            Payment opens what the free budget opens, and no more.
            For the chain data API, or for more than a few requests, a key is the better way in.
          </p>
        </div>
        <p>
          There's no checkout for crawler keys yet.
          Write to
          <a
            id="crawlers-contact"
            href={"mailto:#{@contact_email}?subject=AI%20crawler%20access"}
            class="underline text-neutral-50 hover:opacity-80"
          >{@contact_email}</a>
          for a key or a data license, with your crawler's name and user agent, what you'd like to read, and the requests a minute you need.
        </p>
      </div>
    </section>

    <%!-- API endpoints included --%>
    <section class="border-t border-neutral-800 py-8">
      <p class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2">
        Every plan includes
      </p>
      <h2 class="text-lg font-semibold text-neutral-50 mb-3">
        API Endpoints
      </h2>
      <div class="border-t border-neutral-800">
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/blocks
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            Block data, latest block, height ↔ time translation
          </span>
        </div>
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/txs
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            Transaction lookup, merkle proofs, filtered queries
          </span>
        </div>
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/addresses
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            UTXO set and balance for any address
          </span>
        </div>
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/stream/blocks
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            Server-Sent Events for real-time block and sync events
          </span>
        </div>
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/protocols
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            On-chain protocol registry and search
          </span>
        </div>
        <div class="py-2.5 border-b border-neutral-800 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-8">
          <code class="text-sm font-mono text-neutral-50 sm:col-span-1">
            /api/v1/mining
          </code>
          <span class="text-sm text-neutral-500 sm:col-span-2">
            Block templates and solution submission
          </span>
        </div>
      </div>
    </section>

    <div class="h-8"></div>
  </div>
</div>
