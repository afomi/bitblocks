<div class="bg-surface-base min-h-screen text-neutral-300">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-neutral-50 mb-4">
      Collections
    </h1>
    <p class="mb-3 leading-relaxed">
      NFT collections on Bitcoin SV, indexed from the chain.
    </p>
    <p class="mb-8 leading-relaxed">
      Membership is proven from each collection's mint chain, and holders are traced through spends.
    </p>

    <form
      id="collection-search"
      phx-change="search"
      phx-submit="search"
      class="mb-4"
    >
      <input
        type="search"
        name="q"
        value={@q}
        phx-debounce="200"
        placeholder="Search by name, standard, source, or origin outpoint"
        aria-label="Search collections"
        class="w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm text-neutral-100"
      />
    </form>

    <div
      id="source-filter"
      class="flex flex-wrap items-center gap-2 mb-8 text-sm"
    >
      <.link
        :for={{label, value} <- [{"All sources", ""} | Enum.map(Enum.reject(@filter_sources, &is_nil/1), &{&1, &1})]}
        patch={index_path(@q, value)}
        aria-current={if @source == value, do: "true"}
        class={[
          "rounded-full border px-3 py-1",
          if(@source == value,
            do: "border-neutral-300 text-neutral-50",
            else: "border-neutral-700 text-neutral-400 hover:text-neutral-100"
          )
        ]}
      >
        <%= label %>
      </.link>
    </div>

    <%= if @shown == [] do %>
      <p
        id="collections-empty"
        class="mb-12 text-neutral-100"
      >
        No collections match.
      </p>
    <% else %>
      <div class="grid gap-4 md:grid-cols-2 mb-12">
        <.link
          :for={collection <- @shown}
          id={"collection-#{collection.slug}"}
          navigate={~p"/collections/#{collection.slug}"}
          class="block rounded-lg border border-neutral-800 bg-neutral-900 p-5 hover:border-neutral-500"
        >
          <div class="flex items-start justify-between gap-3 mb-2">
            <h2 class="font-semibold text-neutral-50 break-all">
              <%= collection.name %>
            </h2>
            <span class="shrink-0 rounded-full border border-neutral-700 px-2 py-0.5 text-xs text-neutral-300">
              <%= collection.standard %>
            </span>
          </div>
          <p
            :if={collection.description}
            class="mb-3 text-sm leading-relaxed"
          >
            <%= collection.description %>
          </p>
          <%= if collection.items == 0 do %>
            <p class="text-sm text-neutral-400">
              Not synced yet.
            </p>
          <% else %>
            <p class="text-sm text-neutral-100">
              <%= item_count(collection.items) %>
            </p>
            <p class="text-sm text-neutral-400">
              <%= collection.traced %> of <%= collection.items %> owners traced
            </p>
          <% end %>
          <p
            :if={collection.source}
            class="mt-2 text-xs text-neutral-400"
          >
            Source: <%= collection.source %>
          </p>
        </.link>
      </div>
    <% end %>

    <section id="sources">
      <h2 class="text-xl font-semibold text-neutral-50 mb-2">
        Sources
      </h2>
      <p class="mb-4 leading-relaxed">
        Collections are minted and traded on these platforms.
      </p>
      <p class="mb-6 leading-relaxed">
        Bitblocks lists a platform's collection here once its items are indexed from the chain.
      </p>
      <ul class="divide-y divide-neutral-800">
        <li
          :for={source <- @sources}
          class="py-3"
        >
          <%= if source.url do %>
            <a
              href={source.url}
              target="_blank"
              rel="noopener"
              class="font-semibold text-neutral-50 underline"
            >
              <%= source.name %>
            </a>
          <% else %>
            <span class="font-semibold text-neutral-50">
              <%= source.name %>
            </span>
          <% end %>
          <p class="text-sm leading-relaxed">
            <%= source.description %>
          </p>
          <p
            :if={source.status}
            class="text-sm text-neutral-400"
          >
            <%= source.status %>
          </p>
        </li>
      </ul>
    </section>
  </div>
</div>
