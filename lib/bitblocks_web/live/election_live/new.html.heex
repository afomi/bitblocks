<div class="max-w-4xl mx-auto px-4 py-8 text-gray-900 dark:text-gray-100">
  <.link
    navigate={~p"/elections"}
    class="text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
  >
    ← Elections
  </.link>
  <div class="mt-2 mb-3 flex flex-wrap items-center gap-3">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
      New election
    </h1>
    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
      Beta
    </span>
  </div>
  <p class="mb-2 max-w-3xl text-gray-700 dark:text-gray-300">
    Define the election here, and see its two records exactly as they'll be published: the roll first, then the election that names it.
  </p>
  <p class="mb-2 max-w-3xl text-gray-700 dark:text-gray-300">
    Your wallet signs and sends each one; Bitblocks never sees your keys, and never signs or sends a transaction.
  </p>
  <p class="mb-6 max-w-3xl text-gray-700 dark:text-gray-300">
    The record format is a draft (<a
      href="https://github.com/afomi/bitblocks/blob/develop/docs/ELECTION_DOGFOOD.md"
      class="text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
    >docs/ELECTION_DOGFOOD.md</a>).
  </p>

  <p
    id="election-tip"
    class="mb-6 rounded-lg border border-gray-200 bg-gray-50 p-4 text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200"
  >
    <%= if @tip do %>
      Today's tip is block <span class="font-mono tabular-nums">{delimit(@tip)}</span>, from our headers.
    <% else %>
      We hold no headers yet, so there is no tip height to start from.
    <% end %>
  </p>

  <.form
    for={to_form(%{}, as: :election)}
    id="election-form"
    phx-change="change"
    phx-submit="show"
    class="space-y-5 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
  >
    <.field
      field="name"
      label="Title"
      params={@params}
      errors={@errors}
      placeholder="PBA Board 2026"
    />

    <div class="grid gap-5 sm:grid-cols-2">
      <.field
        field="number_elected"
        label="Seats"
        params={@params}
        errors={@errors}
        inputmode="numeric"
        mono
      />
      <.field
        field="votes_allowed"
        label="Votes per member"
        hint="Leave blank for one vote per seat."
        params={@params}
        errors={@errors}
        inputmode="numeric"
        mono
      />
    </div>

    <.field
      field="candidates"
      label="Candidates"
      hint="One per line, as id: Name, or just the name to make the id from it. Ids use a to z, 0 to 9 and hyphens."
      params={@params}
      errors={@errors}
      rows={5}
      placeholder={"alice: Alice Ng\nBob Ruiz"}
    />

    <.field
      field="members"
      label="Roll (members' addresses)"
      hint="One P2PKH address per line, the form each member's wallet signs with. They're sorted, and each kept once."
      params={@params}
      errors={@errors}
      rows={5}
      mono
    />

    <fieldset class="space-y-3">
      <legend class="text-sm font-medium text-gray-800 dark:text-gray-200">
        Voting window, in block heights
      </legend>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Both ends count.
        The roll and the election must confirm before the opening block.
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        <.field
          field="opens_at_height"
          label="Opens at block"
          params={@params}
          errors={@errors}
          inputmode="numeric"
          mono
        />
        <.field
          field="closes_at_height"
          label="Closes at block"
          params={@params}
          errors={@errors}
          inputmode="numeric"
          mono
        />
      </div>
      <div
        :if={@week}
        class="flex flex-col gap-2 sm:flex-row sm:items-center"
      >
        <button
          type="button"
          id="election-week"
          phx-click="week"
          class="self-start rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700"
        >
          About a week
        </button>
        <p
          id="election-week-hint"
          class="text-sm text-gray-600 dark:text-gray-400"
        >
          Opens at block <span class="font-mono tabular-nums">{delimit(@week.opens)}</span>, {Draft.lead()} blocks after the tip (about an hour to confirm both records), and runs
          <span class="font-mono tabular-nums">{delimit(Draft.week())}</span>
          blocks, ten minutes each, to block <span class="font-mono tabular-nums">{delimit(@week.closes)}</span>.
        </p>
      </div>
      <p
        :if={@window}
        id="election-window"
        class="text-sm text-gray-800 dark:text-gray-200"
        aria-live="polite"
      >
        That's <span class="font-mono tabular-nums">{delimit(@window.blocks)}</span>
        {if @window.blocks == 1, do: "block", else: "blocks"} of voting, {@window.about}<span :if={@window.opens_in}>, opening {@window.opens_in} from now</span>.
        Blocks don't keep time, so it is always about.
      </p>
    </fieldset>

    <button
      type="submit"
      class="rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700"
    >
      Show the records
    </button>
  </.form>

  <section
    :if={@shown? and @draft}
    id="election-records"
    aria-labelledby="election-records-heading"
    class="mt-8"
  >
    <h2
      id="election-records-heading"
      class="text-2xl font-semibold text-gray-900 dark:text-white"
    >
      The records, as they'll be published
    </h2>
    <p class="mt-2 text-gray-700 dark:text-gray-300">
      Publish them in this order, each from the same administrator's key.
    </p>

    <article
      id="record-roll"
      aria-labelledby="record-roll-heading"
      class="mt-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
    >
      <h3
        id="record-roll-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white"
      >
        1. The roll
      </h3>
      <p class="mt-1 text-gray-700 dark:text-gray-300">
        A B:// file, <code class="font-mono">roll.json</code>, with <code class="font-mono">type=roll_v1</code>.
        It lists <span class="font-mono tabular-nums">{length(@draft.members)}</span>
        {if length(@draft.members) == 1, do: "member", else: "members"} and names no election.
      </p>
      <p
        :if={@draft.repeated_members > 0}
        id="roll-repeated"
        class="mt-1 text-gray-700 dark:text-gray-300"
      >
        <span class="font-mono tabular-nums">{@draft.repeated_members}</span>
        repeated {if @draft.repeated_members == 1, do: "address was", else: "addresses were"} kept once.
      </p>
      <h4 class="mt-4 text-sm font-semibold text-gray-900 dark:text-white">
        The file's bytes
      </h4>
      <pre
        id="record-roll-content"
        class="mt-1 whitespace-pre-wrap break-all rounded bg-gray-50 p-3 font-mono text-xs text-gray-800 dark:bg-gray-900 dark:text-gray-200"
      >{@roll.content}</pre>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
        <span class="font-mono tabular-nums">{byte_size(@roll.content)}</span> bytes, sha256
      </p>
      <p
        id="record-roll-sha256"
        class="break-all font-mono text-sm text-gray-800 dark:text-gray-200"
      >
        {@roll.sha256}
      </p>

      <h4 class="mt-4 text-sm font-semibold text-gray-900 dark:text-white">
        Fields
      </h4>
      <ol
        id="record-roll-fields"
        class="mt-1 space-y-1 text-sm"
      >
        <li
          :for={field <- @roll.covered}
          class="flex gap-2"
        >
          <span class="w-6 shrink-0 text-right font-mono tabular-nums text-gray-600 dark:text-gray-400">
            {field.index}
          </span>
          <span class="min-w-0 break-all font-mono text-gray-800 dark:text-gray-200">
            {field.value}
          </span>
        </li>
      </ol>

      <.record_parts
        id="record-roll"
        record={@roll}
        what="roll"
      />
    </article>

    <article
      id="record-election"
      aria-labelledby="record-election-heading"
      class="mt-6 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
    >
      <h3
        id="record-election-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white"
      >
        2. The election
      </h3>
      <p class="mt-1 text-gray-700 dark:text-gray-300">
        A MAP record with <code class="font-mono">type=election_v1</code>, naming the roll by its outpoint and sha256.
        Its own outpoint becomes the election's id.
      </p>

      <form
        id="election-roll-form"
        phx-change="roll"
        phx-submit="roll"
        class="mt-4"
      >
        <label
          for="election-roll-outpoint"
          class="block text-sm font-medium text-gray-800 dark:text-gray-200"
        >
          The roll's outpoint, once it is broadcast
        </label>
        <p
          id="election-roll-outpoint-hint"
          class="mt-1 text-sm text-gray-600 dark:text-gray-400"
        >
          Paste the txid your wallet returned, or <code class="font-mono">{"<txid>.<vout>"}</code>; a txid alone means output 0.
        </p>
        <input
          type="text"
          id="election-roll-outpoint"
          name="roll_outpoint"
          value={@roll_outpoint}
          autocomplete="off"
          spellcheck="false"
          placeholder="txid.vout"
          aria-invalid={to_string(!!@roll_error)}
          aria-describedby={
            if(@roll_error,
              do: "election-roll-outpoint-hint election-roll-outpoint-error",
              else: "election-roll-outpoint-hint"
            )
          }
          class={[
            "mt-1 w-full rounded-md border bg-white px-3 py-2 font-mono text-sm text-gray-900 dark:bg-gray-800 dark:text-gray-100",
            if(@roll_error,
              do: "border-red-600 dark:border-red-400",
              else: "border-gray-300 dark:border-gray-600"
            )
          ]}
        />
        <p
          :if={@roll_error}
          id="election-roll-outpoint-error"
          class="mt-1 text-sm text-red-800 dark:text-red-200"
        >
          {@roll_error}
        </p>
      </form>

      <h4 class="mt-4 text-sm font-semibold text-gray-900 dark:text-white">
        Fields
      </h4>
      <ol
        id="record-election-fields"
        class="mt-1 space-y-1 text-sm"
      >
        <%= if @election do %>
          <li
            :for={field <- @election.covered}
            class="flex gap-2"
          >
            <span class="w-6 shrink-0 text-right font-mono tabular-nums text-gray-600 dark:text-gray-400">
              {field.index}
            </span>
            <span class="min-w-0 break-all font-mono text-gray-800 dark:text-gray-200">
              {field.value}
            </span>
          </li>
        <% else %>
          <li
            :for={{key, value} <- @template}
            class="flex flex-wrap gap-x-2"
          >
            <span class="font-mono text-gray-600 dark:text-gray-400">
              {key}
            </span>
            <span
              :if={value}
              class="min-w-0 break-all font-mono text-gray-800 dark:text-gray-200"
            >
              {value}
            </span>
            <span
              :if={!value}
              id="record-election-roll-pending"
              class="text-amber-900 dark:text-amber-200"
            >
              fills in once the roll is broadcast
            </span>
          </li>
        <% end %>
      </ol>

      <%= if @election do %>
        <.record_parts
          id="record-election"
          record={@election}
          what="election"
        />
      <% else %>
        <p
          id="record-election-waiting"
          class="mt-4 text-gray-700 dark:text-gray-300"
        >
          The script and its <code class="font-mono">createAction</code> appear here once the roll's outpoint is in.
        </p>
      <% end %>
    </article>
  </section>
</div>
