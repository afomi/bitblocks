<div class="max-w-3xl mx-auto px-4 py-8 text-gray-900 dark:text-gray-100">
  <p class="mb-4">
    <a
      href={~p"/elections"}
      class="text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
    >
      Elections
    </a>
  </p>
  <div class="mb-3 flex flex-wrap items-center gap-3">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white break-words">
      {if @count, do: @count.name, else: "Election"}
    </h1>
    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
      Beta
    </span>
  </div>
  <p class="text-gray-700 dark:text-gray-300 mb-2 max-w-3xl">
    Bitblocks reads the chain and does not cast a vote.
  </p>
  <p class="text-gray-700 dark:text-gray-300 mb-6 max-w-3xl">
    The record format is a draft.
  </p>

  <p
    :if={@error}
    id="election-error"
    role="alert"
    class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200"
  >
    {@error}
  </p>

  <div
    :if={@count}
    id="election-count"
    class="space-y-10"
  >
    <section aria-labelledby="election-about-heading">
      <h2
        id="election-about-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white mb-3"
      >
        This election
      </h2>
      <p
        :if={ElectionCount.window_sentence(@count)}
        id="election-window"
        data-state={@count.state}
        class="mb-3 text-lg font-medium text-gray-900 dark:text-white"
      >
        {ElectionCount.window_sentence(@count)}
      </p>
      <p class="mb-2 break-all text-gray-700 dark:text-gray-300">
        This election is <span class="font-mono">{@count.election}</span>.
      </p>
      <p
        id="election-seats"
        class="mb-2 text-gray-800 dark:text-gray-200"
      >
        This election fills
        <span class="font-mono tabular-nums">{ElectionCount.seats_label(@count.number_elected)}</span>.
      </p>
      <p
        id="election-votes-allowed"
        class="mb-2 text-gray-800 dark:text-gray-200"
      >
        A ballot may list <span class="font-mono tabular-nums">{@count.votes_allowed}</span> choices.
      </p>
      <p
        id="election-heights"
        class="mb-2 text-gray-800 dark:text-gray-200"
      >
        Ballots count in blocks
        <span class="font-mono tabular-nums">{@count.opens_at_height}</span>
        through <span class="font-mono tabular-nums">{@count.closes_at_height}</span>.
      </p>
      <p
        id="election-current-to"
        class="mb-2 text-gray-800 dark:text-gray-200"
      >
        The count is current to block <span class="font-mono tabular-nums">{@count.current_to.height}</span>.
      </p>
      <p
        :if={@count.current_to.hash}
        id="election-current-hash"
        class="mb-2 break-all font-mono text-sm text-gray-600 dark:text-gray-400"
      >
        That block's hash is {@count.current_to.hash}.
      </p>
      <.freshness
        id="election-index"
        class="mb-2 text-gray-800 dark:text-gray-200"
        label="Index complete through"
        through={@count.coverage.complete_through}
        tip={@count.tip_height}
      />
      <p
        id="election-final"
        class="text-gray-800 dark:text-gray-200"
      >
        {ElectionCount.final_sentence(@count.final)}
      </p>
    </section>

    <section aria-labelledby="ballot-check-heading">
      <h2
        id="ballot-check-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white mb-3"
      >
        Did my ballot count?
      </h2>
      <form
        id="ballot-lookup"
        phx-submit="lookup"
        class="mb-4 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
      >
        <label
          for="ballot-query"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Your address or your ballot's transaction id
        </label>
        <p
          id="ballot-query-hint"
          class="mb-2 text-sm text-gray-600 dark:text-gray-400"
        >
          An address shows every ballot it sent, and which one counts.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <input
            id="ballot-query"
            name="query"
            type="text"
            value={@lookup}
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            aria-describedby={
              if @lookup_error, do: "ballot-query-hint ballot-lookup-error", else: "ballot-query-hint"
            }
            aria-invalid={if @lookup_error, do: "true", else: "false"}
            class="w-full min-w-0 rounded-md border border-gray-300 bg-white px-3 py-2 font-mono text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100"
          />
          <button
            type="submit"
            class="shrink-0 rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"
          >
            Check my ballot
          </button>
        </div>
      </form>

      <div
        id="ballot-answer"
        role="status"
        aria-live="polite"
      >
        <p
          :if={@lookup_error}
          id="ballot-lookup-error"
          class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200"
        >
          {@lookup_error}
        </p>

        <div
          :if={@answer}
          class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
        >
          <div
            :if={@answer.kind == :address}
            id="ballot-answer-address"
            class="mb-4"
          >
            <h3
              id="ballot-answer-headline"
              class="text-lg font-semibold text-gray-900 dark:text-white"
            >
              {@answer.headline}
            </h3>
            <p class="mt-1 text-gray-800 dark:text-gray-200">
              {@answer.reason}
            </p>
            <p class="mt-1 break-all font-mono text-sm text-gray-600 dark:text-gray-400">
              {@answer.query}
            </p>
            <p
              :if={not @answer.on_roll}
              class="mt-2 break-all text-gray-800 dark:text-gray-200"
            >
              The roll is transaction
              <a
                href={~p"/transactions/#{@count.roll_txid}"}
                class="font-mono text-sm text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
              >{@count.roll_txid}</a>.
            </p>
          </div>

          <ol
            :if={answer_ballots(@answer) != []}
            id="ballot-answer-ballots"
            aria-label="Ballots, in chain order"
            class="space-y-4"
          >
            <li
              :for={ballot <- answer_ballots(@answer)}
              id={"answer-#{ballot.txid}"}
              class={[
                @answer.kind == :address &&
                  "border-t border-gray-200 pt-4 first:border-t-0 first:pt-0 dark:border-gray-700"
              ]}
            >
              <p
                id={"answer-#{ballot.txid}-headline"}
                class={[
                  "font-semibold text-gray-900 dark:text-white",
                  @answer.kind == :txid && "text-lg"
                ]}
              >
                {ballot.headline}
              </p>
              <p
                :if={ballot.reason}
                class="mt-1 text-gray-800 dark:text-gray-200"
              >
                {ballot.reason}
              </p>
              <p
                :if={ballot.status == "not_on_roll"}
                class="mt-2 break-all text-gray-800 dark:text-gray-200"
              >
                The roll is transaction
                <a
                  href={~p"/transactions/#{@count.roll_txid}"}
                  class="font-mono text-sm text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                >{@count.roll_txid}</a>.
              </p>
              <p
                :if={ballot.status == "replaced" and ElectionCount.txid?(ballot.replaced_by)}
                class="mt-2 break-all text-gray-800 dark:text-gray-200"
              >
                The later ballot is
                <a
                  href={~p"/transactions/#{ballot.replaced_by}"}
                  class="font-mono text-sm text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                >{ballot.replaced_by}</a>.
              </p>
              <p
                :if={ballot.choices != []}
                class="mt-2 text-gray-700 dark:text-gray-300"
              >
                Choices: <span class="font-mono">{Enum.join(ballot.choices, ", ")}</span>.
              </p>
              <ul
                :if={ballot.counted and is_integer(ballot.height)}
                id={"answer-#{ballot.txid}-proof"}
                class="mt-2 space-y-1"
              >
                <li>
                  <a
                    href={~p"/api/v1/elections/#{@count.election}/ballots/#{ballot.txid}"}
                    class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                  >
                    Its merkle proof
                  </a>
                </li>
                <li>
                  <a
                    href={~p"/api/v1/headers/#{ballot.height}"}
                    class="text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                  >
                    The header of block {ballot.height}
                  </a>
                </li>
              </ul>
              <p
                :if={ballot.status != "not_indexed"}
                class="mt-2 break-all"
              >
                <a
                  href={~p"/transactions/#{ballot.txid}"}
                  class="font-mono text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                >
                  {ballot.txid}
                </a>
              </p>
              <p
                :if={ballot.status == "not_indexed"}
                class="mt-2 break-all font-mono text-sm text-gray-600 dark:text-gray-400"
              >
                {ballot.txid}
              </p>
            </li>
          </ol>

          <p
            id="ballot-answer-current-to"
            class="mt-4 text-sm text-gray-600 dark:text-gray-400"
          >
            This answer is current to block <span class="font-mono tabular-nums">{@count.current_to.height}</span>.
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="election-tally-heading">
      <h2
        id="election-tally-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white mb-3"
      >
        Candidates
      </h2>
      <ul
        id="election-tally"
        class="space-y-3"
      >
        <li
          :for={candidate <- @count.candidates}
          id={"candidate-#{candidate.id}"}
          class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
        >
          <h3 class="break-words text-lg font-semibold text-gray-900 dark:text-white">
            {candidate.name || candidate.id}
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Id <span class="font-mono">{candidate.id}</span>
          </p>
          <p class="text-gray-800 dark:text-gray-200">
            <span class="font-mono tabular-nums">{ElectionCount.votes_label(candidate.votes)}</span>
          </p>
          <p
            :if={candidate.elected}
            class="text-gray-900 dark:text-white"
          >
            Elected
          </p>
        </li>
      </ul>
      <p
        :if={ElectionCount.undecided_sentence(@count.undecided)}
        id="election-undecided"
        class="mt-3 text-gray-800 dark:text-gray-200"
      >
        {ElectionCount.undecided_sentence(@count.undecided)}
      </p>
    </section>

    <section aria-labelledby="election-ballots-heading">
      <h2
        id="election-ballots-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white mb-3"
      >
        Ballots
      </h2>
      <p class="mb-1 text-gray-700 dark:text-gray-300">
        <span class="font-mono tabular-nums">{@count.counted}</span> counted.
      </p>
      <p class="mb-4 text-gray-700 dark:text-gray-300">
        <span class="font-mono tabular-nums">{@count.not_counted}</span> not counted.
      </p>
      <ul
        id="election-ballots"
        class="space-y-3"
      >
        <li
          :for={ballot <- @count.ballots}
          id={"ballot-#{ballot.txid}"}
          class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800"
        >
          <h3 class="sr-only">
            Ballot {ballot.txid}
          </h3>
          <p
            id={"ballot-#{ballot.txid}-status"}
            class="text-gray-900 dark:text-white"
          >
            {ElectionCount.ballot_status(ballot, @count.closes_at_height)}
          </p>
          <p
            :if={ballot.status == "replaced" and ElectionCount.txid?(ballot.replaced_by)}
            class="mt-2 break-all"
          >
            <a
              href={~p"/transactions/#{ballot.replaced_by}"}
              class="font-mono text-sm text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
            >
              {ballot.replaced_by}
            </a>
          </p>
          <p
            :if={ballot.choices != []}
            class="mt-2 text-gray-700 dark:text-gray-300"
          >
            Choices: <span class="font-mono">{Enum.join(ballot.choices, ", ")}</span>.
          </p>
          <p
            :if={ballot.signer}
            class="mt-2 break-all font-mono text-sm text-gray-600 dark:text-gray-400"
          >
            {ballot.signer}
          </p>
          <p class="mt-2 break-all">
            <a
              href={~p"/transactions/#{ballot.txid}"}
              class="font-mono text-sm text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
            >
              {ballot.txid}
            </a>
          </p>
        </li>
      </ul>
    </section>

    <section aria-labelledby="election-records-heading">
      <h2
        id="election-records-heading"
        class="text-xl font-semibold text-gray-900 dark:text-white mb-3"
      >
        Records
      </h2>
      <p class="mb-2">
        <a
          href={~p"/transactions/#{@count.election_txid}"}
          class="text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Election transaction
        </a>
      </p>
      <p>
        <a
          href={~p"/transactions/#{@count.roll_txid}"}
          class="text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
        >
          Roll transaction
        </a>
      </p>
    </section>
  </div>

  <p class="mt-8">
    <a
      href="/elections/recount.html"
      class="text-blue-700 underline hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
    >
      Recount it yourself
    </a>
  </p>
</div>
