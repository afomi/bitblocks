<%!-- Site-style chrome around a three.js scene: only #ecosystem-graph is dark (see DESIGN.md). --%>
<div class="fixed inset-0 flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
  <%!-- Top toolbar --%>
  <div class="flex items-center justify-between px-4 py-2 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10">
    <div class="flex items-center gap-4">
      <a
        href="/"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
      >
        &larr; Back
      </a>
      <h1 class="text-lg font-semibold text-gray-900 dark:text-white">
        BSV Ecosystem
      </h1>
    </div>

    <div class="flex items-center gap-4 text-xs text-gray-600 dark:text-gray-400">
      <span>
        Services: <strong class="text-gray-900 dark:text-gray-100"><%= @node_count %></strong>
      </span>
      <span>
        Connections: <strong class="text-gray-900 dark:text-gray-100"><%= @edge_count %></strong>
      </span>
      <%= if @loading do %>
        <span class="text-amber-800 dark:text-amber-300 animate-pulse">Loading...</span>
      <% end %>
    </div>
  </div>

  <%!-- Selected node detail --%>
  <%= if @selected_node do %>
    <div class="px-4 py-2 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 z-10 text-sm text-gray-800 dark:text-gray-200">
      Selected: <strong><%= @selected_node.name %></strong>
    </div>
  <% end %>

  <%!-- Three.js canvas: dark in both modes, matching scene.background in assets/js/hooks/ecosystem_graph.js --%>
  <div
    id="ecosystem-graph"
    phx-hook="EcosystemGraph"
    phx-update="ignore"
    class="flex-1 w-full min-h-0 overflow-hidden bg-[#050608]"
  >
  </div>

  <%!-- Tooltip --%>
  <div
    id="ecosystem-tooltip"
    class="fixed pointer-events-none bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-900 dark:text-gray-100 shadow-xl z-50 hidden"
  >
  </div>

  <%!-- Legend --%>
  <div class="fixed bottom-4 left-4 bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 rounded-lg px-3 py-2 text-xs text-gray-700 dark:text-gray-300 shadow-sm z-50">
    <div class="flex items-center gap-4 flex-wrap">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        <span>Network</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
        <span>Data</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
        <span>Identity</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
        <span>Token/Asset</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
        <span>Infrastructure</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-gray-500"></span>
        <span>Deprecated</span>
      </div>
      <span>Drag to rotate &middot; Scroll to zoom</span>
    </div>
  </div>
</div>
