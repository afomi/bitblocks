<%!-- Site-style chrome around a three.js scene: only #tx-flow-canvas is dark (see DESIGN.md). --%>
<div class="fixed inset-0 flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
  <header class="z-10 flex flex-wrap items-center gap-4 border-b border-gray-200 bg-white px-4 py-2 dark:border-gray-700 dark:bg-gray-800">
    <a
      href="/admin"
      class="text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
    >
      &larr; Admin
    </a>
    <h1 class="text-lg font-semibold text-gray-900 dark:text-white">
      Transaction flow
    </h1>
    <p class="text-xs text-gray-600 dark:text-gray-400">
      Each block is a disc of its transactions along the height spine.
      Each arc is an input, from the output it spends.
      Gold outputs are unspent at the playhead.
    </p>

    <form
      id="tx-flow-range"
      method="get"
      action="/tx-graph"
      class="ml-auto flex flex-wrap items-center gap-2 text-xs"
    >
      <label
        for="tx-flow-from"
        class="text-gray-600 dark:text-gray-400"
      >
        From block
      </label>
      <input
        id="tx-flow-from"
        type="text"
        name="from"
        inputmode="numeric"
        value={@from}
        class="w-24 rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100"
      />
      <label
        for="tx-flow-to"
        class="text-gray-600 dark:text-gray-400"
      >
        to
      </label>
      <input
        id="tx-flow-to"
        type="text"
        name="to"
        inputmode="numeric"
        value={@to}
        class="w-24 rounded border border-gray-300 bg-white px-2 py-1 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100"
      />
      <button
        type="submit"
        class="rounded bg-amber-700 px-3 py-1 text-sm text-white hover:bg-amber-800"
      >
        Load
      </button>
    </form>
    <form
      id="tx-flow-trace"
      method="get"
      action="/tx-graph"
      class="flex items-center gap-2 text-xs"
    >
      <label
        for="tx-flow-txid"
        class="text-gray-600 dark:text-gray-400"
      >
        Trace txid
      </label>
      <input
        id="tx-flow-txid"
        type="text"
        name="txid"
        value={@txid}
        spellcheck="false"
        class="w-40 rounded border border-gray-300 bg-white px-2 py-1 font-mono text-xs text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100"
      />
      <button
        type="submit"
        class="rounded border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700"
      >
        Trace
      </button>
    </form>
  </header>

  <div
    :if={@error}
    id="tx-flow-error"
    role="alert"
    class="border-b border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200"
  >
    {@error}
  </div>

  <div
    id="tx-flow"
    phx-hook="TxFlow"
    phx-update="ignore"
    data-from={@from}
    data-to={@to}
    data-txid={@txid}
    data-detail-max-blocks={@detail_max_blocks}
    data-detail-max-txs={@detail_max_txs}
    class="relative flex min-h-0 flex-1 flex-col"
  >
    <div
      id="tx-flow-canvas"
      class="relative min-h-0 flex-1 bg-[#050608]"
    >
      <canvas
        data-flow-canvas
        class="block h-full w-full"
        aria-label="Transactions and their spends in three dimensions. Drag to orbit, scroll to zoom, click a transaction to light its lineage."
        role="img"
      ></canvas>
      <div
        id="tx-flow-labels"
        class="pointer-events-none absolute inset-0 overflow-hidden [&>a]:pointer-events-auto"
      ></div>
      <div
        id="tx-flow-tooltip"
        class="pointer-events-none absolute z-10 max-w-xs space-y-0.5 rounded-lg border border-gray-200 bg-white/95 px-3 py-2 text-xs text-gray-700 shadow empty:hidden dark:border-gray-700 dark:bg-gray-800/95 dark:text-gray-300"
      ></div>
      <div
        id="tx-flow-detail"
        aria-live="polite"
        class="absolute right-3 top-3 z-10 max-w-xs space-y-0.5 rounded-lg border border-gray-200 bg-white/95 px-3 py-2 text-xs text-gray-700 shadow empty:hidden dark:border-gray-700 dark:bg-gray-800/95 dark:text-gray-300"
      ></div>
    </div>

    <div class="border-t border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-700 dark:bg-gray-800">
      <div class="flex items-center gap-3">
        <button
          id="tx-flow-playpause"
          type="button"
          aria-pressed="false"
          class="w-16 rounded bg-amber-700 px-3 py-1 text-sm text-white hover:bg-amber-800"
        >
          Play
        </button>
        <label
          for="tx-flow-play"
          class="sr-only"
        >
          Playhead block height
        </label>
        <input
          id="tx-flow-play"
          type="range"
          min={@from}
          max={@to}
          step="1"
          value={@from}
          class="flex-1 accent-amber-600"
        />
        <label class="flex items-center gap-1 text-xs text-gray-600 dark:text-gray-400">
          <input
            id="tx-flow-follow"
            type="checkbox"
            checked
            class="rounded border-gray-300 dark:border-gray-600"
          /> Follow
        </label>
      </div>
      <canvas
        id="tx-flow-minimap"
        class="mt-1 block h-10 w-full cursor-ew-resize rounded bg-white dark:bg-gray-900"
        aria-label="Txs per block (grey), spends (amber, top) and events (coloured lines) across the range. Click or drag to move the playhead."
        role="img"
      ></canvas>
      <div
        id="tx-flow-readout"
        aria-live="polite"
        class="mt-1 flex flex-wrap gap-x-2 text-xs text-gray-700 dark:text-gray-300"
      ></div>
    </div>
  </div>

  <footer class="flex flex-wrap items-center gap-4 border-t border-gray-200 bg-gray-50 px-4 py-1 text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
    <span
      id="tx-flow-status"
      phx-update="ignore"
    >
      Loading blocks {@from} to {@to}…
    </span>
    <span id="tx-flow-annotation-count">
      {@annotation_count}
      <a
        href="/annotations"
        class="underline text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
      >annotations</a>
      in range
    </span>
    <span>
      Arrow keys step a block (Shift for ten).
      Space plays.
      F frames the range.
      Esc clears the selection.
    </span>
  </footer>
</div>
