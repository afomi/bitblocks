<div class="min-h-screen bg-neutral-950 text-neutral-200">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
      <a
        href="/"
        class="text-neutral-400 hover:text-neutral-200 text-sm"
      >
        &larr; Back
      </a>
      <h1 class="text-2xl font-bold">
        Transaction Call Graph
      </h1>
    </div>

    <p class="text-neutral-400 text-sm mb-6">
      Trace how transactions reference each other through input spending.
      Enter a txid to see its ancestors and descendants.
    </p>

    <%!-- Search form --%>
    <form
      phx-submit="trace"
      class="flex gap-3 mb-6"
    >
      <input
        type="text"
        name="txid"
        value={@txid}
        placeholder="Enter transaction ID..."
        class="flex-1 px-4 py-2 bg-neutral-800 border border-neutral-700 rounded-lg text-sm font-mono text-neutral-200 focus:outline-none focus:ring-1 focus:ring-blue-500"
      />
      <button
        type="submit"
        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm transition-colors"
      >
        Trace
      </button>
    </form>

    <%!-- Error --%>
    <%= if @error do %>
      <div class="bg-red-900/30 border border-red-800 rounded-lg px-4 py-3 mb-6 text-sm text-red-300">
        <%= @error %>
      </div>
    <% end %>

    <%!-- Loading --%>
    <%= if @loading do %>
      <div class="text-amber-400 animate-pulse mb-6 text-sm">
        Tracing transaction references...
      </div>
    <% end %>

    <%!-- Stats --%>
    <%= if @node_count > 0 do %>
      <div class="flex items-center gap-6 mb-6 text-xs text-neutral-400">
        <span>
          Transactions: <strong class="text-neutral-200"><%= @node_count %></strong>
        </span>
        <span>
          References: <strong class="text-neutral-200"><%= @edge_count %></strong>
        </span>
      </div>
    <% end %>

    <%!-- Graph as node list (structured view) --%>
    <%= if length(@graph.nodes) > 0 do %>
      <div class="space-y-2">
        <%= for node <- Enum.sort_by(@graph.nodes, & &1.depth) do %>
          <div class={"border rounded-lg px-4 py-3 " <> if(node.id == @txid, do: "bg-blue-900/30 border-blue-700", else: "bg-neutral-900 border-neutral-800")}>
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-3">
                <span class={"text-xs px-2 py-0.5 rounded " <> if(node.is_coinbase, do: "bg-amber-500/20 text-amber-400", else: "bg-neutral-700 text-neutral-300")}>
                  <%= if node.is_coinbase, do: "coinbase", else: "depth #{node.depth}" %>
                </span>
                <a
                  href={"/transactions/#{node.id}"}
                  class="font-mono text-sm text-blue-400 hover:text-blue-300"
                >
                  <%= String.slice(node.id, 0, 24) %>...
                </a>
                <%= if node.id == @txid do %>
                  <span class="text-xs text-blue-400">(root)</span>
                <% end %>
              </div>
              <div class="text-xs text-neutral-500">
                Block <%= node.block_height %>
              </div>
            </div>
            <div class="flex items-center gap-4 text-xs text-neutral-500">
              <span>
                <%= node.input_count %> inputs
              </span>
              <span>
                <%= node.output_count %> outputs
              </span>
              <%= if node.total_out do %>
                <span>
                  <%= Float.round(node.total_out / 100_000_000, 8) %> BSV
                </span>
              <% end %>
            </div>
            <%!-- Show edges from this node --%>
            <% outgoing = Enum.filter(@graph.edges, fn e -> e.from == node.id end) %>
            <%= if length(outgoing) > 0 do %>
              <div class="mt-2 text-xs text-neutral-500">
                <span class="text-neutral-600">spent by:</span>
                <%= for edge <- Enum.take(outgoing, 5) do %>
                  <a
                    href={"/tx-graph?txid=#{edge.to}"}
                    class="ml-1 text-neutral-400 hover:text-blue-400 font-mono"
                  >
                    <%= String.slice(edge.to, 0, 12) %>...
                  </a>
                <% end %>
                <%= if length(outgoing) > 5 do %>
                  <span class="text-neutral-600">
                    +<%= length(outgoing) - 5 %> more
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
