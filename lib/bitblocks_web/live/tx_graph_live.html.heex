<%!-- A list of nodes, not a three.js scene: site style in light and dark mode (see DESIGN.md). --%>
<div class="text-gray-900 dark:text-gray-100">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
      <a
        href="/"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white text-sm"
      >
        &larr; Back
      </a>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
        Transaction Call Graph
      </h1>
    </div>

    <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
      Trace how transactions reference each other through input spending.
      Enter a txid to see its ancestors and descendants.
    </p>

    <%!-- Search form --%>
    <form
      phx-submit="trace"
      class="flex gap-3 mb-6"
    >
      <label
        for="tx-graph-txid"
        class="sr-only"
      >
        Transaction ID
      </label>
      <input
        id="tx-graph-txid"
        type="text"
        name="txid"
        value={@txid}
        placeholder="Enter transaction ID..."
        class="flex-1 px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg text-sm font-mono text-gray-900 dark:text-gray-100 placeholder:text-gray-500 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <button
        type="submit"
        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm transition-colors"
      >
        Trace
      </button>
    </form>

    <%!-- Error --%>
    <%= if @error do %>
      <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 mb-6 text-sm text-red-800 dark:bg-red-900/30 dark:border-red-800 dark:text-red-200">
        <%= @error %>
      </div>
    <% end %>

    <%!-- Loading --%>
    <%= if @loading do %>
      <div class="text-amber-800 dark:text-amber-300 animate-pulse mb-6 text-sm">
        Tracing transaction references...
      </div>
    <% end %>

    <%!-- Stats --%>
    <%= if @node_count > 0 do %>
      <div class="flex items-center gap-6 mb-6 text-xs text-gray-600 dark:text-gray-400">
        <span>
          Transactions: <strong class="text-gray-900 dark:text-gray-100"><%= @node_count %></strong>
        </span>
        <span>
          References: <strong class="text-gray-900 dark:text-gray-100"><%= @edge_count %></strong>
        </span>
      </div>
    <% end %>

    <%!-- Graph as node list (structured view) --%>
    <%= if length(@graph.nodes) > 0 do %>
      <div class="space-y-2">
        <%= for node <- Enum.sort_by(@graph.nodes, & &1.depth) do %>
          <div class={"border rounded-lg px-4 py-3 " <> if(node.id == @txid, do: "bg-blue-50 border-blue-300 dark:bg-blue-900/30 dark:border-blue-700", else: "bg-white border-gray-200 dark:bg-gray-800 dark:border-gray-700")}>
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-3">
                <span class={"rounded-full px-2.5 py-0.5 text-xs " <> if(node.is_coinbase, do: "font-semibold bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200", else: "font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200")}>
                  <%= if node.is_coinbase, do: "coinbase", else: "depth #{node.depth}" %>
                </span>
                <a
                  href={"/transactions/#{node.id}"}
                  class="font-mono text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
                >
                  <%= String.slice(node.id, 0, 24) %>...
                </a>
                <%= if node.id == @txid do %>
                  <span class="text-xs text-blue-700 dark:text-blue-300">
                    (root)
                  </span>
                <% end %>
              </div>
              <div class="text-xs text-gray-600 dark:text-gray-400">
                Block <%= node.block_height %>
              </div>
            </div>
            <div class="flex items-center gap-4 text-xs text-gray-600 dark:text-gray-400">
              <span>
                <%= node.input_count %> inputs
              </span>
              <span>
                <%= node.output_count %> outputs
              </span>
              <%= if node.total_out do %>
                <span>
                  <%= Float.round(node.total_out / 100_000_000, 8) %> BSV
                </span>
              <% end %>
            </div>
            <%!-- Show edges from this node --%>
            <% outgoing = Enum.filter(@graph.edges, fn e -> e.from == node.id end) %>
            <%= if length(outgoing) > 0 do %>
              <div class="mt-2 text-xs text-gray-600 dark:text-gray-400">
                <span>
                  spent by:
                </span>
                <%= for edge <- Enum.take(outgoing, 5) do %>
                  <a
                    href={"/tx-graph?txid=#{edge.to}"}
                    class="ml-1 text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 font-mono"
                  >
                    <%= String.slice(edge.to, 0, 12) %>...
                  </a>
                <% end %>
                <%= if length(outgoing) > 5 do %>
                  <span>
                    +<%= length(outgoing) - 5 %> more
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
