<div class="bg-surface-base min-h-screen text-gray-700 dark:text-gray-300">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-neutral-50 mb-4">
      Chain reorganizations
    </h1>
    <p class="mb-3 leading-relaxed">
      A reorganization is the moment the node prefers a different block at a height this index already stored.
    </p>
    <p class="mb-3 leading-relaxed">
      Each entry below is an annotation on Bitcoin SV at that height.
    </p>
    <p class="mb-3 leading-relaxed">
      Bitblocks writes one when tip sync sees the disagreement.
    </p>
    <p class="mb-3 leading-relaxed">
      Earlier chain history is not backfilled on this page.
    </p>
    <p class="mb-3 leading-relaxed">
      Header rows may be replaced.
    </p>
    <p class="mb-10 leading-relaxed">
      Transaction rows from the replaced blocks stay until a later pass.
    </p>

    <%= if @reorgs == [] do %>
      <p
        id="reorg-empty"
        class="text-gray-900 dark:text-gray-100"
      >
        No reorganization has been recorded yet.
      </p>
    <% else %>
      <ol class="border-l border-gray-300 dark:border-gray-600 ml-2 space-y-8">
        <%= for reorg <- @reorgs do %>
          <li
            id={"reorg-#{reorg.id}"}
            class="pl-6 relative"
          >
            <span
              class="absolute -left-1.5 top-1.5 h-3 w-3 rounded-full bg-gray-500 dark:bg-gray-400"
              aria-hidden="true"
            >
            </span>
            <p class="font-mono text-sm text-gray-600 dark:text-gray-400 mb-1">
              <time datetime={DateTime.to_iso8601(reorg.detected_at)}>
                <%= annotation_time(reorg) %>
              </time>
              <% by = @resolved_later[reorg.id] %>
              <%= cond do %>
                <% by -> %>
                  <span class="ml-2 uppercase tracking-wide font-semibold text-gray-700 dark:text-gray-300">
                    Resolved later
                  </span>
                <% reorg.outcome == "needs_attention" -> %>
                  <span class="ml-2 uppercase tracking-wide font-semibold text-red-700 dark:text-red-400">
                    Needs a person
                  </span>
                <% true -> %>
                  <span class="ml-2 uppercase tracking-wide font-semibold text-gray-700 dark:text-gray-300">
                    Headers realigned
                  </span>
              <% end %>
            </p>
            <p class="text-gray-900 dark:text-gray-100 leading-relaxed">
              <%= reorg.summary %>
            </p>
            <p
              :if={by}
              class="mt-1 text-sm text-gray-700 dark:text-gray-300"
            >
              A later run resolved this fork, at
              <a
                href={"#reorg-#{by.id}"}
                class="underline text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
              ><%= annotation_time(by) %></a>.
              Nothing is left for a person to do.
            </p>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
</div>
