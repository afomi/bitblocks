<%!-- Only the three.js scene is dark: #reward-wall-container matches scene.background (0x000000) in assets/js/reward_wall.js, and its controls are site-style chrome (see DESIGN.md). --%>
<div
  id="reward-wall-container"
  class="w-full h-screen bg-black"
>
  <h1 class="sr-only">
    Reward wall
  </h1>
  <canvas
    id="reward-wall-canvas"
    class="w-full h-full"
  >
  </canvas>

  <div
    id="reward-wall-controls"
    class="absolute top-4 left-4 bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm border border-gray-200 dark:border-gray-700 shadow-sm rounded-lg p-4 text-sm font-mono text-gray-900 dark:text-gray-100 space-y-3"
  >
    <div class="flex flex-col space-y-2">
      <label
        class="uppercase tracking-wider text-xs text-gray-600 dark:text-gray-400"
        for="reward-wall-mode"
      >
        Mode
      </label>
      <select
        id="reward-wall-mode"
        class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded px-2 py-1 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="reward">
          Block Reward Schedule
        </option>
        <option value="addresses">
          Address Concentration
        </option>
      </select>
    </div>

    <div class="flex flex-col space-y-2">
      <label
        class="uppercase tracking-wider text-xs text-gray-600 dark:text-gray-400"
        for="reward-wall-phase"
      >
        Phase
      </label>
      <select
        id="reward-wall-phase"
        class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded px-2 py-1 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <%= for {phase_key, {_start, finish}} <- @phases do %>
          <option value={phase_key}>
            <%= phase_label(phase_key, finish) %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="border-t border-gray-200 dark:border-gray-700 pt-2 space-y-1 text-xs text-gray-700 dark:text-gray-300">
      <div>
        Points Loaded:
        <span id="reward-wall-loaded">
          0
        </span>
      </div>
      <div>
        Range:
        <span id="reward-wall-range">
          —
        </span>
      </div>
      <div>
        Status:
        <span id="reward-wall-status">
          Initializing…
        </span>
      </div>
    </div>

    <div
      id="reward-wall-top-addresses"
      class="border-t border-gray-200 dark:border-gray-700 pt-2 space-y-1 max-h-52 overflow-y-auto pr-1"
    >
    </div>
  </div>
</div>

<script
  src={~p"/assets/reward_wall.js"}
  type="module"
>
</script>
