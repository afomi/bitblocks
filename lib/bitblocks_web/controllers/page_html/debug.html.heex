<div
  class="container mx-auto px-4 py-8 max-w-6xl"
>
  <h1
    class="text-4xl font-bold mb-6 text-gray-900 dark:text-white"
  >
    Bitcoin RPC Debug
  </h1>

  <div
    class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-6"
  >
    <h2
      class="text-2xl font-semibold mb-4 text-gray-900 dark:text-white"
    >
      getblockchaininfo() Result
    </h2>

    <%= if is_map(@blockchain_info) and Map.has_key?(@blockchain_info, "chain") do %>
      <div
        class="bg-green-100 dark:bg-green-900 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-200 px-4 py-3 rounded mb-4"
        role="alert"
      >
        <p
          class="font-bold"
        >
          ✓ Success - Connected to Bitcoin SV node
        </p>
      </div>

      <div
        class="bg-gray-50 dark:bg-gray-900 p-4 rounded overflow-x-auto"
      >
        <pre
          class="text-sm text-gray-900 dark:text-gray-100"
        ><code><%= Jason.encode!(@blockchain_info, pretty: true) %></code></pre>
      </div>
    <% end %>

    <%= if match?({:error, _}, @blockchain_info) do %>
      <div
        class="bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-200 px-4 py-3 rounded mb-4"
        role="alert"
      >
        <p
          class="font-bold"
        >
          ✗ Error - Cannot connect to Bitcoin SV node
        </p>
        <p
          class="text-sm mt-2"
        >
          <%= inspect(elem(@blockchain_info, 1)) %>
        </p>
      </div>

      <div
        class="bg-gray-50 dark:bg-gray-900 p-4 rounded overflow-x-auto"
      >
        <pre
          class="text-sm text-gray-900 dark:text-gray-100"
        ><code><%= inspect(@blockchain_info, pretty: true) %></code></pre>
      </div>
    <% end %>

    <%= if is_nil(@blockchain_info) do %>
      <div
        class="bg-yellow-100 dark:bg-yellow-900 border border-yellow-400 dark:border-yellow-600 text-yellow-700 dark:text-yellow-200 px-4 py-3 rounded mb-4"
        role="alert"
      >
        <p
          class="font-bold"
        >
          ⚠ Warning - Received nil response
        </p>
        <p
          class="text-sm mt-2"
        >
          The RPC call returned nil, which typically indicates a connection timeout or empty response.
        </p>
      </div>

      <div
        class="bg-gray-50 dark:bg-gray-900 p-4 rounded overflow-x-auto"
      >
        <pre
          class="text-sm text-gray-900 dark:text-gray-100"
        ><code>nil</code></pre>
      </div>
    <% end %>

    <%= if not is_map(@blockchain_info) and not match?({:error, _}, @blockchain_info) and not is_nil(@blockchain_info) do %>
      <div
        class="bg-orange-100 dark:bg-orange-900 border border-orange-400 dark:border-orange-600 text-orange-700 dark:text-orange-200 px-4 py-3 rounded mb-4"
        role="alert"
      >
        <p
          class="font-bold"
        >
          ⚠ Unexpected Response Type
        </p>
        <p
          class="text-sm mt-2"
        >
          Expected a map or error tuple, got: <%= @blockchain_info |> inspect() |> String.slice(0..50) %>...
        </p>
      </div>

      <div
        class="bg-gray-50 dark:bg-gray-900 p-4 rounded overflow-x-auto"
      >
        <pre
          class="text-sm text-gray-900 dark:text-gray-100"
        ><code><%= inspect(@blockchain_info, pretty: true) %></code></pre>
      </div>
    <% end %>
  </div>

  <div
    class="bg-blue-50 dark:bg-blue-900 border border-blue-200 dark:border-blue-700 rounded-lg p-6"
  >
    <h3
      class="text-xl font-semibold mb-2 text-gray-900 dark:text-white"
    >
      Troubleshooting Tips
    </h3>
    <ul
      class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300"
    >
      <li>
        Check that the Bitcoin SV node is running: <code
          class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-xs"
        >
          ps aux | grep bitcoind
        </code>
      </li>
      <li>
        Verify network connectivity: <code
          class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-xs"
        >
          curl <%= @bitcoin_url || "http://your-node:8332" %>
        </code>
      </li>
      <li>
        Check Bitcoin logs for RPC errors
      </li>
      <li>
        Verify credentials match bitcoin.conf settings
      </li>
      <li>
        If using remote node, check firewall rules allow port 8332
      </li>
      <li>
        Ensure <code
          class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-xs"
        >
          server=1
        </code> is set in bitcoin.conf
      </li>
    </ul>

    <div
      class="mt-4"
    >
      <a
        href="/config"
        class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
      >
        Go to Config Page
      </a>
    </div>
  </div>
</div>
