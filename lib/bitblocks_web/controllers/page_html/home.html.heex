<div class="container mx-auto px-4 py-8 max-w-3xl">
  <%!-- Find: the reason most people arrive, one transaction or block --%>
  <section
    id="find"
    aria-labelledby="find-heading"
    class="py-10"
  >
    <h1
      id="find-heading"
      class="text-2xl font-semibold text-gray-900 dark:text-white mb-2"
    >
      Find a transaction or block
    </h1>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      Paste a transaction ID, a block hash or a block height.
    </p>
    <form
      id="home-search-form"
      action="/search"
      method="get"
      role="search"
      class="flex gap-2"
    >
      <label
        for="home-search"
        class="sr-only"
      >
        Transaction ID, block hash or block height
      </label>
      <input
        type="search"
        id="home-search"
        name="query"
        autocomplete="off"
        spellcheck="false"
        placeholder="txid, block hash or height"
        class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-4 py-3 font-mono text-sm text-gray-900 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100"
      />
      <button
        type="submit"
        class="rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Search
      </button>
    </form>
    <p
      :if={is_integer(@coverage.complete_through) and @coverage.complete_through >= 0 and is_integer(@coverage.our_tip)}
      id="home-coverage"
      class="mt-4 text-sm text-gray-600 dark:text-gray-400"
    >
      Every transaction is stored through block
      <a
        href={"/blocks/#{@coverage.complete_through}"}
        class="underline font-mono tabular-nums text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
      >
        {format_number(@coverage.complete_through)}
      </a>
      of <span class="font-mono tabular-nums">{format_number(@coverage.our_tip)}</span> known.
      <a
        :if={@conn.assigns[:current_user] || @conn.assigns[:admin?]}
        href="/syncing"
        class="underline text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
      >
        See the sync
      </a>
    </p>
  </section>

  <%!-- Recent Blocks --%>
  <div class="mb-12">
    <BitblocksWeb.RecentBlocksComponent.recent_blocks blocks={@recent_blocks} />
  </div>

  <%!-- Use the data: the same records, read by a program --%>
  <section
    id="use-the-data"
    aria-labelledby="use-the-data-heading"
    class="mb-12"
  >
    <h2
      id="use-the-data-heading"
      class="text-lg font-semibold text-gray-900 dark:text-white mb-2"
    >
      Use the data
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      Every page here reads the same records as the API.
      Sign in to call it, or use a key for a budget of your own.
    </p>
    <dl class="divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-700 dark:border-gray-700">
      <div
        :for={
          {need, path} <- [
            {"One transaction and its merkle proof", "GET /api/v1/txs/:txid/proof"},
            {"A script's history and unspent outputs", "GET /api/v1/script/:scripthash/history"},
            {"New blocks as they arrive", "GET /api/v1/stream/blocks"},
            {"Where the sync stands", "GET /api/v1/status"}
          ]
        }
        class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
      >
        <dt class="text-sm text-gray-800 dark:text-gray-200">
          {need}
        </dt>
        <dd class="font-mono text-xs text-gray-600 dark:text-gray-400">
          {path}
        </dd>
      </div>
    </dl>
    <a
      href="/start"
      class="mr-4 mt-3 inline-block text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
    >
      Start building
    </a>
    <a
      href="/pricing"
      class="mt-3 inline-block text-sm text-blue-700 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300"
    >
      Keys and limits
    </a>
  </section>

  <%!-- Beta features: indexed on-chain products, off the header until they're current --%>
  <section
    id="beta-features"
    aria-labelledby="beta-features-heading"
    class="mb-8"
  >
    <div class="flex items-center gap-3 mb-2">
      <h2
        id="beta-features-heading"
        class="text-lg font-semibold text-gray-900 dark:text-white"
      >
        Beta features
      </h2>
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
        Beta
      </span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
      These views are built on the same index and are filling in as the sync reaches the tip.
      Try them, and expect gaps while they do.
    </p>
    <ul
      role="list"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2"
    >
      <li :for={
        {id, href, title, blurb} <- [
          {"beta-bitcom", "/bitcom", "Bitcom",
           "A live registry of Bitcom namespaces, with on-chain proof of ownership."},
          {"beta-tokens", "/tokens", "Tokens",
           "BSV-20 and BSV-21 tokens with their supply, holders and transfers."},
          {"beta-collections", "/collections", "Collections",
           "NFT collections with membership and current owners for each item."},
          {"beta-types", "/types", "Transaction types",
           "What each kind of transaction is, how it is spent, and real examples from the chain."},
          {"beta-metanet", "/metanet", "Metanet",
           "Walk Metanet trees from a root to its children and versions."},
          {"beta-order-book", "/order-book", "Order book",
           "Open listings for BSV-20 tokens, read straight from the chain."}
        ]
      }>
        <a
          id={id}
          href={href}
          class="block h-full rounded-lg border border-gray-200 p-4 hover:border-orange-400 dark:border-gray-700"
        >
          <span class="block font-semibold text-gray-900 dark:text-white">
            {title}
          </span>
          <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">
            {blurb}
          </span>
        </a>
      </li>
    </ul>
  </section>
</div>
