<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="text-center py-12">
    <h1 class="text-6xl font-bold mb-6 text-gray-900 dark:text-white">
      Bitblocks
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">
      Bitcoin SV Blockchain Explorer
    </p>

    <%!-- Search Bar --%>
    <div class="max-w-2xl mx-auto mb-12">
      <div class="relative">
        <label for="home-search" class="sr-only">
          Search by block height, block hash, or transaction ID
        </label>
        <input
          type="text"
          id="home-search"
          placeholder="Search by block height, block hash, or transaction ID..."
          class="w-full px-6 py-4 text-sm border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 font-mono"
        />
        <button
          onclick="window.location.href='/search?query=' + encodeURIComponent(document.getElementById('home-search').value)"
          class="absolute right-2 top-1/2 -translate-y-1/2 px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-semibold"
        >
          Search
        </button>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <a
        href="/blocks"
        class="inline-block px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-800 font-semibold"
      >
        Browse Blocks
      </a>
      <a
        href="/graph"
        class="inline-block px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-800 font-semibold"
      >
        Transaction Graph
      </a>
      <a
        href="/status"
        class="inline-block px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-800 font-semibold"
      >
        View Status
      </a>
    </div>
  </div>

  <%!-- Recent Blocks --%>
  <div class="max-w-2xl mx-auto mb-8">
    <BitblocksWeb.RecentBlocksComponent.recent_blocks
      blocks={@recent_blocks}
    />
  </div>

  <%!-- Beta features: indexed on-chain products, off the header until they're current --%>
  <section
    id="beta-features"
    aria-labelledby="beta-features-heading"
    class="max-w-2xl mx-auto mb-8"
  >
    <div
      class="flex items-center gap-3 mb-2"
    >
      <h2
        id="beta-features-heading"
        class="text-lg font-semibold text-gray-900 dark:text-white"
      >
        Beta features
      </h2>
      <span
        class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/40 dark:text-amber-200"
      >
        Beta
      </span>
    </div>
    <p
      class="text-sm text-gray-600 dark:text-gray-400 mb-4"
    >
      These views are built on the same index and are filling in as the sync reaches the tip.
      Try them, and expect gaps while they do.
    </p>
    <ul
      role="list"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2"
    >
      <li
        :for={
          {id, href, title, blurb} <- [
            {"beta-tokens", "/tokens", "Tokens",
             "BSV-20 and BSV-21 tokens with their supply, holders and transfers."},
            {"beta-order-book", "/order-book", "Order book",
             "Open listings for BSV-20 tokens, read straight from the chain."},
            {"beta-metanet", "/metanet", "Metanet",
             "Walk Metanet trees from a root to its children and versions."},
            {"beta-bitcom", "/bitcom", "Bitcom",
             "A live registry of Bitcom namespaces, with on-chain proof of ownership."},
            {"beta-collections", "/collections", "Collections",
             "NFT collections with membership and current owners for each item."},
            {"beta-syncing", "/syncing", "Syncing",
             "Watch each block sync live, with its transactions stored and processed."}
          ]
        }
      >
        <a
          id={id}
          href={href}
          class="block h-full rounded-lg border border-gray-200 p-4 hover:border-gray-400 dark:border-gray-700 dark:hover:border-gray-500"
        >
          <span
            class="flex items-center justify-between gap-2"
          >
            <span
              class="font-semibold text-gray-900 dark:text-white"
            >
              {title}
            </span>
            <span
              class="text-xs font-medium text-amber-900 dark:text-amber-200"
            >
              Beta
            </span>
          </span>
          <span
            class="mt-1 block text-sm text-gray-600 dark:text-gray-400"
          >
            {blurb}
          </span>
        </a>
      </li>
    </ul>
  </section>
</div>
