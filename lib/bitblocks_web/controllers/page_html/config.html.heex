<div
  class="container mx-auto px-4 py-8 max-w-4xl"
>
  <h1
    class="text-4xl font-bold mb-6"
  >
    Bitcoin SV Node Configuration
  </h1>

  <div
    class="bg-white shadow-md rounded-lg p-6 mb-6"
  >
    <h2
      class="text-2xl font-semibold mb-4"
    >
      Current Configuration
    </h2>
    <div
      class="space-y-2"
    >
      <div
        class="flex items-center"
      >
        <span
          class="font-medium w-48"
        >
          Bitcoin Node URL:
        </span>
        <code
          class="bg-gray-100 px-2 py-1 rounded"
        >
          <%= @bitcoin_url || "Not set" %>
        </code>
      </div>
      <div
        class="flex items-center"
      >
        <span
          class="font-medium w-48"
        >
          RPC Username:
        </span>
        <code
          class="bg-gray-100 px-2 py-1 rounded"
        >
          <%= @rpc_user || "Not set" %>
        </code>
      </div>
      <div
        class="flex items-center"
      >
        <span
          class="font-medium w-48"
        >
          RPC Password:
        </span>
        <code
          class="bg-gray-100 px-2 py-1 rounded"
        >
          <%= if @configured, do: "•••••••", else: "Not set" %>
        </code>
      </div>
    </div>
  </div>

  <%= if @connection_status == :success do %>
    <div
      class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6"
      role="alert"
    >
      <p
        class="font-bold"
      >
        ✓ Successfully connected to Bitcoin SV node!
      </p>
      <p
        class="mb-4"
      >
        Your node is properly configured and responding.
      </p>

      <div
        class="bg-white border border-green-300 rounded-lg p-4 mb-4"
      >
        <h3
          class="text-lg font-semibold text-gray-800 mb-3"
        >
          Choose Sync Scope:
        </h3>

        <div
          class="space-y-3"
        >
          <div>
            <a
              href="/sync?scope=all"
              class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold"
            >
              Sync All Blocks
              <span
                class="ml-2 text-xs bg-blue-500 px-2 py-1 rounded"
              >
                (Genesis to current tip)
              </span>
            </a>
            <p
              class="text-sm text-gray-600 mt-1 ml-1"
            >
              Download the entire blockchain from block 0 to the current chain tip
            </p>
          </div>

          <div>
            <a
              href="/sync?scope=range"
              class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700 font-semibold"
            >
              Sync Block Range
              <span
                class="ml-2 text-xs bg-purple-500 px-2 py-1 rounded"
              >
                (Specify start & end)
              </span>
            </a>
            <p
              class="text-sm text-gray-600 mt-1 ml-1"
            >
              Download a specific range of blocks (e.g., blocks 100000-218000)
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @connection_status == :error do %>
    <div
      class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6"
      role="alert"
    >
      <p
        class="font-bold"
      >
        ✗ Cannot connect to Bitcoin SV node
      </p>
      <p>
        Configuration found but unable to connect. Please check your node is running and credentials are correct.
      </p>
    </div>
  <% end %>

  <%= if @connection_status == :not_configured do %>
    <div
      class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-6"
      role="alert"
    >
      <p
        class="font-bold"
      >
        ⚠ Bitcoin SV node not configured
      </p>
      <p>
        Please follow the setup instructions below.
      </p>
    </div>
  <% end %>

  <div
    class="bg-white shadow-md rounded-lg p-6 mb-6"
  >
    <h2
      class="text-2xl font-semibold mb-4"
    >
      Setup Instructions
    </h2>

    <div
      class="space-y-6"
    >
      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          1. Install Bitcoin SV Node
        </h3>
        <p
          class="mb-2"
        >
          Download and install the Bitcoin SV node software from:
        </p>
        <a
          href="https://bitcoinsv.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-500 hover:underline"
        >
          https://bitcoinsv.io/
        </a>
      </div>

      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          2. Configure Your Bitcoin SV Node
        </h3>
        <p
          class="mb-2"
        >
          Edit your <code
            class="bg-gray-100 px-2 py-1 rounded"
          >
            bitcoin.conf
          </code> file and add:
        </p>
        <pre
          class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto"
        ><code>server=1
rpcuser=your_username
rpcpassword=your_secure_password
rpcallowip=127.0.0.1
rpcport=8332</code></pre>
      </div>

      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          3. Start Your Bitcoin SV Node
        </h3>
        <p
          class="mb-2"
        >
          Start the Bitcoin SV daemon:
        </p>
        <pre
          class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto"
        ><code>bitcoind</code></pre>
      </div>

      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          4. Configure Bitblocks
        </h3>
        <p
          class="mb-2"
        >
          Create a <code
            class="bg-gray-100 px-2 py-1 rounded"
          >
            .env
          </code> file in the Bitblocks root directory:
        </p>
        <pre
          class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto"
        ><code>BITCOIN_NODE_URL=http://localhost:8332
BITCOIN_NODE_RPC_USERNAME=your_username
BITCOIN_NODE_RPC_PASSWORD=your_secure_password
BITCOIN_NODE_RPC_URL=http://localhost:8332</code></pre>
      </div>

      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          5. Load Environment Variables and Start Bitblocks
        </h3>
        <pre
          class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto"
        ><code>source .env
mix phx.server</code></pre>
      </div>

      <div>
        <h3
          class="text-xl font-semibold mb-2"
        >
          6. Verify Connection
        </h3>
        <p
          class="mb-2"
        >
          Reload this page to verify your connection. If successful, you can start syncing blockchain data:
        </p>
        <pre
          class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto"
        ><code>iex -S mix phx.server

# Sync blocks 0-1000
Bitblocks.Sync.get_blocks(0..1000)</code></pre>
      </div>
    </div>
  </div>

  <div
    class="bg-blue-50 border border-blue-200 rounded-lg p-6"
  >
    <h3
      class="text-xl font-semibold mb-2"
    >
      Need Help?
    </h3>
    <p
      class="mb-2"
    >
      For more information, check out:
    </p>
    <ul
      class="list-disc list-inside space-y-1"
    >
      <li>
        <a
          href="https://github.com/afomi/bitblocks"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-500 hover:underline"
        >
          Bitblocks GitHub Repository
        </a>
      </li>
      <li>
        <a
          href="https://bitcoinsv.io/documentation/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-blue-500 hover:underline"
        >
          Bitcoin SV Documentation
        </a>
      </li>
      <li>
        <.link
          navigate={~p"/status"}
          class="text-blue-500 hover:underline"
        >
          Status Page
        </.link> - View sync progress
      </li>
    </ul>
  </div>
</div>
