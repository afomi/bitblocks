# Bitcoin SV Node Configuration
# Copy this file to .env and fill in your actual values
# Run `source .env` to load these variables before starting the application

# Bitcoin SV Node URL
BITCOIN_NODE_URL=http://localhost:8332

# Bitcoin SV Node RPC Credentials
BITCOIN_NODE_RPC_USERNAME=your_rpc_username
BITCOIN_NODE_RPC_PASSWORD=your_rpc_password

# Bitcoin SV Node RPC URL (usually same as BITCOIN_NODE_URL)
BITCOIN_NODE_RPC_URL=http://localhost:8332

# Production Environment Variables (optional for local development)
# Uncomment and set these for production deployments (eg: on fly.io)

# SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# PHX_HOST=bitblocks.app
# PORT=4000
