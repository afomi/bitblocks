    {
      "name": "b_then_map",
      "description": "B:// \"hello\" | MAP SET app=qart type=post",
      "script_hex": "006a2231394878696756345179427633744870515663554551797131707a5a56646f4175740568656c6c6f0a746578742f706c61696e057574662d38017c223150755161374b36324d694b43747373534c4b79316b683536575755374d7455523503534554036170700471617274047479706504706f7374",
      "satoshis": 0,
      "expected": {
        "owner": null,
        "basket": null,
        "protocol": "wallet payment",
        "indexers": [],
        "data": {}
      },
      "known_divergence": "MapIndexer skips to the next protocol with `data[0] !== 0x7c` (first single-byte push that is NOT \"|\"), so MAP after B:// is never found. Intended: split on \"|\"."
    },
    {
      "name": "map_then_sigma",
      "description": "MAP SET app=qart | SIGMA BSM <address> <sig> 0 (signature not checked at parse)",
      "script_hex": "",
      "satoshis": 0,
      "expected": {
        "owner": null,
        "basket": null,
        "protocol": "wallet payment",
        "indexers": [
          "map"
        ],
        "data": {
          "map": {
            "data": {
              "app": "qart",
              "type": "post",
              "|": "SIGMA",
              "BSM": "1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH",
              "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx": "0"
            },
            "tags": []
          }
        }
      },
      "known_divergence": "parseMap stops on a single-byte push that is NOT \"|\", so \"|\" and the SIGMA fields are read as MAP keys. SigmaIndexer walks chunks after OP_RETURN, but @bsv/sdk folds everything after a top-level OP_RETURN into one chunk, so Sigma never fires. Intended: map {app, type} and a sigma entry."
    },
