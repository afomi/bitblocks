#!/bin/sh

IMDS_TOKEN=$(curl -sf -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")

PRIVATE_IP=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)

# Use LONG names (name), not short names (sname): the node name contains the
# private IP, which has dots — and Erlang short-names cannot contain dots
# ("Can't set short node name!" -> nodistribution -> the VM won't boot). Long
# names allow an IP/FQDN host. This is required for the IP-based RELEASE_NODE
# (and for clustering: DNSCluster -> Node.connect needs valid distributed nodes).
export RELEASE_DISTRIBUTION="name"

# Guard: if IMDS failed and PRIVATE_IP is empty, "bitblocks@" is ALSO an invalid
# node name and would crash the boot. Fall back to 127.0.0.1 so the release at
# least starts (single-node; clustering won't form, but the app stays up).
if [ -z "$PRIVATE_IP" ]; then
  echo "rel/env.sh.eex: WARNING - could not resolve PRIVATE_IP from IMDS; using 127.0.0.1" >&2
  PRIVATE_IP="127.0.0.1"
fi
export RELEASE_NODE="bitblocks@${PRIVATE_IP}"
